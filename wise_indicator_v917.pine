//@version=6
// =============================================================================
// Wise Indicator v9.20 — DAILY RESET BUG FIX + COMPACT LABELS + NEW DEFAULTS
// =============================================================================
// v9.20 BUG FIXES + UPGRADES (over v9.19):
//
// 🔴 CRITICAL BUG FIX — STALE SESSION HIGH/LOW BLEEDING ACROSS DAYS:
//   In v9.19 and earlier, `londonHigh`, `londonLow`, `asiaHigh`, `asiaLow` and
//   `londonEndBar` were declared as `var float` (persistent across bars) and
//   were ONLY reset when the next session began (e.g. `asiaStarted`).
//
//   This caused YESTERDAY'S London H/L to live in those variables during the
//   16+ hour gap until next London started. The sweep detector on line 1685
//   used `not inLondon and not na(londonEndBar) and bar_index > londonEndBar`
//   to gate detection — but `londonEndBar` from yesterday was still set, so:
//
//   Yesterday 05:15 London close → londonHigh stays at e.g. 1.1750
//   Asia start (22:00) → sweep flags reset to false, but H/L values STAY
//   Asia bar wicks above 1.1750 → false "London H swept" detected
//   Next NY engine → sees londonHighSweptToday=true, FIRES WITHOUT real sweep
//
//   FIX: At every `asiaStarted` (start of new trading day):
//     - Reset londonHigh, londonLow to na
//     - Reset asiaHigh, asiaLow to na (defence in depth)
//     - Reset londonEndBar to na (so canDetectLondonSweep gates correctly)
//     - Already-reset: sweep flags, signal counters, session-taken flags
//
//   This was the root cause of the false NY shorts you observed without a
//   visible London sweep — NY was acting on yesterday's stale level.
//
// 🆕 COMPACT ENTRY LABELS (v9.20):
//   Entry labels are now rendered with text_size=tiny and 50% transparent
//   background. Same info, much less screen real estate. Existing
//   `showQualityScore` badge still works.
//
// 🆕 USER-PREFERRED DEFAULTS (v9.20):
//   Based on optimal settings from production testing:
//     - SL Buffer (ticks): 5 → 10
//     - SL Swing Lookback: 20 → 16
//     - SL Min Distance (× ATR): 0.5 → 0.4
//     - Show SL source in label: ON (was already)
//     - Show SL/TP Boxes: ON
//     - Show Weak/Intermediate/Strong H/L lines: OFF (all 3)
//     - Setup alive for entire London (+buffer): ON
//     - Max distance from swept level (× ATR): 1
//     - Asia Sweep Color: red (47% opacity)
//     - London Sweep Color: blue (58% opacity)
//     - Sweep PDH/PDL, PWH/PWL: OFF (avoid stale daily/weekly noise)
//     - Sweep must close BACK through level: OFF
//     - Max bars after Asia to look for sweep: 100
//     - London Entry Mode: Auto (smart decide based on conditions)
//     - NY Entry Mode (T1): Auto (smart decide based on conditions)
//     - NY accepts Asia High sweep: ON
//
// All v9.19 features intact: Vol Confirm fix, A+ Quality Gate, deep JSON,
// symbol auto-profile, NY engine, separate sweep colors, etc.
// =============================================================================

indicator("Wise Indicator v9.22", "Wise v9.22", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)
// =============================================================================
// WEBHOOK JSON ALERTS (hardcoded — hidden from settings)
// =============================================================================
enableJsonAlerts = true
webhookSecret = "wisemind2026"

// =============================================================================
// SYMBOL AUTO-PROFILE (v9.14) — Auto-tunes for EURUSD vs XAUUSD
// =============================================================================
gSymbol = "◆ Symbol Auto-Profile (v9.14)"
autoDetectProfile = input.bool(true, "Auto-detect symbol profile", group = gSymbol, tooltip = "When ON: indicator reads syminfo.ticker and applies preset values for EURUSD or XAUUSD automatically. Symbol auto-detection: tickers containing 'EURUSD' use EUR profile, tickers containing 'XAUUSD' or 'GOLD' or 'XAU' use XAU profile, anything else uses Custom (your manual values below). When OFF: all values use the manual settings exactly as you set them, regardless of symbol.")
profileOverride = input.string("Auto", "Override profile (if auto-detect misses)", options = ["Auto", "Force EURUSD", "Force XAUUSD", "Custom (use my manual values)"], group = gSymbol, tooltip = "Use this if your broker names symbols unusually (e.g. 'XAUUSDx' or 'GOLD/USD'). 'Auto' = use syminfo.ticker detection. 'Force EURUSD/XAUUSD' = always use that profile regardless of symbol. 'Custom' = ignore profiles entirely, use manual values below.")

// Auto-detect logic
sym = str.upper(syminfo.ticker)
isXauSymbol = str.contains(sym, "XAUUSD") or str.contains(sym, "GOLD") or str.contains(sym, "XAU/")
isEurSymbol = str.contains(sym, "EURUSD")

// Resolve which profile to use
profileMode = profileOverride == "Force EURUSD" ? "EUR" : profileOverride == "Force XAUUSD" ? "XAU" : profileOverride == "Custom (use my manual values)" or not autoDetectProfile ? "CUSTOM" : isXauSymbol ? "XAU" : isEurSymbol ? "EUR" : "CUSTOM"

useEurPreset = profileMode == "EUR"
useXauPreset = profileMode == "XAU"
useCustom = profileMode == "CUSTOM"

// Profile values — accessed throughout the indicator via these resolved variables
profileMaxAsiaTicks = useXauPreset ? 4000 : useEurPreset ? 500 : na
profileMaxNyTicks = useXauPreset ? 4000 : useEurPreset ? 500 : na
profileManipWick = useXauPreset ? 0.15 : useEurPreset ? 0.10 : na
profileNyManipWick = useXauPreset ? 0.15 : useEurPreset ? 0.10 : na
profileSlMinAtr = useXauPreset ? 0.50 : useEurPreset ? 0.40 : na
profileVolConfirm = useXauPreset ? 1.20 : useEurPreset ? 1.20 : na
profileT2Displace = useXauPreset ? 1.50 : useEurPreset ? 1.25 : na

// Display tag for dashboard and labels
profileDisplayTag = useEurPreset ? "EUR" : useXauPreset ? "XAU" : "CUSTOM"
profileLabelTag = useEurPreset ? "[EUR]" : useXauPreset ? "[XAU]" : "[CUSTOM]"
profileSourceTag = autoDetectProfile and (profileOverride == "Auto") ? "AUTO" : profileOverride == "Custom (use my manual values)" or not autoDetectProfile ? "MANUAL" : "FORCED"

// =============================================================================
// LOGIC TIMEFRAME (v9.7)
// =============================================================================
gLogicTF = "◆ Multi-Timeframe Logic (v9.7)"
logicTF = input.timeframe("15", "Logic Timeframe", options = ["1", "3", "5", "15", "30"], group = gLogicTF, tooltip = "All strategy logic (sweeps, engulfs, volume) computes on this TF regardless of chart TF. Default 5m. Switch chart freely — same setups appear at same bars.")
enable1mFire = input.bool(true, "Enable 1m Precision Fire (when chart is 1m)", group = gLogicTF, tooltip = "When ON and chart TF < Logic TF: fire trades on 1m engulfing candles inside active 5m setups. When chart TF >= Logic TF: this has no effect (regular engine fires).")
fireVariant = input.string("Variant 2 — Independent (fire on any strong 1m engulf in active setup)", "1m Fire Variant", options = ["Variant 1 — Synchronized (1m fires only when 5m would also fire)", "Variant 2 — Independent (fire on any strong 1m engulf in active setup)"], group = gLogicTF, tooltip = "Variant 1 = same trades as 5m, just earlier price. Variant 2 = more signals, faster fires, slightly noisier.")
oneMinBodyRatio = input.float(0.85, "1m Min Engulf Body % (T1)", minval = 0.50, maxval = 0.95, step = 0.05, group = gLogicTF, tooltip = "Body % required for 1m engulf to fire T1. Same as 5m default to keep quality consistent.")
oneMinT2BodyRatio = input.float(0.85, "1m Min Engulf Body % (T2)", minval = 0.50, maxval = 0.95, step = 0.05, group = gLogicTF, tooltip = "Body % required for 1m engulf to fire T2.")
oneMinSlSrc = input.string("Use Smart SL Chain (same as 5m)", "1m Fire SL Source", options = ["1m engulf low/high (tighter, best RR)", "5m engulf low/high (safer, wider)", "Use Smart SL Chain (same as 5m)"], group = gLogicTF, tooltip = "When 1m fires the trade, which low/high should SL use? 1m = tightest. 5m = wider but safer. Smart SL = full fallback chain.")

// v9.19: Vol Confirm mode for 1m fires (FIXES the v9.18 bug where Variant 2 skipped vol check entirely)
oneMinVolConfirmMode = input.string("Off — no vol confirm on 1m fires (legacy v9.18 V2)", "1m Vol Confirm Mode (v9.19)", options = ["Strict — 1m engulf candle must pass vol threshold", "5m Partial — forming 5m bar must pass vol threshold", "Off — no vol confirm on 1m fires (legacy v9.18 V2)"], group = gLogicTF, tooltip = "v9.19 BUG FIX: In v9.18 and earlier, Variant 2 1m fires SKIPPED Vol Confirm entirely (trades fired below threshold). Strict (recommended) = the 1m engulf candle itself must beat your Vol Confirm setting. 5m Partial = the forming 5m bar's vol must beat threshold (looser, but matches V1 behaviour). Off = preserves old buggy behaviour for backtest comparison.")
oneMinVolStrict   = oneMinVolConfirmMode == "Strict — 1m engulf candle must pass vol threshold"
oneMinVolPartial  = oneMinVolConfirmMode == "5m Partial — forming 5m bar must pass vol threshold"
oneMinVolOff      = oneMinVolConfirmMode == "Off — no vol confirm on 1m fires (legacy v9.18 V2)"

tfMinutes = timeframe.in_seconds(timeframe.period) / 60
logicMinutes = timeframe.in_seconds(logicTF) / 60
chartIsBelowLogic = tfMinutes < logicMinutes
chartEqualsLogic = tfMinutes == logicMinutes
chartIsAboveLogic = tfMinutes > logicMinutes
oneMinFireActive = enable1mFire and chartIsBelowLogic
// [v9.21 removed] validTF was always true — dead guard removed

// =============================================================================
// INPUTS — SESSIONS
// =============================================================================
gSess = "◆ Sessions (Exchange Time)"
asiaSess   = input.session("2000-0000", "Asia Session", group = gSess)
londonSess = input.session("0300-0515", "London Killzone (signals active)", group = gSess, tooltip = "For CET 09:00-11:15 on UTC-5 broker use 0300-0515")
nySess     = input.session("0830-1100", "NY Killzone", group = gSess)
sessionBufferBars = input.int(0, "Extend signals N bars past London close", minval = 0, maxval = 20, group = gSess, tooltip = "6 bars × 5m = 30 min extension")

gCol = "◆ Session Colors"
showAsiaBox   = input.bool(true, "Show Asia", group = gCol, inline = "a")
asiaColor     = input.color(color.new(#8e44ad, 88), "", group = gCol, inline = "a")
showLondonBox = input.bool(true, "Show London", group = gCol, inline = "b")
londonColor   = input.color(color.new(#2980b9, 88), "", group = gCol, inline = "b")
showNYBox     = input.bool(true, "Show NY", group = gCol, inline = "c")
nyColor       = input.color(color.new(#95a5a6, 90), "", group = gCol, inline = "c")

gT1 = "◆ T1 Entry Rules (immediate reversal at sweep)"
enableT1 = input.bool(true, "Enable T1 signals", group = gT1)
oneSignalPerSide = input.bool(true, "Max 1 T1 signal per side per session (counts 1st+2nd)", group = gT1)
blockT1AfterOppositeSweep = input.bool(true, "Block T1 if opposite Asia side already swept", group = gT1, tooltip = "If Asia HIGH already swept this session → blocks T1 SHORT. If Asia LOW already swept → blocks T1 LONG. RECOMMENDED ON.")

gT2 = "◆ T2 Entry Rules (AMD retracement — sweep → displace → retrace into Asia)"
enableT2 = input.bool(true, "Enable T2 signals", group = gT2)
oneT2PerSide = input.bool(true, "Max 1 T2 signal per side per session", group = gT2)
t2BodyRatio = input.float(0.80, "T2 Min Engulfing Body %", minval = 0.50, maxval = 0.95, step = 0.05, group = gT2, tooltip = "T2 uses a stricter body % than T1 by default. 0.80 = 80% body.")
t2DisplaceAtrManual = input.float(1.25, "T2 min displacement from sweep (× ATR)", minval = 0.5, maxval = 5.0, step = 0.1, group = gT2, tooltip = "After sweep, price must move at least this × ATR AWAY from swept level before T2 retracement becomes valid. Auto-overridden by Symbol Profile (XAUUSD = 1.50, EURUSD = 1.25). Used as-is when profile is Custom.")
t2DisplaceAtr = useCustom ? t2DisplaceAtrManual : profileT2Displace
t2RequireAsiaRetrace = input.bool(true, "T2 retrace MUST be inside Asia range", group = gT2, tooltip = "ON = purist ICT (PD zone must be inside Asia box). OFF = any PD zone after displacement.")
t2MinRR = input.float(2.5, "T2 Minimum RR", minval = 1.0, step = 0.1, group = gT2)
t2MaxRR = input.float(4.0, "T2 Maximum RR", minval = 2.0, step = 0.5, group = gT2)
t2ShowZoneBox = input.bool(true, "Show T2 target zone box (strongest PD in Asia)", group = gT2)
t2ZoneBoxColor = input.color(color.new(#ffeb3b, 80), "T2 zone box color", group = gT2)

gBiasMatrix = "◆ BIAS FILTER MATRIX"
enableBiasFilter = input.bool(true, "Apply bias filter to T1 and T2", group = gBiasMatrix, tooltip = "BULLISH → only LONGs (both T1+T2). BEARISH → only SHORTs. NEUTRAL → all allowed. AUTO → uses 30m/4H scores.")

// =============================================================================
// A+ QUALITY GATE (v9.19) — Resolves T1 vs T2 conflicts on same sweep
// =============================================================================
gQuality = "◆ A+ Quality Gate (v9.19)"
conflictMode = input.string("First wins (legacy v9.18 behaviour)", "T1/T2 Conflict Mode", options = ["A+ Quality Gate (rank both, fire best)", "T1 Priority (block opposite-direction T2)", "First wins (legacy v9.18 behaviour)"], group = gQuality, tooltip = "When BOTH T1 and T2 setups are valid on the same sweep (e.g. T1 LONG + T2 SHORT after AL sweep), how to resolve:\n\n• A+ Quality Gate (RECOMMENDED): scores both setups on body%, vol, HTF alignment, manipulation, displacement, RR, Asia range. Fires only the higher-scoring one. Min score gate blocks weak setups entirely.\n\n• T1 Priority: classic ICT — T1 always wins same-sweep conflicts.\n\n• First wins: legacy v9.18 behaviour — whichever triggers first fires (random quality).")
qualityMinScore = input.int(6, "A+ Min Score Required (0–15)", minval = 0, maxval = 15, group = gQuality, tooltip = "Minimum quality score required to fire ANY trade when conflictMode = A+ Quality Gate. Score range 0–15. Default 5 (medium quality). Set to 8+ for ultra-selective A+ only. Set to 0 to disable score gate.")
qualityWaitBars = input.int(3, "A+ Conflict Wait Bars (Logic TF)", minval = 0, maxval = 10, group = gQuality, tooltip = "When BOTH T1 and T2 are valid simultaneously, wait this many logic-TF bars after the first qualifying setup before firing — gives the second setup a chance to mature for fair comparison. 0 = fire immediately on first qualified. 3 = wait 3 bars (recommended, 15 min on 5m logic).")

// Score weights (advanced — collapsed by default)
gQualityW = "◆ A+ Score Weights (advanced)"
wHtfAligned = input.int(3, "HTF aligned bonus", minval = 0, maxval = 5, group = gQualityW)
wBodyStrong = input.int(2, "Body % ≥ 90% bonus", minval = 0, maxval = 5, group = gQualityW)
wVolStrong  = input.int(2, "Vol spike ≥ 1.5× bonus", minval = 0, maxval = 5, group = gQualityW)
wManipPassed = input.int(2, "T1: 2nd entry / manip passed bonus", minval = 0, maxval = 5, group = gQualityW)
wDisplaceStrong = input.int(2, "T2: displacement ≥ 2.0× ATR bonus", minval = 0, maxval = 5, group = gQualityW)
wPdDeep = input.int(2, "T2: deep PD touch bonus", minval = 0, maxval = 5, group = gQualityW)
wRrStrong = input.int(2, "RR ≥ 4 bonus (1 if ≥ 3)", minval = 0, maxval = 5, group = gQualityW)
wAsiaWidePenalty = input.int(2, "Asia Wide penalty (T1 takes more)", minval = 0, maxval = 5, group = gQualityW, tooltip = "T1 gets -X, T2 gets -X/2 (T2 handles wide Asia better)")

// =============================================================================
// NY ENGINE (v9.8)
// =============================================================================
gNY = "◆ NY Session Engine (v9.8)"
enableNyEngine = input.bool(true, "Enable NY engine (T1 + T2 in NY session)", group = gNY, tooltip = "Runs the same T1/T2 logic during the NY session (default 14:30–17:00 CET). London engine continues to run in parallel.")
nySweepMode = input.string("Model A + Asia fallback (London H/L always, Asia only if not yet swept)", "NY sweep targets", options = ["Model A + Asia fallback (London H/L always, Asia only if not yet swept)", "Pure Model A (London H/L only)"], group = gNY, tooltip = "Determines what liquidity NY engine watches. Default: London is primary, Asia kicks in as fallback if Asia H/L was untouched during London.")
nyMaxSignals = input.int(1, "Max NY signals per session", minval = 1, maxval = 5, group = gNY, tooltip = "NY has its own counter (separate from London). Default = 1 — first T1 OR T2 fire wins, then NY locks for the day.")
blockNyIfLondonHuge = input.bool(true, "Block NY if London range > N ticks", group = gNY, tooltip = "If London ranged too wide, daily volatility quota is 'spent' and NY tends to be choppy/news-driven. Blocks NY entirely.")
maxNyTicksManual = input.int(500, "Max London ticks before blocking NY", minval = 100, maxval = 10000, step = 50, group = gNY, tooltip = "If London H–L exceeds this, NY engine is locked for the day. Auto-overridden by Symbol Profile (XAUUSD = 4000, EURUSD = 500). Used as-is when profile is Custom.")
maxNyTicks = useCustom ? maxNyTicksManual : profileMaxNyTicks
nyT2RequireSessionRetrace = input.bool(true, "T2 NY: retrace MUST be inside reference range", group = gNY, tooltip = "Same rule as London T2 but applied to whatever NY's reference range is (London or Asia). If ON, T2 NY only fires when retrace is inside the swept session's range.")
nyT1BodyRatio = input.float(0.85, "NY T1 Min Engulfing Body %", minval = 0.50, maxval = 0.95, step = 0.05, group = gNY, tooltip = "Body % required for NY T1 engulf. Default 0.85 — matches London T1.")
nyT2BodyRatio = input.float(0.80, "NY T2 Min Engulfing Body %", minval = 0.50, maxval = 0.95, step = 0.05, group = gNY, tooltip = "Body % required for NY T2 (AMD) engulf. Default 0.80 — matches London T2.")
nyManipMode = input.string("Auto (smart decide based on conditions)", "NY Entry Mode (T1)", options = ["1st Entry Only (aggressive, no manip protection)", "2nd Entry Only (safer, wait for stop-hunt)", "Both (1st + 2nd, fires whichever qualifies first)", "Auto (smart decide based on conditions)"], group = gNY, tooltip = "Manipulation protection for NY T1 entries (T2 doesn't need it — already protected by sweep+displacement). 'Both' = fire whichever happens first. 'Auto' = picks 1st or 2nd based on Asia range and volatility. T2 NY always fires immediately when conditions met.")
nyManipWickAtrManual = input.float(0.1, "NY Manipulation wick size (× ATR)", minval = 0.05, maxval = 0.5, step = 0.05, group = gNY, tooltip = "Min wick size (× ATR) to count as manipulation and arm 2nd entry. Auto-overridden by Symbol Profile (XAUUSD = 0.15, EURUSD = 0.10). Used as-is when profile is Custom.")
nyManipWickAtr = useCustom ? nyManipWickAtrManual : profileNyManipWick
nyAutoVolThreshold = input.float(1.5, "Auto mode: Asia range threshold (× ATR)", minval = 0.5, step = 0.1, group = gNY, tooltip = "When NY Entry Mode = Auto: if Asia range exceeds this × ATR, indicator uses 2nd entry (expect stop-hunts in volatile sessions). Otherwise uses 1st entry (clean conditions). Only used in Auto mode.")
// v9.11: Per-source NY sweep toggles — accept sweeps from any time during the trading day
nyAcceptAH = input.bool(true, "NY accepts Asia High sweep", group = gNY, tooltip = "If ON: NY can fire SHORT setups when Asia High was swept anytime today. Toggle off to ignore AH sweeps.")
nyAcceptAL = input.bool(true, "NY accepts Asia Low sweep", group = gNY, tooltip = "If ON: NY can fire LONG setups when Asia Low was swept anytime today.")
nyAcceptLH = input.bool(true, "NY accepts London High sweep", group = gNY, tooltip = "If ON: NY can fire SHORT setups when London High was swept anytime today.")
nyAcceptLL = input.bool(true, "NY accepts London Low sweep", group = gNY, tooltip = "If ON: NY can fire LONG setups when London Low was swept anytime today.")
showNyEntryLabels = input.bool(true, "Show NY entry labels with [NY] tag", group = gNY)

gManip = "◆ MANIPULATION PROTECTION"
manipMode = input.string("Auto (smart decide based on conditions)", "Entry Mode", options = ["1st Entry Only (aggressive)", "2nd Entry Only (safer, wait for stop-hunt)", "Both (1st + 2nd)", "Auto (smart decide based on conditions)"], group = gManip, tooltip = "Manipulation protection for London T1 entries. 'Both' = fire whichever happens first. 'Auto' = picks 1st or 2nd based on Asia range and volatility (same logic as NY engine). Default: Auto.")
londonAutoVolThreshold = input.float(1.5, "Auto mode: Asia range threshold (× ATR)", minval = 0.5, step = 0.1, group = gManip, tooltip = "When London Entry Mode = Auto: if Asia range exceeds this × ATR, indicator uses 2nd entry (safer in volatile conditions). Otherwise uses 1st entry (aggressive in clean conditions). Only used in Auto mode.")
manipWickAtrManual = input.float(0.1, "Manipulation wick size (× ATR)", minval = 0.05, step = 0.05, group = gManip, tooltip = "Auto-overridden by Symbol Profile (XAUUSD = 0.15, EURUSD = 0.10). Used as-is when profile is Custom.")
manipWickAtr = useCustom ? manipWickAtrManual : profileManipWick
showManipBoxes = input.bool(true, "Show manipulation boxes", group = gManip)
manipBoxColor = input.color(color.new(#ff9800, 70), "Manip box color", group = gManip)

gSwp = "◆ Sweep Detection (binary)"
sweepAsia   = input.bool(true, "Sweep Asia H/L", group = gSwp, inline = "s1")
sweepLondon = input.bool(true, "Sweep London H/L", group = gSwp, inline = "s1")
sweepPDHPDL = input.bool(false, "Sweep PDH/PDL", group = gSwp, inline = "s2")
sweepPWHPWL = input.bool(false, "Sweep PWH/PWL", group = gSwp, inline = "s2")
sweepLookback = input.int(100, "Max bars after Asia to look for sweep", minval = 5, maxval = 200, group = gSwp)
requireCloseBack = input.bool(true, "Sweep must close BACK through level", group = gSwp)
showSweepLines = input.bool(true, "Show Sweep Lines", group = gSwp)
// v9.18: Separate colors for Asia and London sweeps so user can distinguish them
sweepColorAsia   = input.color(color.red,  "Asia Sweep Color (AH/AL)",   group = gSwp)
sweepColorLondon = input.color(color.blue, "London Sweep Color (LH/LL)", group = gSwp)
// Backwards-compat alias for any older code that still references this name:
sweepLineColor = sweepColorAsia

gPd = "◆ PD Array Touch"
pdTouchWindow = input.int(20, "Must touch within N bars of sweep", minval = 2, maxval = 30, group = gPd)
maxPdZones = input.int(4, "Max Recent PD Zones to Check", minval = 1, maxval = 5, group = gPd)

gEng = "◆ Strong Engulfing"
minBodyRatio = input.float(0.85, "Min Body % of Candle Range", minval = 0.30, maxval = 0.95, step = 0.05, group = gEng, tooltip = "Lower = allows more entries (wicks OK). Higher = stricter full-body candles only.")
requireEngulf = input.bool(false, "Require formal engulfing pattern", group = gEng)

gLowVol = "◆ Low-Volume / Tiny-Candle Filter"
enableLowVolFilter = input.bool(true, "Enable low-volume filter", group = gLowVol)
minCandleAtr = input.float(0.4, "Min current candle range (× ATR)", minval = 0.1, maxval = 2.0, step = 0.1, group = gLowVol)
minAvgBodyAtr = input.float(0.3, "Min avg body last 5 bars (× ATR)", minval = 0.1, maxval = 1.0, step = 0.05, group = gLowVol)
minVolRatio = input.float(0.7, "Min volume ratio (× 20-bar avg)", minval = 0.3, maxval = 2.0, step = 0.1, group = gLowVol)

gVolConf = "◆ Volume Confirmation"
enableVolConfirm = input.bool(true, "Require volume spike on engulf", group = gVolConf, tooltip = "Engulf candle must have above-average volume to fire. Filters weak/unconvincing entries.")
overrideVolConfirmMult = input.bool(true, "Override vol mult (ignore symbol profile)", group = gVolConf, inline = "vc", tooltip = "When ON: always uses the multiplier below, overriding the symbol profile auto-value. When OFF (default): profile controls the value (EUR=1.20, XAU=1.20). Enable this when you want to test lower thresholds like 1.0.")
volConfirmMultManual = input.float(1.0, "× avg", minval = 0.5, maxval = 3.0, step = 0.1, group = gVolConf, inline = "vc", tooltip = "Min volume spike multiplier. 1.2 = engulf candle needs 20% above avg volume. Only active when Override checkbox is ON or Symbol Profile is Custom.")
volConfirmMult = (useCustom or overrideVolConfirmMult) ? volConfirmMultManual : profileVolConfirm

gCool = "◆ Setup Lifespan"
useFullLondonWindow = input.bool(true, "Setup alive for entire London (+buffer)", group = gCool)
maxDistanceAtr = input.float(1.0, "Max distance from swept level (× ATR)", minval = 1.0, step = 0.5, group = gCool)

gLimits = "◆ Session Signal Limits"
maxSignalsPerSession = input.int(1, "Max Signals Per Session (0 = unlimited)", minval = 0, maxval = 10, group = gLimits, tooltip = "Total T1 + T2 signals allowed per London session. 0 = no limit.")

gRange = "◆ Asia Range Filter"
maxAsiaRangeAtr = input.float(1.5, "Max Asia Range (× ATR) — warn if bigger", minval = 0.5, step = 0.1, group = gRange)
blockIfNoSweep = input.bool(true, "Block signals if no sweep yet", group = gRange)
blockIfAsiaHuge = input.bool(true, "Block if Asia > huge threshold", group = gRange)
hugeAsiaAtr = input.float(10.0, "Huge Asia threshold (× ATR)", minval = 2.0, step = 0.5, group = gRange)
blockIfAsiaTooManyTicks = input.bool(true, "Block ALL signals if Asia > N ticks (hard cap)", group = gRange, tooltip = "Hard ceiling on Asia range in ticks — when Asia gets this wide it usually means news/illiquid session and risk/reward becomes unfavourable. Blocks BOTH T1 and T2.")
maxAsiaTicksManual = input.int(500, "Max Asia ticks (hard cap)", minval = 100, maxval = 10000, step = 50, group = gRange, tooltip = "If Asia range exceeds this, no signals fire this session. Auto-overridden by Symbol Profile (XAUUSD = 4000, EURUSD = 500). Used as-is when profile is Custom.")
maxAsiaTicks = useCustom ? maxAsiaTicksManual : profileMaxAsiaTicks

// =============================================================================
// INPUTS — NEW TP ENGINE
// =============================================================================
gTP = "◆ TP Engine — Min/Max RR"
minRR = input.float(2.5, "Minimum Risk:Reward", minval = 0.5, step = 0.1, group = gTP, tooltip = "TP must give AT LEAST this RR. Below = no trade.")
maxRR = input.float(4.0, "Maximum Risk:Reward (cap)", minval = 2.0, step = 0.5, group = gTP, tooltip = "10.0 = effectively no cap. Lower to 4.0 or 5.0 to cap.")
tpBuffer = input.float(2.5, "TP buffer from level (ticks)", minval = 0, step = 1, group = gTP)

gTPLevels = "◆ TP Candidate Levels (enable which to target)"
useFvg5TP   = input.bool(false, "Use 5m FVG as TP target", group = gTPLevels)
useFvg15TP  = input.bool(false, "Use 15m FVG as TP target", group = gTPLevels)
useFvg30TP  = input.bool(false, "Use 30m FVG as TP target", group = gTPLevels)
useObTP     = input.bool(true, "Use Order Blocks as TP target", group = gTPLevels)
useAsiaTP   = input.bool(true, "Use Asia H/L as TP target", group = gTPLevels)
usePDHPDLTP = input.bool(true, "Use PDH/PDL as TP target", group = gTPLevels)
useWeakSwingTP = input.bool(true, "Use Weak swing H/L as TP target", group = gTPLevels)
useIntSwingTP  = input.bool(true, "Use Intermediate swing H/L as TP target", group = gTPLevels)
useStrongSwingTP = input.bool(false, "Use Strong swing H/L as TP target", group = gTPLevels)

gTPPlacement = "◆ TP Placement on FVG/OB zones"
fvgObPlacement = input.string("Near side (conservative)", "FVG/OB TP placement", options = ["Near side (conservative)", "Middle (balanced)", "Far side (aggressive)"], group = gTPPlacement, tooltip = "Where to set TP when the target is a zone (FVG or OB) — near side fills first, far side requires full fill")

gSwing = "◆ Swing H/L Structure (Weak/Int/Strong)"
weakSwingBars   = input.int(20,  "Weak swing lookback bars", minval = 5, maxval = 100, group = gSwing, tooltip = "Short-term structure — most common targets")
intSwingBars    = input.int(50,  "Intermediate swing lookback bars", minval = 20, maxval = 150, group = gSwing, tooltip = "Mid-term structure")
strongSwingBars = input.int(100, "Strong swing lookback bars", minval = 50, maxval = 300, group = gSwing)
showWeakSwing   = input.bool(false, "Show Weak H/L lines", group = gSwing, inline = "w1")
weakSwingColor  = input.color(color.new(#f39c12, 40), "", group = gSwing, inline = "w1")
showIntSwing    = input.bool(false, "Show Intermediate H/L lines", group = gSwing, inline = "w2")
intSwingColor   = input.color(color.new(#e67e22, 40), "", group = gSwing, inline = "w2")
showStrongSwing = input.bool(false, "Show Strong H/L lines", group = gSwing, inline = "w3")
strongSwingColor = input.color(color.new(#c0392b, 30), "", group = gSwing, inline = "w3")

gHtf = "◆ HTF Alignment"
htfAlignMode = input.string("Off (no filter)", "HTF Alignment", options = ["Off (no filter)", "4H only", "30m only", "30m + 4H must agree", "30m OR 4H must agree"], group = gHtf)
htfMinScore = input.int(25, "HTF Score Threshold", minval = 15, maxval = 60, group = gHtf)

gBias = "◆ Manual HTF Bias"
manualBias = input.string("Auto (indicator decides)", "Your Bias", options = ["Auto (indicator decides)", "BULLISH (longs only)", "BEARISH (shorts only)", "NEUTRAL (both allowed)"], group = gBias)

gFvgVis = "◆ FVG Display"
showFvg = input.bool(true, "Show FVGs", group = gFvgVis)
hideFilledFvg = input.bool(true, "Auto-Delete Filled FVGs", group = gFvgVis)
minFvgSizeTicks = input.int(4, "Min FVG Size (ticks)", minval = 0, group = gFvgVis)
maxActiveFvgs = input.int(4, "Max Active FVGs per TF", minval = 1, maxval = 8, group = gFvgVis)
showFvg5 = input.bool(true, "5m FVGs", group = gFvgVis, inline = "f1")
showFvg15 = input.bool(false, "15m FVGs", group = gFvgVis, inline = "f2")
showFvg30 = input.bool(false, "30m FVGs", group = gFvgVis, inline = "f3")
fvg5Color = input.color(color.new(#26a69a, 80), "", group = gFvgVis, inline = "f1")
fvg15Color = input.color(color.new(#3498db, 75), "", group = gFvgVis, inline = "f2")
fvg30Color = input.color(color.new(#9b59b6, 70), "", group = gFvgVis, inline = "f3")

gOb = "◆ Order Blocks"
showOb = input.bool(false, "Show OBs", group = gOb)
obMinMoveAtr = input.float(1.0, "Min Displacement (× ATR)", minval = 0.5, step = 0.1, group = gOb)
maxActiveObs = input.int(3, "Max Active OBs", minval = 1, maxval = 8, group = gOb)

gTrend = "◆ HTF Trend TFs"
biasTF1 = input.timeframe("30", "HTF Bias 1", options = ["15", "30", "60"], group = gTrend)
biasTF2 = input.timeframe("240", "HTF Bias 2", options = ["60", "240", "D"], group = gTrend)
trendLookback = input.int(50, "Trend Lookback", minval = 5, maxval = 50, group = gTrend)

gTrade = "◆ Trade Visuals"
slBuffer = input.float(10.0, "SL Buffer (ticks)", minval = 0, step = 1, group = gTrade)
slSwingLookback = input.int(16, "SL Swing Lookback (bars)", minval = 3, maxval = 20, step = 1, group = gTrade, tooltip = "Finds the nearest swing high/low within this many bars for tighter SLs. Lower = tighter SL. Higher = safer but wider SL.")
slMinAtrDistManual = input.float(0.4, "SL Min Distance (× ATR)", minval = 0.1, maxval = 1.0, step = 0.05, group = gTrade, tooltip = "If chosen SL is closer than this × ATR to entry, fall back to next-wider SL source. Auto-overridden by Symbol Profile (XAUUSD = 0.50, EURUSD = 0.40). Used as-is when profile is Custom.")
slMinAtrDist = useCustom ? slMinAtrDistManual : profileSlMinAtr
slUseEngulfFirst = input.bool(false, "SL: Engulf low/high first", group = gTrade, tooltip = "Use the engulfing candle's wick as primary SL. Tightest correct invalidation = best RR. If too tight (< Min ATR Dist), falls back to swing → London → Asia.")
slShowSrcInLabel = input.bool(true, "Show SL source in label", group = gTrade, tooltip = "Adds (engulf) / (swing) / (London) / (Asia) to entry label so you know which SL rule fired.")
showRrBox = input.bool(true, "Show SL/TP Boxes", group = gTrade)

gLiq = "◆ Daily/Weekly Liquidity"
pdhDaysBack = input.int(1, "Show H/L from last N days", minval = 1, maxval = 5, group = gLiq, tooltip = "1 = yesterday only. Auto-redraws daily.")
showPDH = input.bool(false, "Daily High lines", group = gLiq, inline = "d1")
pdhColor = input.color(color.new(#e74c3c, 30), "", group = gLiq, inline = "d1")
showPDL = input.bool(false, "Daily Low lines", group = gLiq, inline = "d2")
pdlColor = input.color(color.new(#3498db, 30), "", group = gLiq, inline = "d2")
showPWH = input.bool(false, "PWH", group = gLiq, inline = "w1")
pwhColor = input.color(color.new(#c0392b, 30), "", group = gLiq, inline = "w1")
showPWL = input.bool(false, "PWL", group = gLiq, inline = "w2")
pwlColor = input.color(color.new(#2471a3, 30), "", group = gLiq, inline = "w2")

gVis = "◆ Visuals"
showLabels = input.bool(true, "Entry Labels", group = gVis)
showDashboard = input.bool(true, "Dashboard", group = gVis)
showWatchPanel = input.bool(true, "Live Watch Panel", group = gVis)
bullColor = input.color(#00bcd4, "Bull", group = gVis)
bearColor = input.color(#ef5350, "Bear", group = gVis)

gOutcome = "◆ Trade Outcome Tracking (v9.23)"
enableBEMove = input.bool(true, "Auto Move SL to Breakeven", group = gOutcome, tooltip = "When price moves X R in your favour, SL is automatically moved to entry (breakeven). If price reverses back, you exit at 0R instead of -1R.")
beThresholdR = input.float(1.5, "BE Trigger (R in profit)", minval = 0.5, maxval = 5.0, step = 0.5, group = gOutcome, tooltip = "How many R price must move in profit before SL → BE. 1.5 = when price is 1.5× the SL distance in profit.")

// =============================================================================
// PHONE ALERTS GROUP (v9.12)
// =============================================================================
gAlerts = "◆ Phone Alerts (v9.12)"
enablePhoneAlerts = input.bool(true, "Enable rich phone alerts", group = gAlerts, tooltip = "Master toggle. When ON, every trade fire emits an alert() with full message: symbol, side, entry, SL, TP, RR, source, warnings. REQUIRES TradingView Pro+ for push notifications. After enabling, set up ONE alert in TradingView: right-click chart → Add Alert → Condition: 'WMFx KZ v9.13 → Any alert() function call' → Notifications: Push notifications + App.")
alertOn5m = input.bool(true, "Alert on 5m fires", group = gAlerts, tooltip = "Send alert when a 5m logic-TF fire happens (London or NY, T1 or T2). Tag in alert message: [5m].")
alertOn1m = input.bool(true, "Alert on 1m precision fires", group = gAlerts, tooltip = "Send alert when a 1m precision fire happens (London or NY, T1 or T2). Tag in alert message: {1m-V1} or {1m-V2}. Set up as a SEPARATE TradingView alert if you want different sound/routing for 1m vs 5m.")
playChartSound = input.bool(true, "Play chart sound on fire (when at desk)", group = gAlerts, tooltip = "Plays an audible chart sound when any fire happens, in addition to the phone push. Useful when you're at the desk and want to be notified without checking phone.")
// v9.13: Telegram-specific formatting


// =============================================================================
// TOP-LEVEL CALCULATIONS
// =============================================================================
atr14  = ta.atr(14)
volAvg = ta.sma(volume, 20)
volMult = volAvg > 0 ? volume / volAvg : 1.0
bodySize = math.abs(close - open)
avgBody5 = ta.sma(bodySize, 5)

// =============================================================================
// LOGIC TIMEFRAME DATA FETCH (v9.7)
// All strategy logic uses these values. When chart TF == logic TF, they equal
// the chart bars. When chart TF < logic TF, they reflect the logic TF bars.
// lookahead_off + barmerge_gaps_off avoids future-leak.
// =============================================================================
[ltfOpen, ltfHigh, ltfLow, ltfClose, ltfVolume, ltfAtr, ltfVolAvg, ltfBody5] = request.security(
     syminfo.tickerid, logicTF,
     [open, high, low, close, volume, ta.atr(14), ta.sma(volume, 20), ta.sma(math.abs(close - open), 5)],
     lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)

// "Effective" candle data — used by all engulf/volume/body checks downstream.
// On 5m chart with 5m logic these equal chart vars exactly.
// On 1m chart with 5m logic these are the logic-TF (5m) values at each 1m bar.
effOpen   = chartIsBelowLogic ? ltfOpen   : open
effHigh   = chartIsBelowLogic ? ltfHigh   : high
effLow    = chartIsBelowLogic ? ltfLow    : low
effClose  = chartIsBelowLogic ? ltfClose  : close
effVolume = chartIsBelowLogic ? ltfVolume : volume
effAtr    = chartIsBelowLogic ? ltfAtr    : atr14
effVolAvg = chartIsBelowLogic ? ltfVolAvg : volAvg
effBody5  = chartIsBelowLogic ? ltfBody5  : avgBody5
effBodySize = math.abs(effClose - effOpen)
effVolMult = effVolAvg > 0 ? effVolume / effVolAvg : 1.0

// =============================================================================
// FORMING LOGIC-TF BAR TRACKER (v9.7) — used by Variant 1 forward-look
// When chart TF < logic TF, we accumulate chart-bar data to reconstruct the
// CURRENTLY FORMING logic-TF bar in real time. This lets Variant 1 check
// "if the 5m bar closed RIGHT NOW, would all conditions pass?" instead of
// looking at the previous closed 5m bar.
// =============================================================================
var float formingOpen = na
var float formingHigh = na
var float formingLow = na
var float formingVolume = 0.0
var int formingBarCount = 0

// Detect logic-TF bar boundary on chart bars
isNewLogicBar = chartIsBelowLogic ? (ta.change(time(logicTF)) != 0) : true

if isNewLogicBar
    formingOpen := open
    formingHigh := high
    formingLow := low
    formingVolume := volume
    formingBarCount := 1
else
    formingHigh := math.max(nz(formingHigh, high), high)
    formingLow := math.min(nz(formingLow, low), low)
    formingVolume += volume
    formingBarCount += 1

// Forming-5m candle metrics (use these in Variant 1 partial validation)
formingClose = close
formingRange = nz(formingHigh, high) - nz(formingLow, low)
formingBullBody = formingClose > nz(formingOpen, open) ? formingClose - nz(formingOpen, open) : 0.0
formingBearBody = formingClose < nz(formingOpen, open) ? nz(formingOpen, open) - formingClose : 0.0
formingBullPct = formingRange > 0 ? formingBullBody / formingRange : 0.0
formingBearPct = formingRange > 0 ? formingBearBody / formingRange : 0.0

// Swing highs/lows — 3 tiers
weakHigh = ta.highest(high, weakSwingBars)
weakLow  = ta.lowest(low, weakSwingBars)
intHigh  = ta.highest(high, intSwingBars)
intLow   = ta.lowest(low, intSwingBars)
strongHigh = ta.highest(high, strongSwingBars)
strongLow  = ta.lowest(low, strongSwingBars)

plot(showWeakSwing   ? weakHigh   : na, "Weak High",     color = weakSwingColor,   linewidth = 1, style = plot.style_linebr)
plot(showWeakSwing   ? weakLow    : na, "Weak Low",      color = weakSwingColor,   linewidth = 1, style = plot.style_linebr)
plot(showIntSwing    ? intHigh    : na, "Int High",      color = intSwingColor,    linewidth = 1, style = plot.style_linebr)
plot(showIntSwing    ? intLow     : na, "Int Low",       color = intSwingColor,    linewidth = 1, style = plot.style_linebr)
plot(showStrongSwing ? strongHigh : na, "Strong High",   color = strongSwingColor, linewidth = 2, style = plot.style_linebr)
plot(showStrongSwing ? strongLow  : na, "Strong Low",    color = strongSwingColor, linewidth = 2, style = plot.style_linebr)

// =============================================================================
// SESSIONS + EXTENDED LONDON
// =============================================================================
inAsia   = not na(time(timeframe.period, asiaSess))
inLondon = not na(time(timeframe.period, londonSess))
inNY     = not na(time(timeframe.period, nySess))

asiaStarted   = inAsia   and not inAsia[1]
asiaEnded     = not inAsia and inAsia[1]
londonStarted = inLondon and not inLondon[1]
londonEnded   = not inLondon and inLondon[1]
nyStarted     = inNY     and not inNY[1]

var int asiaEndBar = na
var int londonEndBar = na
// v9.18: Track London session start bar (used as origin for London sweep lines)
var int londonStartBar = na
var bool londonAlertSent = false  // v9.23: gates London webhook — only first FIRED trade per session sends alert
var bool nyAlertSent = false      // v9.23: same gate for NY session
// v9.23: Trade Outcome Tracking — SL/TP detection + monthly stats
var bool   outcomeActive  = false
var string outcomeDir     = ""
var string outcomeType    = ""
var string outcomeSess    = ""
var float  outcomeEntry   = na
var float  outcomeSL      = na
var float  outcomeTP      = na
var float  outcomeRR      = na
var int    outcomeFireBar = na
var bool   outcomeBEMoved = false
var array<int>   mStatKeys   = array.new_int(0)
var array<int>   mStatWins   = array.new_int(0)
var array<int>   mStatLosses = array.new_int(0)
var array<float> mStatR      = array.new_float(0)
var array<int>   yStatKeys   = array.new_int(0)
var array<int>   yStatWins   = array.new_int(0)
var array<int>   yStatLosses = array.new_int(0)
var array<float> yStatR      = array.new_float(0)

if asiaEnded
    asiaEndBar := bar_index
if londonStarted
    londonStartBar := bar_index
if londonEnded
    londonEndBar := bar_index

inLondonExt = inLondon or (not na(londonEndBar) and (bar_index - londonEndBar) <= sessionBufferBars and not inAsia and not inNY)
sessionName = inAsia ? "Asia" : inLondon ? "London" : inLondonExt ? "London+ext" : inNY ? (enableNyEngine ? "NY" : "NY (off)") : "Off"

// =============================================================================
// HTF SCORES
// =============================================================================
[bSum30, sSum30, c30, cLB30, atr30, hh30, ll30, hhm30, llm30] = request.security(syminfo.tickerid, biasTF1,
  [math.sum(close >= open ? volume : 0.0, trendLookback),
   math.sum(close <  open ? volume : 0.0, trendLookback),
   close, close[trendLookback], ta.atr(14),
   ta.highest(high, trendLookback), ta.lowest(low, trendLookback),
   ta.highest(high, math.max(2, int(trendLookback / 2))),
   ta.lowest(low, math.max(2, int(trendLookback / 2)))])

[bSum4h, sSum4h, c4h, cLB4h, atr4h, hh4h, ll4h, hhm4h, llm4h] = request.security(syminfo.tickerid, biasTF2,
  [math.sum(close >= open ? volume : 0.0, trendLookback),
   math.sum(close <  open ? volume : 0.0, trendLookback),
   close, close[trendLookback], ta.atr(14),
   ta.highest(high, trendLookback), ta.lowest(low, trendLookback),
   ta.highest(high, math.max(2, int(trendLookback / 2))),
   ta.lowest(low, math.max(2, int(trendLookback / 2)))])

computeTrend(bSum, sSum, c, cLB, atrH, hh, ll, hhm, llm) =>
    tot = bSum + sSum
    vImb = tot > 0 ? (bSum - sSum) / tot : 0.0
    mRaw = atrH > 0 ? (c - cLB) / (atrH * trendLookback * 0.5) : 0.0
    mom = math.max(-1.0, math.min(1.0, mRaw))
    ss = 0.0
    if hhm >= hh * 0.998
        ss := ss + 0.5
    if llm >= ll * 1.002
        ss := ss + 0.5
    if llm <= ll * 1.002
        ss := ss - 0.5
    if hhm <= hh * 0.998
        ss := ss - 0.5
    ss := math.max(-1.0, math.min(1.0, ss))
    (vImb * 0.5 + mom * 0.3 + ss * 0.2) * 100.0

score30m = computeTrend(bSum30, sSum30, c30, cLB30, atr30, hh30, ll30, hhm30, llm30)
score4h  = computeTrend(bSum4h, sSum4h, c4h, cLB4h, atr4h, hh4h, ll4h, hhm4h, llm4h)

biasLabel(s) => s >= 60 ? "STRONG BULL" : s >= 25 ? "BULLISH" : s >= -25 ? "NEUTRAL" : s >= -60 ? "BEARISH" : "STRONG BEAR"
biasColor(s) => s >= 60 ? color.new(#00c853, 0) : s >= 25 ? bullColor : s >= -25 ? color.gray : s >= -60 ? bearColor : color.new(#d50000, 0)
monthStr(m) => m == 1 ? "Jan" : m == 2 ? "Feb" : m == 3 ? "Mar" : m == 4 ? "Apr" : m == 5 ? "May" : m == 6 ? "Jun" : m == 7 ? "Jul" : m == 8 ? "Aug" : m == 9 ? "Sep" : m == 10 ? "Oct" : m == 11 ? "Nov" : "Dec"

bull30m = score30m >=  htfMinScore
bear30m = score30m <= -htfMinScore
bull4h  = score4h  >=  htfMinScore
bear4h  = score4h  <= -htfMinScore

htfAllowsLong = false
htfAllowsShort = false

if htfAlignMode == "Off (no filter)"
    htfAllowsLong  := true
    htfAllowsShort := true
else if htfAlignMode == "4H only"
    htfAllowsLong  := bull4h
    htfAllowsShort := bear4h
else if htfAlignMode == "30m only"
    htfAllowsLong  := bull30m
    htfAllowsShort := bear30m
else if htfAlignMode == "30m + 4H must agree"
    htfAllowsLong  := bull30m and bull4h
    htfAllowsShort := bear30m and bear4h
else if htfAlignMode == "30m OR 4H must agree"
    htfAllowsLong  := (bull30m or bull4h) and not (bear30m and bear4h)
    htfAllowsShort := (bear30m or bear4h) and not (bull30m and bull4h)

manualLongsOnly  = manualBias == "BULLISH (longs only)"
manualShortsOnly = manualBias == "BEARISH (shorts only)"
manualNeutral    = manualBias == "NEUTRAL (both allowed)"
manualAuto       = manualBias == "Auto (indicator decides)"

// Bias filter: same for T1 and T2 (both follow the directional bias)
// BULLISH → only LONGs allowed (T1 LONG + T2 LONG)
// BEARISH → only SHORTs allowed (T1 SHORT + T2 SHORT)
// NEUTRAL → all allowed
// AUTO → uses HTF scores
finalLongOK  = not enableBiasFilter ? true : (manualAuto ? htfAllowsLong  : (manualLongsOnly or manualNeutral))
finalShortOK = not enableBiasFilter ? true : (manualAuto ? htfAllowsShort : (manualShortsOnly or manualNeutral))

// =============================================================================
// SESSION BOXES
// =============================================================================
var float asiaHigh = na
var float asiaLow  = na
var box   asiaBoxId = na
var line  asiaHL = na
var line  asiaLL = na

if asiaStarted
    asiaHigh := high
    asiaLow  := low
    if showAsiaBox
        asiaBoxId := box.new(bar_index, high, bar_index, low, bgcolor = asiaColor, border_color = asiaColor)
else if inAsia
    asiaHigh := math.max(nz(asiaHigh, high), high)
    asiaLow  := math.min(nz(asiaLow,  low),  low)
    if showAsiaBox and not na(asiaBoxId)
        box.set_top(asiaBoxId, asiaHigh)
        box.set_bottom(asiaBoxId, asiaLow)
        box.set_right(asiaBoxId, bar_index)

if asiaEnded and not na(asiaHigh)
    asiaHL := line.new(bar_index - 1, asiaHigh, bar_index + 50, asiaHigh, color = color.new(#e74c3c, 0))
    asiaLL := line.new(bar_index - 1, asiaLow,  bar_index + 50, asiaLow,  color = color.new(#3498db, 0))

if not na(asiaHL)
    line.set_x2(asiaHL, bar_index + 50)
if not na(asiaLL)
    line.set_x2(asiaLL, bar_index + 50)

asiaRangeSize = not na(asiaHigh) and not na(asiaLow) ? asiaHigh - asiaLow : 0.0
asiaTooWide = asiaRangeSize > atr14 * maxAsiaRangeAtr
asiaHuge = asiaRangeSize > atr14 * hugeAsiaAtr
// v9.6: Hard tick-based cap — blocks ALL signals when Asia range exceeds maxAsiaTicks
asiaRangeTicks = asiaRangeSize / syminfo.mintick
asiaTicksBlock = blockIfAsiaTooManyTicks and asiaRangeTicks > maxAsiaTicks

var box londonBoxId = na
var box nyBoxId = na
var float londonHigh = na
var float londonLow = na
var float nyHigh = na
var float nyLow = na

if londonStarted
    londonHigh := high
    londonLow  := low
    londonAlertSent := false
    if showLondonBox
        londonBoxId := box.new(bar_index, high, bar_index, low, bgcolor = londonColor, border_color = londonColor)
else if inLondon
    londonHigh := math.max(nz(londonHigh, high), high)
    londonLow  := math.min(nz(londonLow,  low),  low)
    if showLondonBox and not na(londonBoxId)
        box.set_top(londonBoxId, londonHigh)
        box.set_bottom(londonBoxId, londonLow)
        box.set_right(londonBoxId, bar_index)

// NY H/L tracking — used for sweep targets and Smart SL chain
if nyStarted
    nyHigh := high
    nyLow  := low
    nyAlertSent := false
else if inNY
    nyHigh := math.max(nz(nyHigh, high), high)
    nyLow  := math.min(nz(nyLow,  low),  low)

if nyStarted and showNYBox
    nyBoxId := box.new(bar_index, high, bar_index, low, bgcolor = nyColor, border_color = nyColor)
else if inNY and showNYBox and not na(nyBoxId)
    box.set_top(nyBoxId, math.max(box.get_top(nyBoxId), high))
    box.set_bottom(nyBoxId, math.min(box.get_bottom(nyBoxId), low))
    box.set_right(nyBoxId, bar_index)

// =============================================================================
// PDH/PDL LINES (multi-day redraw)
// =============================================================================
var array<line>  dayHighLines = array.new<line>()
var array<line>  dayLowLines  = array.new<line>()
var array<float> dayHighs = array.new_float()
var array<float> dayLows  = array.new_float()
var array<int>   dayStarts = array.new_int()
var int currentDayStart = na
var float currentDayH = na
var float currentDayL = na

isNewDay = ta.change(time("D")) != 0

if isNewDay
    if not na(currentDayStart) and not na(currentDayH) and not na(currentDayL)
        array.push(dayHighs, currentDayH)
        array.push(dayLows, currentDayL)
        array.push(dayStarts, currentDayStart)
    currentDayStart := bar_index
    currentDayH := high
    currentDayL := low
    while array.size(dayHighs) > pdhDaysBack
        array.shift(dayHighs)
        array.shift(dayLows)
        array.shift(dayStarts)
    while array.size(dayHighLines) > 0
        ln = array.shift(dayHighLines)
        if not na(ln)
            line.delete(ln)
    while array.size(dayLowLines) > 0
        ln = array.shift(dayLowLines)
        if not na(ln)
            line.delete(ln)
    if array.size(dayHighs) > 0
        for i = 0 to array.size(dayHighs) - 1
            startB = array.get(dayStarts, i)
            dh = array.get(dayHighs, i)
            dl = array.get(dayLows, i)
            if showPDH
                hl = line.new(startB, dh, bar_index + 100, dh, color = pdhColor, width = 1, style = line.style_solid)
                array.push(dayHighLines, hl)
            if showPDL
                ll = line.new(startB, dl, bar_index + 100, dl, color = pdlColor, width = 1, style = line.style_solid)
                array.push(dayLowLines, ll)
else
    if not na(currentDayStart)
        currentDayH := math.max(nz(currentDayH, high), high)
        currentDayL := math.min(nz(currentDayL, low), low)

if array.size(dayHighLines) > 0
    for i = 0 to array.size(dayHighLines) - 1
        ln = array.get(dayHighLines, i)
        if not na(ln)
            line.set_x2(ln, bar_index + 50)
if array.size(dayLowLines) > 0
    for i = 0 to array.size(dayLowLines) - 1
        ln = array.get(dayLowLines, i)
        if not na(ln)
            line.set_x2(ln, bar_index + 50)

pdh = array.size(dayHighs) > 0 ? array.get(dayHighs, array.size(dayHighs) - 1) : na
pdl = array.size(dayLows)  > 0 ? array.get(dayLows,  array.size(dayLows)  - 1) : na

[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
plot(showPWH ? pwh : na, "PWH", color = pwhColor, linewidth = 2, style = plot.style_circles)
plot(showPWL ? pwl : na, "PWL", color = pwlColor, linewidth = 2, style = plot.style_circles)

// =============================================================================
// MULTI-TF FVG DETECTION
// =============================================================================
minFvgSize = minFvgSizeTicks * syminfo.mintick

var array<box>   bullFvgB  = array.new<box>()
var array<float> bullFvgT  = array.new_float()
var array<float> bullFvgBo = array.new_float()
var array<int>   bullFvgBr = array.new_int()
var array<box>   bearFvgB  = array.new<box>()
var array<float> bearFvgT  = array.new_float()
var array<float> bearFvgBo = array.new_float()
var array<int>   bearFvgBr = array.new_int()

newBullFvg = low > high[2] and close[1] > open[1] and (low - high[2]) >= minFvgSize
newBearFvg = high < low[2] and close[1] < open[1] and (low[2] - high) >= minFvgSize

if newBullFvg
    nb = showFvg5 ? box.new(bar_index - 2, low, bar_index, high[2], bgcolor = fvg5Color, border_color = color.new(bullColor, 40), text = "5m FVG", text_size = size.tiny, text_color = color.new(bullColor, 20)) : na
    array.push(bullFvgB, nb)
    array.push(bullFvgT, low)
    array.push(bullFvgBo, high[2])
    array.push(bullFvgBr, bar_index)

if newBearFvg
    nb = showFvg5 ? box.new(bar_index - 2, low[2], bar_index, high, bgcolor = fvg5Color, border_color = color.new(bearColor, 40), text = "5m FVG", text_size = size.tiny, text_color = color.new(bearColor, 20)) : na
    array.push(bearFvgB, nb)
    array.push(bearFvgT, low[2])
    array.push(bearFvgBo, high)
    array.push(bearFvgBr, bar_index)

[f15BullLow, f15BullTop, f15BullFlag, f15BearHi, f15BearBot, f15BearFlag] = request.security(syminfo.tickerid, "15",
  [low, high[2], low > high[2] and close[1] > open[1] and (low - high[2]) >= minFvgSize,
   low[2], high, high < low[2] and close[1] < open[1] and (low[2] - high) >= minFvgSize])

var bool f15BullPrev = false
var bool f15BearPrev = false
var array<box> fvg15BullBoxes = array.new<box>()
var array<box> fvg15BearBoxes = array.new<box>()
var array<float> fvg15BullTops = array.new_float()
var array<float> fvg15BullBots = array.new_float()
var array<float> fvg15BearTops = array.new_float()
var array<float> fvg15BearBots = array.new_float()

if f15BullFlag and not f15BullPrev and not na(f15BullLow) and not na(f15BullTop)
    if showFvg15
        nb = box.new(bar_index - 3, f15BullLow, bar_index, f15BullTop, bgcolor = fvg15Color, border_color = color.new(#3498db, 30), text = "15m FVG", text_size = size.tiny, text_color = color.new(#3498db, 0))
        array.push(fvg15BullBoxes, nb)
    array.push(fvg15BullTops, f15BullLow)
    array.push(fvg15BullBots, f15BullTop)

if f15BearFlag and not f15BearPrev and not na(f15BearHi) and not na(f15BearBot)
    if showFvg15
        nb = box.new(bar_index - 3, f15BearHi, bar_index, f15BearBot, bgcolor = fvg15Color, border_color = color.new(#3498db, 30), text = "15m FVG", text_size = size.tiny, text_color = color.new(#3498db, 0))
        array.push(fvg15BearBoxes, nb)
    array.push(fvg15BearTops, f15BearHi)
    array.push(fvg15BearBots, f15BearBot)

f15BullPrev := f15BullFlag
f15BearPrev := f15BearFlag

[f30BullLow, f30BullTop, f30BullFlag, f30BearHi, f30BearBot, f30BearFlag] = request.security(syminfo.tickerid, "30",
  [low, high[2], low > high[2] and close[1] > open[1] and (low - high[2]) >= minFvgSize,
   low[2], high, high < low[2] and close[1] < open[1] and (low[2] - high) >= minFvgSize])

var bool f30BullPrev = false
var bool f30BearPrev = false
var array<box> fvg30BullBoxes = array.new<box>()
var array<box> fvg30BearBoxes = array.new<box>()
var array<float> fvg30BullTops = array.new_float()
var array<float> fvg30BullBots = array.new_float()
var array<float> fvg30BearTops = array.new_float()
var array<float> fvg30BearBots = array.new_float()

if f30BullFlag and not f30BullPrev and showFvg30 and not na(f30BullLow) and not na(f30BullTop)
    nb = box.new(bar_index - 6, f30BullLow, bar_index, f30BullTop, bgcolor = fvg30Color, border_color = color.new(#9b59b6, 30), text = "30m FVG", text_size = size.tiny, text_color = color.new(#9b59b6, 0))
    array.push(fvg30BullBoxes, nb)
    array.push(fvg30BullTops, f30BullLow)
    array.push(fvg30BullBots, f30BullTop)

if f30BearFlag and not f30BearPrev and showFvg30 and not na(f30BearHi) and not na(f30BearBot)
    nb = box.new(bar_index - 6, f30BearHi, bar_index, f30BearBot, bgcolor = fvg30Color, border_color = color.new(#9b59b6, 30), text = "30m FVG", text_size = size.tiny, text_color = color.new(#9b59b6, 0))
    array.push(fvg30BearBoxes, nb)
    array.push(fvg30BearTops, f30BearHi)
    array.push(fvg30BearBots, f30BearBot)

f30BullPrev := f30BullFlag
f30BearPrev := f30BearFlag

// Delete filled FVGs
if hideFilledFvg
    k = array.size(bullFvgB) - 1
    while k >= 0 and array.size(bullFvgB) > 0 and k < array.size(bullFvgB)
        if close < array.get(bullFvgBo, k)
            bx = array.get(bullFvgB, k)
            if not na(bx)
                box.delete(bx)
            array.remove(bullFvgB, k)
            array.remove(bullFvgT, k)
            array.remove(bullFvgBo, k)
            array.remove(bullFvgBr, k)
        k := k - 1
    k := array.size(bearFvgB) - 1
    while k >= 0 and array.size(bearFvgB) > 0 and k < array.size(bearFvgB)
        if close > array.get(bearFvgT, k)
            bx = array.get(bearFvgB, k)
            if not na(bx)
                box.delete(bx)
            array.remove(bearFvgB, k)
            array.remove(bearFvgT, k)
            array.remove(bearFvgBo, k)
            array.remove(bearFvgBr, k)
        k := k - 1
    k := array.size(fvg15BullBoxes) - 1
    while k >= 0 and array.size(fvg15BullBoxes) > 0 and k < array.size(fvg15BullBoxes)
        if close < array.get(fvg15BullBots, k)
            bx = array.get(fvg15BullBoxes, k)
            if not na(bx)
                box.delete(bx)
            array.remove(fvg15BullBoxes, k)
            array.remove(fvg15BullTops, k)
            array.remove(fvg15BullBots, k)
        k := k - 1
    k := array.size(fvg15BearBoxes) - 1
    while k >= 0 and array.size(fvg15BearBoxes) > 0 and k < array.size(fvg15BearBoxes)
        if close > array.get(fvg15BearTops, k)
            bx = array.get(fvg15BearBoxes, k)
            if not na(bx)
                box.delete(bx)
            array.remove(fvg15BearBoxes, k)
            array.remove(fvg15BearTops, k)
            array.remove(fvg15BearBots, k)
        k := k - 1
    k := array.size(fvg30BullBoxes) - 1
    while k >= 0 and array.size(fvg30BullBoxes) > 0 and k < array.size(fvg30BullBoxes)
        if close < array.get(fvg30BullBots, k)
            bx = array.get(fvg30BullBoxes, k)
            if not na(bx)
                box.delete(bx)
            array.remove(fvg30BullBoxes, k)
            array.remove(fvg30BullTops, k)
            array.remove(fvg30BullBots, k)
        k := k - 1
    k := array.size(fvg30BearBoxes) - 1
    while k >= 0 and array.size(fvg30BearBoxes) > 0 and k < array.size(fvg30BearBoxes)
        if close > array.get(fvg30BearTops, k)
            bx = array.get(fvg30BearBoxes, k)
            if not na(bx)
                box.delete(bx)
            array.remove(fvg30BearBoxes, k)
            array.remove(fvg30BearTops, k)
            array.remove(fvg30BearBots, k)
        k := k - 1

while array.size(bullFvgB) > maxActiveFvgs
    bx = array.shift(bullFvgB)
    if not na(bx)
        box.delete(bx)
    array.shift(bullFvgT)
    array.shift(bullFvgBo)
    array.shift(bullFvgBr)
while array.size(bearFvgB) > maxActiveFvgs
    bx = array.shift(bearFvgB)
    if not na(bx)
        box.delete(bx)
    array.shift(bearFvgT)
    array.shift(bearFvgBo)
    array.shift(bearFvgBr)
while array.size(fvg15BullBoxes) > maxActiveFvgs
    bx = array.shift(fvg15BullBoxes)
    if not na(bx)
        box.delete(bx)
    array.shift(fvg15BullTops)
    array.shift(fvg15BullBots)
while array.size(fvg15BearBoxes) > maxActiveFvgs
    bx = array.shift(fvg15BearBoxes)
    if not na(bx)
        box.delete(bx)
    array.shift(fvg15BearTops)
    array.shift(fvg15BearBots)
while array.size(fvg30BullBoxes) > maxActiveFvgs
    bx = array.shift(fvg30BullBoxes)
    if not na(bx)
        box.delete(bx)
    array.shift(fvg30BullTops)
    array.shift(fvg30BullBots)
while array.size(fvg30BearBoxes) > maxActiveFvgs
    bx = array.shift(fvg30BearBoxes)
    if not na(bx)
        box.delete(bx)
    array.shift(fvg30BearTops)
    array.shift(fvg30BearBots)

if showFvg5 and array.size(bullFvgB) > 0
    for i = 0 to array.size(bullFvgB) - 1
        bx = array.get(bullFvgB, i)
        if not na(bx)
            box.set_right(bx, bar_index)
if showFvg5 and array.size(bearFvgB) > 0
    for i = 0 to array.size(bearFvgB) - 1
        bx = array.get(bearFvgB, i)
        if not na(bx)
            box.set_right(bx, bar_index)
if showFvg15 and array.size(fvg15BullBoxes) > 0
    for i = 0 to array.size(fvg15BullBoxes) - 1
        bx = array.get(fvg15BullBoxes, i)
        if not na(bx)
            box.set_right(bx, bar_index)
if showFvg15 and array.size(fvg15BearBoxes) > 0
    for i = 0 to array.size(fvg15BearBoxes) - 1
        bx = array.get(fvg15BearBoxes, i)
        if not na(bx)
            box.set_right(bx, bar_index)
if showFvg30 and array.size(fvg30BullBoxes) > 0
    for i = 0 to array.size(fvg30BullBoxes) - 1
        bx = array.get(fvg30BullBoxes, i)
        if not na(bx)
            box.set_right(bx, bar_index)
if showFvg30 and array.size(fvg30BearBoxes) > 0
    for i = 0 to array.size(fvg30BearBoxes) - 1
        bx = array.get(fvg30BearBoxes, i)
        if not na(bx)
            box.set_right(bx, bar_index)

// =============================================================================
// ORDER BLOCKS
// =============================================================================
var array<box>   bullObB  = array.new<box>()
var array<float> bullObT  = array.new_float()
var array<float> bullObBo = array.new_float()
var array<int>   bullObBr = array.new_int()
var array<box>   bearObB  = array.new<box>()
var array<float> bearObT  = array.new_float()
var array<float> bearObBo = array.new_float()
var array<int>   bearObBr = array.new_int()

bullishMove = close > open and (close - open) > atr14 * obMinMoveAtr
bearishMove = close < open and (open - close) > atr14 * obMinMoveAtr

if bullishMove and close[1] < open[1]
    nb = showOb ? box.new(bar_index - 1, high[1], bar_index + 10, low[1], bgcolor = color.new(#1abc9c, 78), border_color = color.new(#1abc9c, 30), text = "OB", text_size = size.tiny, text_color = color.new(#1abc9c, 0)) : na
    array.push(bullObB, nb)
    array.push(bullObT, high[1])
    array.push(bullObBo, low[1])
    array.push(bullObBr, bar_index - 1)

if bearishMove and close[1] > open[1]
    nb = showOb ? box.new(bar_index - 1, high[1], bar_index + 10, low[1], bgcolor = color.new(#e74c3c, 78), border_color = color.new(#e74c3c, 30), text = "OB", text_size = size.tiny, text_color = color.new(#e74c3c, 0)) : na
    array.push(bearObB, nb)
    array.push(bearObT, high[1])
    array.push(bearObBo, low[1])
    array.push(bearObBr, bar_index - 1)

k3 = array.size(bullObB) - 1
while k3 >= 0 and array.size(bullObB) > 0 and k3 < array.size(bullObB)
    if close < array.get(bullObBo, k3)
        bx = array.get(bullObB, k3)
        if not na(bx)
            box.delete(bx)
        array.remove(bullObB, k3)
        array.remove(bullObT, k3)
        array.remove(bullObBo, k3)
        array.remove(bullObBr, k3)
    k3 := k3 - 1

k4 = array.size(bearObB) - 1
while k4 >= 0 and array.size(bearObB) > 0 and k4 < array.size(bearObB)
    if close > array.get(bearObT, k4)
        bx = array.get(bearObB, k4)
        if not na(bx)
            box.delete(bx)
        array.remove(bearObB, k4)
        array.remove(bearObT, k4)
        array.remove(bearObBo, k4)
        array.remove(bearObBr, k4)
    k4 := k4 - 1

while array.size(bullObB) > maxActiveObs
    bx = array.shift(bullObB)
    if not na(bx)
        box.delete(bx)
    array.shift(bullObT)
    array.shift(bullObBo)
    array.shift(bullObBr)
while array.size(bearObB) > maxActiveObs
    bx = array.shift(bearObB)
    if not na(bx)
        box.delete(bx)
    array.shift(bearObT)
    array.shift(bearObBo)
    array.shift(bearObBr)

if showOb and array.size(bullObB) > 0
    for i = 0 to array.size(bullObB) - 1
        bx = array.get(bullObB, i)
        if not na(bx)
            box.set_right(bx, bar_index + 5)
if showOb and array.size(bearObB) > 0
    for i = 0 to array.size(bearObB) - 1
        bx = array.get(bearObB, i)
        if not na(bx)
            box.set_right(bx, bar_index + 5)

// =============================================================================
// SWEEP DETECTION — binary
// =============================================================================
var bool sweptLong = false
var bool sweptShort = false
var int  sweepLongBar = na
var int  sweepShortBar = na
var float sweptLongLevel = na
var float sweptShortLevel = na
var string sweptLongSrc = ""
var string sweptShortSrc = ""
var line sweepLowLine  = na
var line sweepHighLine = na
var label sweepLowLbl  = na
var label sweepHighLbl = na
// v9.18: persistent line+label for London H/L sweeps (matches Asia rendering)
var line  londonHighSweepLine = na
var line  londonLowSweepLine  = na
var label londonHighSweepLbl  = na
var label londonLowSweepLbl   = na

if asiaStarted
    sweptLong := false
    sweptShort := false
    sweepLongBar := na
    sweepShortBar := na
    sweptLongLevel := na
    sweptShortLevel := na
    sweptLongSrc := ""
    sweptShortSrc := ""
    if not na(sweepLowLine)
        line.delete(sweepLowLine)
        sweepLowLine := na
    if not na(sweepHighLine)
        line.delete(sweepHighLine)
        sweepHighLine := na
    if not na(sweepLowLbl)
        label.delete(sweepLowLbl)
        sweepLowLbl := na
    if not na(sweepHighLbl)
        label.delete(sweepHighLbl)
        sweepHighLbl := na
    // v9.18: also reset London sweep visuals at new session start
    if not na(londonHighSweepLine)
        line.delete(londonHighSweepLine)
        londonHighSweepLine := na
    if not na(londonLowSweepLine)
        line.delete(londonLowSweepLine)
        londonLowSweepLine := na
    if not na(londonHighSweepLbl)
        label.delete(londonHighSweepLbl)
        londonHighSweepLbl := na
    if not na(londonLowSweepLbl)
        label.delete(londonLowSweepLbl)
        londonLowSweepLbl := na

canDetectSweep = not inAsia and not na(asiaEndBar) and bar_index > asiaEndBar

isSweepLow(level, i) =>
    valid = false
    if not na(level)
        wickBelow = low[i] < level
        if requireCloseBack
            closeBack = close[i] > level
            valid := wickBelow and closeBack
        else
            valid := wickBelow
    valid

isSweepHigh(level, i) =>
    valid = false
    if not na(level)
        wickAbove = high[i] > level
        if requireCloseBack
            closeBack = close[i] < level
            valid := wickAbove and closeBack
        else
            valid := wickAbove
    valid

if canDetectSweep and not sweptLong
    foundI = -1
    foundLevel = 0.0
    foundSrc = ""
    maxI = math.min(sweepLookback, bar_index - asiaEndBar)
    for i = 0 to maxI
        if foundI < 0 and bar_index - i > asiaEndBar
            if sweepAsia and not na(asiaLow) and isSweepLow(asiaLow, i)
                foundI := i
                foundLevel := asiaLow
                foundSrc := "AL"
            if foundI < 0 and sweepPDHPDL and not na(pdl) and isSweepLow(pdl, i)
                foundI := i
                foundLevel := pdl
                foundSrc := "PDL"
            if foundI < 0 and sweepPWHPWL and not na(pwl) and isSweepLow(pwl, i)
                foundI := i
                foundLevel := pwl
                foundSrc := "PWL"
    if foundI >= 0
        sweptLong := true
        sweepLongBar := bar_index - foundI
        sweptLongLevel := foundLevel
        sweptLongSrc := foundSrc
        if showSweepLines
            sweepLowLine := line.new(sweepLongBar, foundLevel, bar_index, foundLevel, color = sweepLineColor, width = 2)
            sweepLowLbl := label.new(bar_index, foundLevel, "Sweep " + foundSrc, color = color.new(color.black, 100), textcolor = sweepLineColor, style = label.style_label_left, size = size.small)

if canDetectSweep and not sweptShort
    foundI = -1
    foundLevel = 0.0
    foundSrc = ""
    maxI = math.min(sweepLookback, bar_index - asiaEndBar)
    for i = 0 to maxI
        if foundI < 0 and bar_index - i > asiaEndBar
            if sweepAsia and not na(asiaHigh) and isSweepHigh(asiaHigh, i)
                foundI := i
                foundLevel := asiaHigh
                foundSrc := "AH"
            if foundI < 0 and sweepPDHPDL and not na(pdh) and isSweepHigh(pdh, i)
                foundI := i
                foundLevel := pdh
                foundSrc := "PDH"
            if foundI < 0 and sweepPWHPWL and not na(pwh) and isSweepHigh(pwh, i)
                foundI := i
                foundLevel := pwh
                foundSrc := "PWH"
    if foundI >= 0
        sweptShort := true
        sweepShortBar := bar_index - foundI
        sweptShortLevel := foundLevel
        sweptShortSrc := foundSrc
        if showSweepLines
            sweepHighLine := line.new(sweepShortBar, foundLevel, bar_index, foundLevel, color = sweepLineColor, width = 2)
            sweepHighLbl := label.new(bar_index, foundLevel, "Sweep " + foundSrc, color = color.new(color.black, 100), textcolor = sweepLineColor, style = label.style_label_left, size = size.small)

if not na(sweepLowLine)
    line.set_x2(sweepLowLine, bar_index)
    if not na(sweepLowLbl)
        label.set_x(sweepLowLbl, bar_index)
        label.set_y(sweepLowLbl, sweptLongLevel)
if not na(sweepHighLine)
    line.set_x2(sweepHighLine, bar_index)
    if not na(sweepHighLbl)
        label.set_x(sweepHighLbl, bar_index)
        label.set_y(sweepHighLbl, sweptShortLevel)

// =============================================================================
// PD TOUCH
// =============================================================================
touchedBullPd() =>
    touched = false
    if not na(sweepLongBar)
        szF = array.size(bullFvgT)
        if szF > 0
            sI = szF - 1
            eI = math.max(0, szF - maxPdZones)
            for i = sI to eI
                if i >= 0 and i < array.size(bullFvgT) and not touched
                    tF = array.get(bullFvgT, i)
                    bF = array.get(bullFvgBo, i)
                    barsBack = math.min(pdTouchWindow, bar_index - sweepLongBar)
                    for b = 0 to barsBack + 3
                        if b < bar_index and b >= 0 and low[b] <= tF and low[b] >= bF
                            touched := true
                            break
        if not touched
            szO = array.size(bullObT)
            if szO > 0
                sI = szO - 1
                eI = math.max(0, szO - maxPdZones)
                for i = sI to eI
                    if i >= 0 and i < array.size(bullObT) and not touched
                        tO = array.get(bullObT, i)
                        bO = array.get(bullObBo, i)
                        barsBack = math.min(pdTouchWindow, bar_index - sweepLongBar)
                        for b = 0 to barsBack + 3
                            if b < bar_index and b >= 0 and low[b] <= tO and low[b] >= bO
                                touched := true
                                break
    touched

touchedBearPd() =>
    touched = false
    if not na(sweepShortBar)
        szF = array.size(bearFvgT)
        if szF > 0
            sI = szF - 1
            eI = math.max(0, szF - maxPdZones)
            for i = sI to eI
                if i >= 0 and i < array.size(bearFvgT) and not touched
                    tF = array.get(bearFvgT, i)
                    bF = array.get(bearFvgBo, i)
                    barsBack = math.min(pdTouchWindow, bar_index - sweepShortBar)
                    for b = 0 to barsBack + 3
                        if b < bar_index and b >= 0 and high[b] >= bF and high[b] <= tF
                            touched := true
                            break
        if not touched
            szO = array.size(bearObT)
            if szO > 0
                sI = szO - 1
                eI = math.max(0, szO - maxPdZones)
                for i = sI to eI
                    if i >= 0 and i < array.size(bearObT) and not touched
                        tO = array.get(bearObT, i)
                        bO = array.get(bearObBo, i)
                        barsBack = math.min(pdTouchWindow, bar_index - sweepShortBar)
                        for b = 0 to barsBack + 3
                            if b < bar_index and b >= 0 and high[b] >= bO and high[b] <= tO
                                touched := true
                                break
    touched

bullPdTouched = touchedBullPd()
bearPdTouched = touchedBearPd()

// =============================================================================
// NY-SPECIFIC PD TOUCH (v9.9 Fix #1)
// Mirrors London touchedBullPd/touchedBearPd but gates on NY sweep bars.
// Forward-declared placeholders here — actual sweep bars set in NY engine.
// We re-evaluate AFTER NY sweep state is set.
// =============================================================================
// [v9.21 removed] nySweepLongBarRef was declared but never used
// [v9.21 removed] nySweepShortBarRef was declared but never used

touchedBullPdNy(int sweepBar) =>
    touched = false
    if not na(sweepBar)
        szF = array.size(bullFvgT)
        if szF > 0
            sI = szF - 1
            eI = math.max(0, szF - maxPdZones)
            for i = sI to eI
                if i >= 0 and i < array.size(bullFvgT) and not touched
                    tF = array.get(bullFvgT, i)
                    bF = array.get(bullFvgBo, i)
                    barsBack = math.min(pdTouchWindow, bar_index - sweepBar)
                    for b = 0 to barsBack + 3
                        if b < bar_index and b >= 0 and low[b] <= tF and low[b] >= bF
                            touched := true
                            break
        if not touched
            szO = array.size(bullObT)
            if szO > 0
                sI = szO - 1
                eI = math.max(0, szO - maxPdZones)
                for i = sI to eI
                    if i >= 0 and i < array.size(bullObT) and not touched
                        tO = array.get(bullObT, i)
                        bO = array.get(bullObBo, i)
                        barsBack = math.min(pdTouchWindow, bar_index - sweepBar)
                        for b = 0 to barsBack + 3
                            if b < bar_index and b >= 0 and low[b] <= tO and low[b] >= bO
                                touched := true
                                break
    touched

touchedBearPdNy(int sweepBar) =>
    touched = false
    if not na(sweepBar)
        szF = array.size(bearFvgT)
        if szF > 0
            sI = szF - 1
            eI = math.max(0, szF - maxPdZones)
            for i = sI to eI
                if i >= 0 and i < array.size(bearFvgT) and not touched
                    tF = array.get(bearFvgT, i)
                    bF = array.get(bearFvgBo, i)
                    barsBack = math.min(pdTouchWindow, bar_index - sweepBar)
                    for b = 0 to barsBack + 3
                        if b < bar_index and b >= 0 and high[b] >= bF and high[b] <= tF
                            touched := true
                            break
        if not touched
            szO = array.size(bearObT)
            if szO > 0
                sI = szO - 1
                eI = math.max(0, szO - maxPdZones)
                for i = sI to eI
                    if i >= 0 and i < array.size(bearObT) and not touched
                        tO = array.get(bearObT, i)
                        bO = array.get(bearObBo, i)
                        barsBack = math.min(pdTouchWindow, bar_index - sweepBar)
                        for b = 0 to barsBack + 3
                            if b < bar_index and b >= 0 and high[b] >= bO and high[b] <= tO
                                touched := true
                                break
    touched

// =============================================================================
// STRONG ENGULFING + LOW-VOL FILTER (uses Logic TF — see v9.7 eff* vars)
// =============================================================================
// Logic TF candle math (drives the main engine — 5m by default)
candleRange = effHigh - effLow
bullBody = effClose > effOpen ? effClose - effOpen : 0.0
bearBody = effClose < effOpen ? effOpen - effClose : 0.0
bullBodyPct = candleRange > 0 ? bullBody / candleRange : 0.0
bearBodyPct = candleRange > 0 ? bearBody / candleRange : 0.0

strongBullBody = effClose > effOpen and bullBodyPct >= minBodyRatio
strongBearBody = effClose < effOpen and bearBodyPct >= minBodyRatio

formalBullEng = effClose > effOpen and effClose[1] < effOpen[1] and effClose >= effOpen[1] and effOpen <= effClose[1]
formalBearEng = effClose < effOpen and effClose[1] > effOpen[1] and effClose <= effOpen[1] and effOpen >= effClose[1]

strongBullCandle = requireEngulf ? (strongBullBody and formalBullEng) : strongBullBody
strongBearCandle = requireEngulf ? (strongBearBody and formalBearEng) : strongBearBody

candleRangeOK = candleRange >= effAtr * minCandleAtr
avgBodyOK = effBody5 >= effAtr * minAvgBodyAtr
volRatioOK = effVolMult >= minVolRatio
lowVolPass = not enableLowVolFilter or (candleRangeOK and avgBodyOK and volRatioOK)

// v9.2: Volume confirmation — engulf candle needs above-avg volume
volConfirmPass = not enableVolConfirm or effVolMult >= volConfirmMult

pathLong  = strongBullCandle and newBullFvg ? "A+FVG" : strongBullCandle ? "B" : ""
pathShort = strongBearCandle and newBearFvg ? "A+FVG" : strongBearCandle ? "B" : ""

candleValidLong  = strongBullCandle and lowVolPass and volConfirmPass
candleValidShort = strongBearCandle and lowVolPass and volConfirmPass

// =============================================================================
// SETUP LIFESPAN
// =============================================================================
getSetupAlive(sweptFlag, sweepBar) =>
    alive = false
    if sweptFlag and not na(sweepBar)
        if useFullLondonWindow
            alive := inLondonExt
    alive

longSetupAlive  = getSetupAlive(sweptLong, sweepLongBar)
shortSetupAlive = getSetupAlive(sweptShort, sweepShortBar)

distanceOKLong  = na(sweptLongLevel)  ? false : math.abs(close - sweptLongLevel)  <= atr14 * maxDistanceAtr
distanceOKShort = na(sweptShortLevel) ? false : math.abs(close - sweptShortLevel) <= atr14 * maxDistanceAtr

// =============================================================================
// NEW TP ENGINE — Smart nearest-level logic
// =============================================================================
// Builds a list of ALL candidate TP levels in trade direction, tagged with source.
// Then picks the NEAREST level that gives ≥ minRR and ≤ maxRR.
// Supports configurable FVG/OB placement (near/middle/far side).
// =============================================================================

// Helper: get placement-adjusted level from a zone
getZonePlacement(zoneTop, zoneBot, isLong) =>
    // For LONG, we target UP — want to exit NEAR the near side (bottom of bear zone above) or FAR side (top of bear zone)
    // For SHORT, we target DOWN — near side is top, far side is bottom
    result = 0.0
    if fvgObPlacement == "Near side (conservative)"
        result := isLong ? zoneBot : zoneTop
    else if fvgObPlacement == "Middle (balanced)"
        result := (zoneTop + zoneBot) / 2.0
    else
        result := isLong ? zoneTop : zoneBot
    result

// Build candidate TP list for LONG (levels ABOVE entry)
// Returns arrays of [levels, sources] sorted by distance from entry
buildLongCandidates(entry) =>
    levels = array.new_float()
    sources = array.new_string()
    // 5m bear FVGs (above entry = gap to fill going up)
    if useFvg5TP
        sz = array.size(bearFvgT)
        if sz > 0
            for i = 0 to sz - 1
                t = array.get(bearFvgT, i)
                b = array.get(bearFvgBo, i)
                if not na(t) and not na(b)
                    placed = getZonePlacement(t, b, true)
                    if placed > entry
                        array.push(levels, placed)
                        array.push(sources, "FVG5")
    // 15m bear FVGs
    if useFvg15TP
        sz = array.size(fvg15BearTops)
        if sz > 0
            for i = 0 to sz - 1
                t = array.get(fvg15BearTops, i)
                b = array.get(fvg15BearBots, i)
                if not na(t) and not na(b)
                    placed = getZonePlacement(t, b, true)
                    if placed > entry
                        array.push(levels, placed)
                        array.push(sources, "FVG15")
    // 30m bear FVGs
    if useFvg30TP
        sz = array.size(fvg30BearTops)
        if sz > 0
            for i = 0 to sz - 1
                t = array.get(fvg30BearTops, i)
                b = array.get(fvg30BearBots, i)
                if not na(t) and not na(b)
                    placed = getZonePlacement(t, b, true)
                    if placed > entry
                        array.push(levels, placed)
                        array.push(sources, "FVG30")
    // OBs (bear OBs above entry act as resistance)
    if useObTP
        sz = array.size(bearObT)
        if sz > 0
            for i = 0 to sz - 1
                t = array.get(bearObT, i)
                b = array.get(bearObBo, i)
                if not na(t) and not na(b)
                    placed = getZonePlacement(t, b, true)
                    if placed > entry
                        array.push(levels, placed)
                        array.push(sources, "OB")
    // Asia H/L
    if useAsiaTP and not na(asiaHigh) and asiaHigh > entry
        array.push(levels, asiaHigh - tpBuffer * syminfo.mintick)
        array.push(sources, "AsiaH")
    if useAsiaTP and not na(asiaLow) and asiaLow > entry
        array.push(levels, asiaLow - tpBuffer * syminfo.mintick)
        array.push(sources, "AsiaL")
    // PDH/PDL
    if usePDHPDLTP and not na(pdh) and pdh > entry
        array.push(levels, pdh - tpBuffer * syminfo.mintick)
        array.push(sources, "PDH")
    if usePDHPDLTP and not na(pdl) and pdl > entry
        array.push(levels, pdl - tpBuffer * syminfo.mintick)
        array.push(sources, "PDL")
    // Swing H/L
    if useWeakSwingTP and not na(weakHigh) and weakHigh > entry
        array.push(levels, weakHigh - tpBuffer * syminfo.mintick)
        array.push(sources, "WeakH")
    if useIntSwingTP and not na(intHigh) and intHigh > entry
        array.push(levels, intHigh - tpBuffer * syminfo.mintick)
        array.push(sources, "IntH")
    if useStrongSwingTP and not na(strongHigh) and strongHigh > entry
        array.push(levels, strongHigh - tpBuffer * syminfo.mintick)
        array.push(sources, "StrongH")
    [levels, sources]

buildShortCandidates(entry) =>
    levels = array.new_float()
    sources = array.new_string()
    if useFvg5TP
        sz = array.size(bullFvgT)
        if sz > 0
            for i = 0 to sz - 1
                t = array.get(bullFvgT, i)
                b = array.get(bullFvgBo, i)
                if not na(t) and not na(b)
                    placed = getZonePlacement(t, b, false)
                    if placed < entry
                        array.push(levels, placed)
                        array.push(sources, "FVG5")
    if useFvg15TP
        sz = array.size(fvg15BullTops)
        if sz > 0
            for i = 0 to sz - 1
                t = array.get(fvg15BullTops, i)
                b = array.get(fvg15BullBots, i)
                if not na(t) and not na(b)
                    placed = getZonePlacement(b, t, false)
                    if placed < entry
                        array.push(levels, placed)
                        array.push(sources, "FVG15")
    if useFvg30TP
        sz = array.size(fvg30BullTops)
        if sz > 0
            for i = 0 to sz - 1
                t = array.get(fvg30BullTops, i)
                b = array.get(fvg30BullBots, i)
                if not na(t) and not na(b)
                    placed = getZonePlacement(b, t, false)
                    if placed < entry
                        array.push(levels, placed)
                        array.push(sources, "FVG30")
    if useObTP
        sz = array.size(bullObT)
        if sz > 0
            for i = 0 to sz - 1
                t = array.get(bullObT, i)
                b = array.get(bullObBo, i)
                if not na(t) and not na(b)
                    placed = getZonePlacement(t, b, false)
                    if placed < entry
                        array.push(levels, placed)
                        array.push(sources, "OB")
    if useAsiaTP and not na(asiaHigh) and asiaHigh < entry
        array.push(levels, asiaHigh + tpBuffer * syminfo.mintick)
        array.push(sources, "AsiaH")
    if useAsiaTP and not na(asiaLow) and asiaLow < entry
        array.push(levels, asiaLow + tpBuffer * syminfo.mintick)
        array.push(sources, "AsiaL")
    if usePDHPDLTP and not na(pdh) and pdh < entry
        array.push(levels, pdh + tpBuffer * syminfo.mintick)
        array.push(sources, "PDH")
    if usePDHPDLTP and not na(pdl) and pdl < entry
        array.push(levels, pdl + tpBuffer * syminfo.mintick)
        array.push(sources, "PDL")
    if useWeakSwingTP and not na(weakLow) and weakLow < entry
        array.push(levels, weakLow + tpBuffer * syminfo.mintick)
        array.push(sources, "WeakL")
    if useIntSwingTP and not na(intLow) and intLow < entry
        array.push(levels, intLow + tpBuffer * syminfo.mintick)
        array.push(sources, "IntL")
    if useStrongSwingTP and not na(strongLow) and strongLow < entry
        array.push(levels, strongLow + tpBuffer * syminfo.mintick)
        array.push(sources, "StrongL")
    [levels, sources]

// Pick best TP for LONG: NEAREST level that gives ≥ minRR, capped at ≤ maxRR
// If nothing qualifies with nearest, find nearest that gives ≥ minRR (even if > maxRR we cap at maxRR)
pickLongTP(entry, slP) =>
    riskD = entry - slP
    minTgt = entry + riskD * minRR
    maxTgt = entry + riskD * maxRR
    [levels, sources] = buildLongCandidates(entry)
    float bestTp = na
    string bestSrc = ""
    // Pass 1: find NEAREST valid level in [minTgt, maxTgt] window
    sz = array.size(levels)
    if sz > 0
        bestDist = 999999.0
        for i = 0 to sz - 1
            lvl = array.get(levels, i)
            if lvl >= minTgt and lvl <= maxTgt
                d = lvl - entry
                if d < bestDist
                    bestDist := d
                    bestTp := lvl
                    bestSrc := array.get(sources, i)
    // Pass 2: if none in window, find NEAREST level ≥ minTgt (then cap at maxTgt)
    if na(bestTp) and sz > 0
        bestDist = 999999.0
        for i = 0 to sz - 1
            lvl = array.get(levels, i)
            if lvl >= minTgt
                d = lvl - entry
                if d < bestDist
                    bestDist := d
                    bestTp := math.min(lvl, maxTgt)
                    bestSrc := array.get(sources, i)
    [bestTp, bestSrc]

pickShortTP(entry, slP) =>
    riskD = slP - entry
    minTgt = entry - riskD * minRR
    maxTgt = entry - riskD * maxRR
    [levels, sources] = buildShortCandidates(entry)
    float bestTp = na
    string bestSrc = ""
    sz = array.size(levels)
    if sz > 0
        bestDist = 999999.0
        for i = 0 to sz - 1
            lvl = array.get(levels, i)
            if lvl <= minTgt and lvl >= maxTgt
                d = entry - lvl
                if d < bestDist
                    bestDist := d
                    bestTp := lvl
                    bestSrc := array.get(sources, i)
    if na(bestTp) and sz > 0
        bestDist = 999999.0
        for i = 0 to sz - 1
            lvl = array.get(levels, i)
            if lvl <= minTgt
                d = entry - lvl
                if d < bestDist
                    bestDist := d
                    bestTp := math.max(lvl, maxTgt)
                    bestSrc := array.get(sources, i)
    [bestTp, bestSrc]

// =============================================================================
// MANIPULATION TRACKING
// =============================================================================
var int longEngulfState = 0
var float longFirstEngulfHigh = na
var float longFirstEngulfLow = na
var int longFirstEngulfBar = na
// [v9.21 removed] longFirstEntry was assigned but never read
var float longFirstSL = na
var box longManipBox = na

var int shortEngulfState = 0
var float shortFirstEngulfHigh = na
var float shortFirstEngulfLow = na
var int shortFirstEngulfBar = na
// [v9.21 removed] shortFirstEntry was assigned but never read
var float shortFirstSL = na
var box shortManipBox = na

if londonStarted
    longEngulfState := 0
    shortEngulfState := 0
    longFirstEngulfHigh := na
    longFirstEngulfLow := na
    longFirstEngulfBar := na
    // [v9.21 removed] dead assignment
    longFirstSL := na
    shortFirstEngulfHigh := na
    shortFirstEngulfLow := na
    shortFirstEngulfBar := na
    // [v9.21 removed] dead assignment
    shortFirstSL := na
    if not na(longManipBox)
        box.delete(longManipBox)
        longManipBox := na
    if not na(shortManipBox)
        box.delete(shortManipBox)
        shortManipBox := na

londonAutoUse2nd = manipMode == "Auto (smart decide based on conditions)" and (asiaRangeSize > effAtr * londonAutoVolThreshold or asiaTooWide or asiaHuge)
londonAutoUse1st = manipMode == "Auto (smart decide based on conditions)" and not londonAutoUse2nd
modeFirstOnly = manipMode == "1st Entry Only (aggressive)" or londonAutoUse1st
modeSecondOnly = manipMode == "2nd Entry Only (safer, wait for stop-hunt)" or londonAutoUse2nd
modeBoth = manipMode == "Both (1st + 2nd)"

if longEngulfState == 1 and not na(longFirstSL)
    if low < longFirstSL - atr14 * manipWickAtr
        longEngulfState := 2
        if showManipBoxes
            longManipBox := box.new(longFirstEngulfBar, longFirstEngulfLow, bar_index, low, bgcolor = manipBoxColor, border_color = color.new(#ff9800, 30), text = "Manipulation", text_size = size.tiny, text_color = color.new(#ff9800, 0))

if shortEngulfState == 1 and not na(shortFirstSL)
    if high > shortFirstSL + atr14 * manipWickAtr
        shortEngulfState := 2
        if showManipBoxes
            shortManipBox := box.new(shortFirstEngulfBar, shortFirstEngulfHigh, bar_index, high, bgcolor = manipBoxColor, border_color = color.new(#ff9800, 30), text = "Manipulation", text_size = size.tiny, text_color = color.new(#ff9800, 0))

if not na(longManipBox)
    box.set_right(longManipBox, bar_index)
if not na(shortManipBox)
    box.set_right(shortManipBox, bar_index)

// =============================================================================
// SIGNAL LOGIC
// =============================================================================
var bool longTakenThisSession  = false
var bool shortTakenThisSession = false
var int  signalsThisSession    = 0

// v9.8: NY session counters (independent from London)
var bool nyLongTaken  = false
var bool nyShortTaken = false
var bool nyT2LongTaken  = false
var bool nyT2ShortTaken = false
var int  nySignalsThisSession = 0

// v9.10: NY manipulation state machine (mirrors London)
var int   nyLongEngulfState   = 0     // 0=idle, 1=1st engulf detected, 2=manip armed (2nd entry ready)
var int   nyShortEngulfState  = 0
var float nyLongFirstEngulfHigh = na  // engulf candle high (for SL ref)
var float nyLongFirstEngulfLow  = na  // engulf candle low (manip pierces this)
var int   nyLongFirstEngulfBar  = na
var float nyShortFirstEngulfHigh = na
var float nyShortFirstEngulfLow  = na
var int   nyShortFirstEngulfBar  = na

// Track Asia-already-swept-this-day flag (used by Model A + Asia fallback)
var bool asiaHighSweptToday = false
var bool asiaLowSweptToday = false
// v9.11: Track London H/L swept-today flags (parallel to Asia tracking)
var bool londonHighSweptToday = false
var bool londonLowSweptToday = false
// v9.11: Bar index of when each level was first swept today (for distance gates)
var int  ahSweptBar = na
var int  alSweptBar = na
var int  lhSweptBar = na
var int  llSweptBar = na

if asiaStarted
    longTakenThisSession  := false
    shortTakenThisSession := false
    signalsThisSession    := 0
    asiaHighSweptToday := false
    asiaLowSweptToday := false
    londonHighSweptToday := false
    londonLowSweptToday := false
    ahSweptBar := na
    alSweptBar := na
    lhSweptBar := na
    llSweptBar := na
    // 🔴 v9.20 CRITICAL BUG FIX — clear stale session H/L from yesterday
    // Without this reset, yesterday's londonHigh/londonLow stay in memory
    // until next London opens (~16h later), causing the sweep detector to
    // fire on yesterday's stale level during Asia/pre-London, which then
    // makes NY engine think today's London was swept.
    londonHigh := na
    londonLow  := na
    asiaHigh   := na
    asiaLow    := na
    londonEndBar := na

// Update Asia-swept-today flags as soon as a sweep is detected (any session)
if sweptShort and sweptShortSrc == "AH" and not asiaHighSweptToday
    asiaHighSweptToday := true
    ahSweptBar := bar_index
if sweptLong and sweptLongSrc == "AL" and not asiaLowSweptToday
    asiaLowSweptToday := true
    alSweptBar := bar_index

// v9.18 REWRITE: London H/L sweep detection now mirrors Asia exactly.
// Detection only fires AFTER London session has ended (londonEndBar is set),
// using the same isSweepHigh/isSweepLow predicates and requireCloseBack rule
// that Asia uses. This eliminates false positives from live londonHigh updates
// during the London session itself.
canDetectLondonSweep = sweepLondon and not inLondon and not na(londonEndBar) and bar_index > londonEndBar

// London LOW sweep (Sweep LL) — price wicks below londonLow and closes back above
if canDetectLondonSweep and not londonLowSweptToday and not na(londonLow)
    foundI = -1
    maxI = math.min(sweepLookback, bar_index - londonEndBar)
    for i = 0 to maxI
        if foundI < 0 and bar_index - i > londonEndBar and isSweepLow(londonLow, i)
            foundI := i
    if foundI >= 0
        londonLowSweptToday := true
        llSweptBar := bar_index - foundI
        if showSweepLines
            londonLowSweepLine := line.new(llSweptBar, londonLow, bar_index, londonLow, color = sweepColorLondon, width = 2)
            londonLowSweepLbl  := label.new(bar_index, londonLow, "Sweep LL", color = color.new(color.black, 100), textcolor = sweepColorLondon, style = label.style_label_left, size = size.small)

// London HIGH sweep (Sweep LH) — price wicks above londonHigh and closes back below
if canDetectLondonSweep and not londonHighSweptToday and not na(londonHigh)
    foundI = -1
    maxI = math.min(sweepLookback, bar_index - londonEndBar)
    for i = 0 to maxI
        if foundI < 0 and bar_index - i > londonEndBar and isSweepHigh(londonHigh, i)
            foundI := i
    if foundI >= 0
        londonHighSweptToday := true
        lhSweptBar := bar_index - foundI
        if showSweepLines
            londonHighSweepLine := line.new(lhSweptBar, londonHigh, bar_index, londonHigh, color = sweepColorLondon, width = 2)
            londonHighSweepLbl  := label.new(bar_index, londonHigh, "Sweep LH", color = color.new(color.black, 100), textcolor = sweepColorLondon, style = label.style_label_left, size = size.small)

// v9.18: extend London sweep lines forward each bar (matches Asia behavior)
if not na(londonHighSweepLine)
    line.set_x2(londonHighSweepLine, bar_index)
    if not na(londonHighSweepLbl)
        label.set_x(londonHighSweepLbl, bar_index)
        label.set_y(londonHighSweepLbl, londonHigh)
if not na(londonLowSweepLine)
    line.set_x2(londonLowSweepLine, bar_index)
    if not na(londonLowSweepLbl)
        label.set_x(londonLowSweepLbl, bar_index)
        label.set_y(londonLowSweepLbl, londonLow)

// Reset NY counters at NY session start (asiaStarted is too early)
if nyStarted
    nyLongTaken := false
    nyShortTaken := false
    nyT2LongTaken := false
    nyT2ShortTaken := false
    nySignalsThisSession := 0
    // v9.10: reset NY manip state machine
    nyLongEngulfState := 0
    nyShortEngulfState := 0
    nyLongFirstEngulfHigh := na
    nyLongFirstEngulfLow := na
    nyLongFirstEngulfBar := na
    nyShortFirstEngulfHigh := na
    nyShortFirstEngulfLow := na
    nyShortFirstEngulfBar := na

// NY tick block check — looks at LONDON range, not NY range, since
// London is the daily volatility quota indicator
londonRangeSize = not na(londonHigh) and not na(londonLow) ? londonHigh - londonLow : 0.0
londonRangeTicks = londonRangeSize / syminfo.mintick
nyTicksBlock = blockNyIfLondonHuge and londonRangeTicks > maxNyTicks

nySessionLimitHit = nySignalsThisSession >= nyMaxSignals

sessionLimitHit = maxSignalsPerSession > 0 and signalsThisSession >= maxSignalsPerSession

// v9.3: Directional Sweep Memory Filter
asiaHighAlreadySwept = sweptShort and sweptShortSrc == "AH"
asiaLowAlreadySwept = sweptLong and sweptLongSrc == "AL"
t1LongOppositeBlock = blockT1AfterOppositeSweep and asiaHighAlreadySwept
t1ShortOppositeBlock = blockT1AfterOppositeSweep and asiaLowAlreadySwept

longBase  = enableT1 and inLondon and sweptLong  and longSetupAlive  and distanceOKLong  and bullPdTouched and candleValidLong  and finalLongOK and not t1LongOppositeBlock and not asiaTicksBlock and not (blockIfAsiaHuge and asiaHuge)
shortBase = enableT1 and inLondon and sweptShort and shortSetupAlive and distanceOKShort and bearPdTouched and candleValidShort and finalShortOK and not t1ShortOppositeBlock and not asiaTicksBlock and not (blockIfAsiaHuge and asiaHuge)

noSweepBlock = blockIfNoSweep and not sweptLong and not sweptShort

// v9.5: Smart SL Chain — 4-step fallback (engulf → swing → London → Asia)
recentSwingLow  = ta.lowest(low, slSwingLookback)
recentSwingHigh = ta.highest(high, slSwingLookback)

// Smart SL function for LONG: returns [SL_price, source_string]
// Priority: engulf low → swing low → London low → Asia low
// Each candidate must be at least (slMinAtrDist × ATR) below entry to be accepted.
smartSLLong(float entry) =>
    float sl = na
    string src = ""
    float minDist = atr14 * slMinAtrDist
    float bufTicks = slBuffer * syminfo.mintick
    // 1. Engulfing candle low (current bar's low — the candle that's about to fire)
    if slUseEngulfFirst
        candidate1 = low - bufTicks
        if not na(candidate1) and (entry - candidate1) >= minDist
            sl := candidate1
            src := "engulf"
    // 2. Swing low (8-bar lookback default)
    if na(sl)
        candidate2 = recentSwingLow - bufTicks
        if not na(candidate2) and (entry - candidate2) >= minDist
            sl := candidate2
            src := "swing"
    // 3. London low
    if na(sl) and not na(londonLow)
        candidate3 = londonLow - bufTicks
        if (entry - candidate3) >= minDist
            sl := candidate3
            src := "London"
    // 4. Asia low (last resort)
    if na(sl) and not na(asiaLow)
        candidate4 = asiaLow - bufTicks
        if (entry - candidate4) >= minDist
            sl := candidate4
            src := "Asia"
    // Absolute fallback: widest of all (avoid na SL)
    if na(sl)
        sl := math.min(low, nz(recentSwingLow, low)) - bufTicks
        src := "fallback"
    [sl, src]

// Smart SL function for SHORT — mirrored
smartSLShort(float entry) =>
    float sl = na
    string src = ""
    float minDist = atr14 * slMinAtrDist
    float bufTicks = slBuffer * syminfo.mintick
    // 1. Engulfing candle high
    if slUseEngulfFirst
        candidate1 = high + bufTicks
        if not na(candidate1) and (candidate1 - entry) >= minDist
            sl := candidate1
            src := "engulf"
    // 2. Swing high
    if na(sl)
        candidate2 = recentSwingHigh + bufTicks
        if not na(candidate2) and (candidate2 - entry) >= minDist
            sl := candidate2
            src := "swing"
    // 3. London high
    if na(sl) and not na(londonHigh)
        candidate3 = londonHigh + bufTicks
        if (candidate3 - entry) >= minDist
            sl := candidate3
            src := "London"
    // 4. Asia high (last resort)
    if na(sl) and not na(asiaHigh)
        candidate4 = asiaHigh + bufTicks
        if (candidate4 - entry) >= minDist
            sl := candidate4
            src := "Asia"
    // Absolute fallback
    if na(sl)
        sl := math.max(high, nz(recentSwingHigh, high)) + bufTicks
        src := "fallback"
    [sl, src]

// Compute T1 SLs using smart chain (entry = current close)
[longCandidateSL, longSlSrc]   = smartSLLong(close)
[shortCandidateSL, shortSlSrc] = smartSLShort(close)

// Calculate TPs using new engine
float longCandidateTP = na
string longTpSrc = ""
if longBase
    [tp, src] = pickLongTP(close, longCandidateSL)
    longCandidateTP := tp
    longTpSrc := src

float shortCandidateTP = na
string shortTpSrc = ""
if shortBase
    [tp, src] = pickShortTP(close, shortCandidateSL)
    shortCandidateTP := tp
    shortTpSrc := src

longRiskD = close - longCandidateSL
longActualRR = longRiskD > 0 and not na(longCandidateTP) ? (longCandidateTP - close) / longRiskD : 0.0
longRROK = longActualRR >= minRR

shortRiskD = shortCandidateSL - close
shortActualRR = shortRiskD > 0 and not na(shortCandidateTP) ? (close - shortCandidateTP) / shortRiskD : 0.0
shortRROK = shortActualRR >= minRR

// =============================================================================
// NY TP ENGINE (v9.9 Fix #2)
// Reuses pickLongTP / pickShortTP (direction-filtered) but computes whenever
// in NY session, regardless of London base state.
// =============================================================================
float nyLongTP = na
string nyLongTpSrc = ""
float nyShortTP = na
string nyShortTpSrc = ""
fireLong1st = false
fireLong2nd = false
fireShort1st = false
fireShort2nd = false

if longBase and longRROK
    if longEngulfState == 0
        if modeFirstOnly or modeBoth
            fireLong1st := true
        longEngulfState := 1
        longFirstEngulfHigh := high
        longFirstEngulfLow := low
        longFirstEngulfBar := bar_index
    // [v9.21 removed] dead assignment
        longFirstSL := longCandidateSL
    else if longEngulfState == 2
        if modeSecondOnly or modeBoth
            fireLong2nd := true
        longEngulfState := 3

if shortBase and shortRROK
    if shortEngulfState == 0
        if modeFirstOnly or modeBoth
            fireShort1st := true
        shortEngulfState := 1
        shortFirstEngulfHigh := high
        shortFirstEngulfLow := low
        shortFirstEngulfBar := bar_index
    // [v9.21 removed] dead assignment
        shortFirstSL := shortCandidateSL
    else if shortEngulfState == 2
        if modeSecondOnly or modeBoth
            fireShort2nd := true
        shortEngulfState := 3

if oneSignalPerSide
    if longTakenThisSession
        fireLong1st := false
        fireLong2nd := false
    if shortTakenThisSession
        fireShort1st := false
        fireShort2nd := false

// Session-wide signal limit (T1)
if sessionLimitHit
    fireLong1st  := false
    fireLong2nd  := false
    fireShort1st := false
    fireShort2nd := false

fireLong  = fireLong1st or fireLong2nd
fireShort = fireShort1st or fireShort2nd

if fireLong
    longTakenThisSession := true
    signalsThisSession   += 1
if fireShort
    shortTakenThisSession := true
    signalsThisSession    += 1

// =============================================================================
// ============================================================================
// T2 ENGINE — AMD RETRACEMENT (NEW in v8)
// ============================================================================
// T2 LONG logic (ICT AMD — Asia LOW swept):
//   1. sweptLong = Asia LOW swept (price dips below, clears longs' stops = manipulation DOWN)
//   2. Price displaces UP from swept Asia low (≥ t2DisplaceAtr × ATR = smart money buying)
//   3. Price retraces DOWN back into Asia range
//   4. Touches strongest bull PD zone (FVG/OB) inside Asia range
//   5. Strong bullish engulfing (≥ t2BodyRatio) forms at that touch
//   6. FIRE T2 LONG
//
// T2 SHORT logic (ICT AMD — Asia HIGH swept):
//   1. sweptShort = Asia HIGH swept (price rises above, clears shorts' stops = manipulation UP)
//   2. Price displaces DOWN from swept Asia high (≥ t2DisplaceAtr × ATR = smart money selling)
//   3. Price retraces UP back into Asia range
//   4. Touches strongest bear PD zone (FVG/OB) inside Asia range
//   5. Strong bearish engulfing (≥ t2BodyRatio) forms at that touch
//   6. FIRE T2 SHORT
// =============================================================================

// T2 state machine — separate from T1
var int t2LongState = 0      // 0=waiting sweep, 1=sweep confirmed waiting displacement, 2=displaced waiting retrace, 3=in retrace zone waiting engulf, 4=fired
var int t2ShortState = 0
var float t2LongMaxDown = na    // tracks max HIGH reached after Asia LOW sweep (displacement UP)
var float t2ShortMaxUp = na     // tracks min LOW reached after Asia HIGH sweep (displacement DOWN)
var float t2LongTargetZoneTop = na   // the strongest bull PD zone top (inside Asia)
var float t2LongTargetZoneBot = na   // its bottom
var float t2ShortTargetZoneTop = na
var float t2ShortTargetZoneBot = na
var string t2LongZoneSrc = ""
var string t2ShortZoneSrc = ""
var box t2LongZoneBox = na
var box t2ShortZoneBox = na
var bool t2LongTaken = false
var bool t2ShortTaken = false
var bool t2LongBlockedNextLiq = false
var bool t2ShortBlockedNextLiq = false

// Reset T2 state on Asia start (not London — T2 needs the full post-sweep story)
if asiaStarted
    t2LongState := 0
    t2ShortState := 0
    t2LongMaxDown := na
    t2ShortMaxUp := na
    t2LongTargetZoneTop := na
    t2LongTargetZoneBot := na
    t2ShortTargetZoneTop := na
    t2ShortTargetZoneBot := na
    t2LongZoneSrc := ""
    t2ShortZoneSrc := ""
    t2LongTaken := false
    t2ShortTaken := false
    t2LongBlockedNextLiq := false
    t2ShortBlockedNextLiq := false
    if not na(t2LongZoneBox)
        box.delete(t2LongZoneBox)
        t2LongZoneBox := na
    if not na(t2ShortZoneBox)
        box.delete(t2ShortZoneBox)
        t2ShortZoneBox := na

// v9: also clean up stale T2 zone boxes when London starts (fresh session)
if londonStarted
    if not na(t2LongZoneBox)
        box.delete(t2LongZoneBox)
        t2LongZoneBox := na
    if not na(t2ShortZoneBox)
        box.delete(t2ShortZoneBox)
        t2ShortZoneBox := na

// Helper: find STRONGEST (deepest) bullish PD zone INSIDE Asia range
// "Strongest" = closest to Asia LOW (deepest retrace zone for a LONG)
// v9 FIX: 50% overlap check instead of fully-inside-Asia
zoneOverlapOK(zTop, zBot, aHigh, aLow) =>
    zSize = zTop - zBot
    oTop = math.min(zTop, aHigh)
    oBot = math.max(zBot, aLow)
    oAmt = math.max(0.0, oTop - oBot)
    oPct = zSize > 0 ? oAmt / zSize : 0.0
    oPct >= 0.50

findStrongestBullPdInAsia() =>
    float bestTop = na
    float bestBot = na
    string bestSrc = ""
    float deepestLow = na  // the lowest bottom we've seen
    if not na(asiaHigh) and not na(asiaLow)
        // 5m bull FVGs
        szF = array.size(bullFvgT)
        if szF > 0
            for i = 0 to szF - 1
                t = array.get(bullFvgT, i)
                b = array.get(bullFvgBo, i)
                if not na(t) and not na(b)
                    // v9: Zone must have ≥50% overlap with Asia range (relaxed from fully inside)
                    insideAsia = not t2RequireAsiaRetrace or zoneOverlapOK(t, b, asiaHigh, asiaLow)
                    if insideAsia
                        if na(deepestLow) or b < deepestLow
                            deepestLow := b
                            bestTop := t
                            bestBot := b
                            bestSrc := "FVG5"
        // Bull OBs
        szO = array.size(bullObT)
        if szO > 0
            for i = 0 to szO - 1
                t = array.get(bullObT, i)
                b = array.get(bullObBo, i)
                if not na(t) and not na(b)
                    insideAsia = not t2RequireAsiaRetrace or zoneOverlapOK(t, b, asiaHigh, asiaLow)
                    if insideAsia
                        if na(deepestLow) or b < deepestLow
                            deepestLow := b
                            bestTop := t
                            bestBot := b
                            bestSrc := "OB"
    [bestTop, bestBot, bestSrc]

findStrongestBearPdInAsia() =>
    float bestTop = na
    float bestBot = na
    string bestSrc = ""
    float highestTop = na  // the highest top we've seen (closest to Asia HIGH = deepest for SHORT)
    if not na(asiaHigh) and not na(asiaLow)
        szF = array.size(bearFvgT)
        if szF > 0
            for i = 0 to szF - 1
                t = array.get(bearFvgT, i)
                b = array.get(bearFvgBo, i)
                if not na(t) and not na(b)
                    // v9: 50% overlap check (relaxed)
                    insideAsia = not t2RequireAsiaRetrace or zoneOverlapOK(t, b, asiaHigh, asiaLow)
                    if insideAsia
                        if na(highestTop) or t > highestTop
                            highestTop := t
                            bestTop := t
                            bestBot := b
                            bestSrc := "FVG5"
        szO = array.size(bearObT)
        if szO > 0
            for i = 0 to szO - 1
                t = array.get(bearObT, i)
                b = array.get(bearObBo, i)
                if not na(t) and not na(b)
                    insideAsia = not t2RequireAsiaRetrace or zoneOverlapOK(t, b, asiaHigh, asiaLow)
                    if insideAsia
                        if na(highestTop) or t > highestTop
                            highestTop := t
                            bestTop := t
                            bestBot := b
                            bestSrc := "OB"
    [bestTop, bestBot, bestSrc]

// T2 LONG state machine
// ICT AMD: Asia LOW swept (sweptLong) → displacement UP → retrace DOWN to bull PD → LONG
if enableT2 and inLondonExt
    // State 0 → 1: wait for Asia LOW sweep (manipulation DOWN clears longs' stops → reversal UP)
    if t2LongState == 0 and sweptLong and sweptLongSrc == "AL"
        t2LongState := 1
        t2LongMaxDown := high
    // State 1 → 2: track max displacement UP from swept Asia low
    if t2LongState == 1
        t2LongMaxDown := math.max(nz(t2LongMaxDown, high), high)
        displacementOK = not na(sweptLongLevel) and (t2LongMaxDown - sweptLongLevel) >= atr14 * t2DisplaceAtr
        if displacementOK
            t2LongState := 2
            // Identify strongest PD zone inside Asia range
            [ztop, zbot, zsrc] = findStrongestBullPdInAsia()
            if not na(ztop) and not na(zbot)
                t2LongTargetZoneTop := ztop
                t2LongTargetZoneBot := zbot
                t2LongZoneSrc := zsrc
                if t2ShowZoneBox
                    t2LongZoneBox := box.new(bar_index, ztop, bar_index + 50, zbot, bgcolor = t2ZoneBoxColor, border_color = color.new(color.yellow, 40), text = "T2 Long Zone (" + zsrc + ")", text_size = size.tiny, text_color = color.new(color.yellow, 0))
    // v9.4: Block T2 LONG if Asia HIGH also gets swept (opposite liq taken = setup invalidated)
    if t2LongState >= 1 and t2LongState <= 3 and sweptShort and sweptShortSrc == "AH"
        t2LongBlockedNextLiq := true
    // State 2 → 3: wait for price to touch ANY qualifying PD zone inside Asia
    // v9.4: Check ALL qualifying PD zones, not just the stored one
    if t2LongState == 2
        if na(t2LongTargetZoneTop) or na(t2LongTargetZoneBot)
            [ztop2, zbot2, zsrc2] = findStrongestBullPdInAsia()
            if not na(ztop2) and not na(zbot2)
                t2LongTargetZoneTop := ztop2
                t2LongTargetZoneBot := zbot2
                t2LongZoneSrc := zsrc2
                if t2ShowZoneBox and na(t2LongZoneBox)
                    t2LongZoneBox := box.new(bar_index, ztop2, bar_index + 50, zbot2, bgcolor = t2ZoneBoxColor, border_color = color.new(color.yellow, 40), text = "T2 Long Zone (" + zsrc2 + ")", text_size = size.tiny, text_color = color.new(color.yellow, 0))
        // v9.4: Check ALL qualifying PD zones, not just the stored one
        if not na(asiaHigh) and not na(asiaLow)
            // Check all bull FVGs
            for idx = 0 to math.max(0, array.size(bullFvgT) - 1)
                if t2LongState == 2 and idx < array.size(bullFvgT)
                    zT = array.get(bullFvgT, idx)
                    zB = array.get(bullFvgBo, idx)
                    if not na(zT) and not na(zB) and zoneOverlapOK(zT, zB, asiaHigh, asiaLow)
                        for bk = 0 to 2
                            if t2LongState == 2 and low[bk] <= zT and low[bk] >= zB
                                t2LongState := 3
                                t2LongZoneSrc := "FVG5"
            // Check all bull OBs
            for idx = 0 to math.max(0, array.size(bullObT) - 1)
                if t2LongState == 2 and idx < array.size(bullObT)
                    zT = array.get(bullObT, idx)
                    zB = array.get(bullObBo, idx)
                    if not na(zT) and not na(zB) and zoneOverlapOK(zT, zB, asiaHigh, asiaLow)
                        for bk = 0 to 2
                            if t2LongState == 2 and low[bk] <= zT and low[bk] >= zB
                                t2LongState := 3
                                t2LongZoneSrc := "OB"

// Extend T2 zone box if alive
if not na(t2LongZoneBox)
    box.set_right(t2LongZoneBox, bar_index + 10)

// T2 SHORT state machine (mirror)
// ICT AMD: Asia HIGH swept (sweptShort) → displacement DOWN → retrace UP to bear PD → SHORT
if enableT2 and inLondonExt
    if t2ShortState == 0 and sweptShort and sweptShortSrc == "AH"
        t2ShortState := 1
        t2ShortMaxUp := low
    if t2ShortState == 1
        t2ShortMaxUp := math.min(nz(t2ShortMaxUp, low), low)
        displacementOK = not na(sweptShortLevel) and (sweptShortLevel - t2ShortMaxUp) >= atr14 * t2DisplaceAtr
        if displacementOK
            t2ShortState := 2
            [ztop, zbot, zsrc] = findStrongestBearPdInAsia()
            if not na(ztop) and not na(zbot)
                t2ShortTargetZoneTop := ztop
                t2ShortTargetZoneBot := zbot
                t2ShortZoneSrc := zsrc
                if t2ShowZoneBox
                    t2ShortZoneBox := box.new(bar_index, ztop, bar_index + 50, zbot, bgcolor = t2ZoneBoxColor, border_color = color.new(color.yellow, 40), text = "T2 Short Zone (" + zsrc + ")", text_size = size.tiny, text_color = color.new(color.yellow, 0))
    // v9.4: Block T2 SHORT if Asia LOW also gets swept (opposite liq taken = setup invalidated)
    if t2ShortState >= 1 and t2ShortState <= 3 and sweptLong and sweptLongSrc == "AL"
        t2ShortBlockedNextLiq := true
    // v9.4: Check ALL qualifying PD zones for SHORT retrace
    if t2ShortState == 2
        if na(t2ShortTargetZoneTop) or na(t2ShortTargetZoneBot)
            [ztop3, zbot3, zsrc3] = findStrongestBearPdInAsia()
            if not na(ztop3) and not na(zbot3)
                t2ShortTargetZoneTop := ztop3
                t2ShortTargetZoneBot := zbot3
                t2ShortZoneSrc := zsrc3
                if t2ShowZoneBox and na(t2ShortZoneBox)
                    t2ShortZoneBox := box.new(bar_index, ztop3, bar_index + 50, zbot3, bgcolor = t2ZoneBoxColor, border_color = color.new(color.yellow, 40), text = "T2 Short Zone (" + zsrc3 + ")", text_size = size.tiny, text_color = color.new(color.yellow, 0))
        // v9.4: Check ALL qualifying PD zones, not just the stored one
        if not na(asiaHigh) and not na(asiaLow)
            // Check all bear FVGs
            for idx = 0 to math.max(0, array.size(bearFvgT) - 1)
                if t2ShortState == 2 and idx < array.size(bearFvgT)
                    zT = array.get(bearFvgT, idx)
                    zB = array.get(bearFvgBo, idx)
                    if not na(zT) and not na(zB) and zoneOverlapOK(zT, zB, asiaHigh, asiaLow)
                        for bk = 0 to 2
                            if t2ShortState == 2 and high[bk] >= zB and high[bk] <= zT
                                t2ShortState := 3
                                t2ShortZoneSrc := "FVG5"
            // Check all bear OBs
            for idx = 0 to math.max(0, array.size(bearObT) - 1)
                if t2ShortState == 2 and idx < array.size(bearObT)
                    zT = array.get(bearObT, idx)
                    zB = array.get(bearObBo, idx)
                    if not na(zT) and not na(zB) and zoneOverlapOK(zT, zB, asiaHigh, asiaLow)
                        for bk = 0 to 2
                            if t2ShortState == 2 and high[bk] >= zB and high[bk] <= zT
                                t2ShortState := 3
                                t2ShortZoneSrc := "OB"

if not na(t2ShortZoneBox)
    box.set_right(t2ShortZoneBox, bar_index + 10)

// T2 Engulfing (uses separate body % from T1)
t2StrongBullCandle = effClose > effOpen and bullBodyPct >= t2BodyRatio
t2StrongBearCandle = effClose < effOpen and bearBodyPct >= t2BodyRatio

// T2 signal fires when state == 3 AND strong engulf forms
fireT2Long = false
fireT2Short = false

// v9.2: T2 SL uses nearest swing high/low — same as T1 for consistency
// v9.5: T2 SL uses Smart SL Chain — same as T1 (engulf → swing → London → Asia)
[t2LongSL, t2LongSlSrc]   = smartSLLong(close)
[t2ShortSL, t2ShortSlSrc] = smartSLShort(close)

float t2LongTP = na
string t2LongTpSrc = ""
if enableT2 and t2LongState == 3 and not na(t2LongSL)
    [tp, src] = pickLongTP(close, t2LongSL)
    t2LongTP := tp
    t2LongTpSrc := src

float t2ShortTP = na
string t2ShortTpSrc = ""
if enableT2 and t2ShortState == 3 and not na(t2ShortSL)
    [tp, src] = pickShortTP(close, t2ShortSL)
    t2ShortTP := tp
    t2ShortTpSrc := src

t2LongRiskD = not na(t2LongSL) ? close - t2LongSL : 0.0
t2LongRR = t2LongRiskD > 0 and not na(t2LongTP) ? (t2LongTP - close) / t2LongRiskD : 0.0

t2ShortRiskD = not na(t2ShortSL) ? t2ShortSL - close : 0.0
t2ShortRR = t2ShortRiskD > 0 and not na(t2ShortTP) ? (close - t2ShortTP) / t2ShortRiskD : 0.0

// Apply bias filter and RR check
t2LongRROK = t2LongRR >= t2MinRR
t2ShortRROK = t2ShortRR >= t2MinRR

if enableT2 and inLondon and not sessionLimitHit
    // v9.5: T2 LONG fire gate — WICK must have touched into Asia (the rejection candle's
    // close can break out above asiaHigh — that IS the rejection signal we want).
    // Old v9.4: close >= asiaLow and close <= asiaHigh  ← killed valid setups (Image 1)
    // New v9.5: low <= asiaHigh + buffer (wick reached into/below Asia high zone)
    //           AND low >= asiaLow - buffer (didn't fully break Asia low)
    asiaBuf = atr14 * 0.02
    t2LongWickInAsia  = low  <= nz(asiaHigh, low)  + asiaBuf and low  >= nz(asiaLow, low)  - asiaBuf
    t2ShortWickInAsia = high >= nz(asiaLow, high) - asiaBuf and high <= nz(asiaHigh, high) + asiaBuf
    if t2LongState == 3 and t2StrongBullCandle and lowVolPass and volConfirmPass and finalLongOK and t2LongRROK and not t2LongBlockedNextLiq and t2LongWickInAsia and not asiaTicksBlock
        if not (oneT2PerSide and t2LongTaken)
            fireT2Long := true
            t2LongTaken := true
            t2LongState := 4
            signalsThisSession += 1
    if t2ShortState == 3 and t2StrongBearCandle and lowVolPass and volConfirmPass and finalShortOK and t2ShortRROK and not t2ShortBlockedNextLiq and t2ShortWickInAsia and not asiaTicksBlock
        if not (oneT2PerSide and t2ShortTaken)
            fireT2Short := true
            t2ShortTaken := true
            t2ShortState := 4
            signalsThisSession += 1

// =============================================================================
// NY ENGINE (v9.8)
// =============================================================================
// Mirrors the London engine but runs during NY session (default 14:30–17:00 CET).
// Sweep targets per nySweepMode:
//   "Model A + Asia fallback": London H/L always; Asia H/L only if NOT yet
//     swept today (tracked via asiaHighSweptToday / asiaLowSweptToday).
//   "Pure Model A": London H/L only.
//
// State machine: detects sweep of a NY target → tracks displacement →
// looks for retrace into PD zone (FVG/OB) → fires on strong engulf.
// Same body %, lowVol, volConfirm, bias, smart SL gates as London.
// =============================================================================

var bool fireNyLong  = false
var bool fireNyShort = false
var bool fireNyT2Long  = false
var bool fireNyT2Short = false
fireNyLong  := false
fireNyShort := false
fireNyT2Long  := false
fireNyT2Short := false

// NY sweep targets — what NY engine watches
nyAsiaFallback = nySweepMode == "Model A + Asia fallback (London H/L always, Asia only if not yet swept)"

// NY sweep state — separate from main sweptLong/sweptShort
var bool nySweepLong  = false
var bool nySweepShort = false
var string nySweepLongSrc  = ""  // "LL" / "AL"
var string nySweepShortSrc = ""  // "LH" / "AH"
var float  nySweepLongLevel  = na
var float  nySweepShortLevel = na
var int    nySweepLongBar  = na
var int    nySweepShortBar = na

// At NY start: seed nySweep flags from global today-swept tracking
// (v9.11 — accepts pre-NY sweeps from London/Asia)
if nyStarted
    nySweepLong := false
    nySweepShort := false
    nySweepLongSrc := ""
    nySweepShortSrc := ""
    nySweepLongLevel := na
    nySweepShortLevel := na
    nySweepLongBar := na
    nySweepShortBar := na

// =============================================================================
// v9.11: NY sweep evaluation — runs throughout NY, accepts pre-NY sweeps
// Priority: London H/L (preferred) → Asia H/L (fallback / Pure Model A allows London only)
// Each source gated by its individual toggle (nyAcceptAH/AL/LH/LL).
// =============================================================================
if enableNyEngine and inNY and not nyTicksBlock
    // ----- LONG sweep (low side swept) -----
    if not nySweepLong
        // Priority 1: London Low (if today's London Low has been swept and toggle is ON)
        if nyAcceptLL and londonLowSweptToday and not na(londonLow)
            nySweepLong := true
            nySweepLongSrc := "LL"
            nySweepLongLevel := londonLow
            nySweepLongBar := nz(llSweptBar, bar_index)
        // Priority 2: Asia Low — only if Asia fallback enabled AND toggle ON AND swept today
        else if nyAsiaFallback and nyAcceptAL and asiaLowSweptToday and not na(asiaLow)
            nySweepLong := true
            nySweepLongSrc := "AL"
            nySweepLongLevel := asiaLow
            nySweepLongBar := nz(alSweptBar, bar_index)

    // ----- SHORT sweep (high side swept) -----
    if not nySweepShort
        // Priority 1: London High
        if nyAcceptLH and londonHighSweptToday and not na(londonHigh)
            nySweepShort := true
            nySweepShortSrc := "LH"
            nySweepShortLevel := londonHigh
            nySweepShortBar := nz(lhSweptBar, bar_index)
        // Priority 2: Asia High — only if Asia fallback enabled AND toggle ON AND swept today
        else if nyAsiaFallback and nyAcceptAH and asiaHighSweptToday and not na(asiaHigh)
            nySweepShort := true
            nySweepShortSrc := "AH"
            nySweepShortLevel := asiaHigh
            nySweepShortBar := nz(ahSweptBar, bar_index)

// =============================================================================
// NY SMART SL CHAIN (v9.8)
// Engulf → swing → NY H/L → London H/L → Asia H/L
// =============================================================================
smartSLLongNy(float entry) =>
    float sl = na
    string src = ""
    float minDist = effAtr * slMinAtrDist
    float bufTicks = slBuffer * syminfo.mintick
    // 1. Engulf candle low
    if slUseEngulfFirst
        c1 = effLow - bufTicks
        if not na(c1) and (entry - c1) >= minDist
            sl := c1
            src := "engulf"
    // 2. Recent swing low
    if na(sl)
        c2 = recentSwingLow - bufTicks
        if not na(c2) and (entry - c2) >= minDist
            sl := c2
            src := "swing"
    // 3. NY low
    if na(sl) and not na(nyLow)
        c3 = nyLow - bufTicks
        if (entry - c3) >= minDist
            sl := c3
            src := "NY"
    // 4. London low
    if na(sl) and not na(londonLow)
        c4 = londonLow - bufTicks
        if (entry - c4) >= minDist
            sl := c4
            src := "London"
    // 5. Asia low
    if na(sl) and not na(asiaLow)
        c5 = asiaLow - bufTicks
        if (entry - c5) >= minDist
            sl := c5
            src := "Asia"
    // Fallback
    if na(sl)
        sl := math.min(effLow, nz(recentSwingLow, effLow)) - bufTicks
        src := "fallback"
    [sl, src]

smartSLShortNy(float entry) =>
    float sl = na
    string src = ""
    float minDist = effAtr * slMinAtrDist
    float bufTicks = slBuffer * syminfo.mintick
    if slUseEngulfFirst
        c1 = effHigh + bufTicks
        if not na(c1) and (c1 - entry) >= minDist
            sl := c1
            src := "engulf"
    if na(sl)
        c2 = recentSwingHigh + bufTicks
        if not na(c2) and (c2 - entry) >= minDist
            sl := c2
            src := "swing"
    if na(sl) and not na(nyHigh)
        c3 = nyHigh + bufTicks
        if (c3 - entry) >= minDist
            sl := c3
            src := "NY"
    if na(sl) and not na(londonHigh)
        c4 = londonHigh + bufTicks
        if (c4 - entry) >= minDist
            sl := c4
            src := "London"
    if na(sl) and not na(asiaHigh)
        c5 = asiaHigh + bufTicks
        if (c5 - entry) >= minDist
            sl := c5
            src := "Asia"
    if na(sl)
        sl := math.max(effHigh, nz(recentSwingHigh, effHigh)) + bufTicks
        src := "fallback"
    [sl, src]

[nyLongSL, nyLongSlSrc]   = smartSLLongNy(close)
[nyShortSL, nyShortSlSrc] = smartSLShortNy(close)

// v9.9 Fix #2: Compute NY-specific TPs (uses same direction-filtered engine)
// These are evaluated EVERY bar during NY (independent of London base state)
if inNY
    if not na(nyLongSL) and (close - nyLongSL) > 0
        [nyTp1, nySrc1] = pickLongTP(close, nyLongSL)
        nyLongTP := nyTp1
        nyLongTpSrc := nySrc1
    if not na(nyShortSL) and (nyShortSL - close) > 0
        [nyTp2, nySrc2] = pickShortTP(close, nyShortSL)
        nyShortTP := nyTp2
        nyShortTpSrc := nySrc2

// NY RR using NY-specific SL and TP
nyLongRiskD = close - nyLongSL
nyLongActualRR = nyLongRiskD > 0 and not na(nyLongTP) ? (nyLongTP - close) / nyLongRiskD : 0.0
nyLongRROK = nyLongActualRR >= minRR

nyShortRiskD = nyShortSL - close
nyShortActualRR = nyShortRiskD > 0 and not na(nyShortTP) ? (close - nyShortTP) / nyShortRiskD : 0.0
nyShortRROK = nyShortActualRR >= minRR

// NY-specific PD touch flags (Fix #1) — gated on NY sweep bars
nyBullPdTouched = touchedBullPdNy(nySweepLongBar)
nyBearPdTouched = touchedBearPdNy(nySweepShortBar)

// NY engulf checks using configurable NY body %
nyT1StrongBull = effClose > effOpen and bullBodyPct >= nyT1BodyRatio
nyT1StrongBear = effClose < effOpen and bearBodyPct >= nyT1BodyRatio
nyT2StrongBull = effClose > effOpen and bullBodyPct >= nyT2BodyRatio
nyT2StrongBear = effClose < effOpen and bearBodyPct >= nyT2BodyRatio

// =============================================================================
// NY T1 FIRE — v9.10 with manipulation protection (1st/2nd entry state machine)
// Mirrors London T1 manipulation logic. Mode determined by nyManipMode input.
// =============================================================================
// Determine effective NY mode (resolves "Auto" to either 1st-only or 2nd-only)
nyAutoUse2nd = nyManipMode == "Auto (smart decide based on conditions)" and (asiaRangeSize > effAtr * nyAutoVolThreshold or asiaTooWide or asiaHuge)
nyMode1stOnly = nyManipMode == "1st Entry Only (aggressive, no manip protection)"
nyMode2ndOnly = nyManipMode == "2nd Entry Only (safer, wait for stop-hunt)" or nyAutoUse2nd
nyModeBoth   = nyManipMode == "Both (1st + 2nd, fires whichever qualifies first)"
nyModeAutoFirst = nyManipMode == "Auto (smart decide based on conditions)" and not nyAutoUse2nd
// In Auto mode without 2nd-only condition, behave like 1st-only (clean conditions = take immediate)
nyAllow1st = nyMode1stOnly or nyModeBoth or nyModeAutoFirst
nyAllow2nd = nyMode2ndOnly or nyModeBoth

if enableNyEngine and inNY and not nyTicksBlock and not nySessionLimitHit
    // ---------- NY T1 LONG state machine ----------
    canFireBaseL = nySweepLong and not nyLongTaken and nyBullPdTouched and lowVolPass and volConfirmPass and finalLongOK and nyLongRROK and nyLongActualRR <= maxRR and not na(nyLongTP)

    // State 0: idle, watching for first strong bull engulf
    if nyLongEngulfState == 0 and canFireBaseL and nyT1StrongBull
        // Record the first engulf
        nyLongFirstEngulfHigh := high
        nyLongFirstEngulfLow := low
        nyLongFirstEngulfBar := bar_index
        nyLongEngulfState := 1
        // If 1st-entry allowed, fire NOW
        if nyAllow1st
            fireNyLong := true
            nyLongTaken := true
            nyLongEngulfState := 3  // terminal, no further fires
            nySignalsThisSession += 1

    // State 1: 1st engulf detected, watching for manipulation wick below it
    else if nyLongEngulfState == 1 and not nyLongTaken
        manipWickDist = nz(nyLongFirstEngulfLow, low) - low
        if low < nz(nyLongFirstEngulfLow, low) and manipWickDist >= effAtr * nyManipWickAtr
            nyLongEngulfState := 2  // manip armed, waiting for 2nd engulf
            if showManipBoxes
                box.new(nz(nyLongFirstEngulfBar, bar_index), nz(nyLongFirstEngulfLow, low), bar_index, low, bgcolor = color.new(#ffab40, 75), border_color = color.new(#ffab40, 25), text = "NY Manip", text_size = size.tiny, text_color = color.new(#ffab40, 0))

    // State 2: manipulation armed, waiting for 2nd strong bull engulf to fire
    else if nyLongEngulfState == 2 and not nyLongTaken and nyAllow2nd and canFireBaseL and nyT1StrongBull
        fireNyLong := true
        nyLongTaken := true
        nyLongEngulfState := 3
        nySignalsThisSession += 1

    // ---------- NY T1 SHORT state machine ----------
    canFireBaseS = nySweepShort and not nyShortTaken and nyBearPdTouched and lowVolPass and volConfirmPass and finalShortOK and nyShortRROK and nyShortActualRR <= maxRR and not na(nyShortTP)

    if nyShortEngulfState == 0 and canFireBaseS and nyT1StrongBear
        nyShortFirstEngulfHigh := high
        nyShortFirstEngulfLow := low
        nyShortFirstEngulfBar := bar_index
        nyShortEngulfState := 1
        if nyAllow1st
            fireNyShort := true
            nyShortTaken := true
            nyShortEngulfState := 3
            nySignalsThisSession += 1

    else if nyShortEngulfState == 1 and not nyShortTaken
        manipWickDist = high - nz(nyShortFirstEngulfHigh, high)
        if high > nz(nyShortFirstEngulfHigh, high) and manipWickDist >= effAtr * nyManipWickAtr
            nyShortEngulfState := 2
            if showManipBoxes
                box.new(nz(nyShortFirstEngulfBar, bar_index), nz(nyShortFirstEngulfHigh, high), bar_index, high, bgcolor = color.new(#ffab40, 75), border_color = color.new(#ffab40, 25), text = "NY Manip", text_size = size.tiny, text_color = color.new(#ffab40, 0))

    else if nyShortEngulfState == 2 and not nyShortTaken and nyAllow2nd and canFireBaseS and nyT1StrongBear
        fireNyShort := true
        nyShortTaken := true
        nyShortEngulfState := 3
        nySignalsThisSession += 1

// Tag whether NY fire was 1st-entry or 2nd-entry (for label badge)
nyLongIs2nd  = fireNyLong  and nyLongEngulfState  == 3 and nyAllow2nd and not nyAllow1st  // pure 2nd-only mode
nyShortIs2nd = fireNyShort and nyShortEngulfState == 3 and nyAllow2nd and not nyAllow1st
// In "Both" mode, detect 2nd by checking if the firing bar is past the 1st engulf bar with manip in between
nyLongIs2ndBoth  = fireNyLong  and nyAllow1st and nyAllow2nd and not na(nyLongFirstEngulfBar)  and bar_index > nyLongFirstEngulfBar
nyShortIs2ndBoth = fireNyShort and nyAllow1st and nyAllow2nd and not na(nyShortFirstEngulfBar) and bar_index > nyShortFirstEngulfBar
nyLongFiredAs2nd  = nyLongIs2nd  or nyLongIs2ndBoth
nyShortFiredAs2nd = nyShortIs2nd or nyShortIs2ndBoth

// NY T2 — AMD logic with reference range = London (or Asia fallback)
// (T2 has no manip mode — already protected by sweep+displacement+PD touch)
if enableNyEngine and inNY and not nyTicksBlock and not nySessionLimitHit
    // NY T2 LONG: needs AL or LL swept (low sweep — clears longs' stops → reversal UP)
    if nySweepLong and not nyT2LongTaken and nyT2StrongBull and lowVolPass and volConfirmPass and finalLongOK
        nyT2RefHigh = nySweepLongSrc == "LL" ? londonHigh : asiaHigh
        nyT2RefLow  = nySweepLongSrc == "LL" ? londonLow  : asiaLow
        nyT2InRangeOK = not nyT2RequireSessionRetrace or (low <= nz(nyT2RefHigh, low) + effAtr * 0.1 and low >= nz(nyT2RefLow, low) - effAtr * 0.1)
        nyT2Displacement = math.abs(high - nySweepLongLevel)
        if nyT2InRangeOK and nyT2Displacement >= effAtr * t2DisplaceAtr and nyBullPdTouched and (bar_index - nySweepLongBar) >= 3
            nyT2LongActualRR = nyLongRiskD > 0 and not na(nyLongTP) ? (nyLongTP - close) / nyLongRiskD : 0.0
            if nyT2LongActualRR >= t2MinRR and nyT2LongActualRR <= t2MaxRR and not na(nyLongTP)
                fireNyT2Long := true
                nyT2LongTaken := true
                nySignalsThisSession += 1
    // NY T2 SHORT: needs AH or LH swept (high sweep — clears shorts' stops → reversal DOWN)
    if nySweepShort and not nyT2ShortTaken and nyT2StrongBear and lowVolPass and volConfirmPass and finalShortOK
        nyT2RefHigh = nySweepShortSrc == "LH" ? londonHigh : asiaHigh
        nyT2RefLow  = nySweepShortSrc == "LH" ? londonLow  : asiaLow
        nyT2InRangeOK = not nyT2RequireSessionRetrace or (high >= nz(nyT2RefLow, high) - effAtr * 0.1 and high <= nz(nyT2RefHigh, high) + effAtr * 0.1)
        nyT2Displacement = math.abs(nySweepShortLevel - low)
        if nyT2InRangeOK and nyT2Displacement >= effAtr * t2DisplaceAtr and nyBearPdTouched and (bar_index - nySweepShortBar) >= 3
            nyT2ShortActualRR = nyShortRiskD > 0 and not na(nyShortTP) ? (close - nyShortTP) / nyShortRiskD : 0.0
            if nyT2ShortActualRR >= t2MinRR and nyT2ShortActualRR <= t2MaxRR and not na(nyShortTP)
                fireNyT2Short := true
                nyT2ShortTaken := true
                nySignalsThisSession += 1

// =============================================================================
// 1M PRECISION FIRE PATH (v9.7)
// =============================================================================
// Activates only when chart TF < logic TF AND enable1mFire is on.
// Uses CHART bars (1m) for the engulf candle, and the existing 5m setup state
// machines / sweeps / PD touches / bias gates already computed above.
//
// Variant 1: synchronized — also requires the partial 5m candle (eff*) to
//            already validate the same body% / volume / lowVol checks.
//            This means when the 5m bar closes shortly after, the same
//            conditions will still hold → SAME trades as 5m, EARLIER price.
//
// Variant 2: independent — fire on any strong 1m engulf inside an active
//            setup, no partial-5m check.
// =============================================================================
var bool fireLong1m  = false
var bool fireShort1m = false
var bool fireT2Long1m  = false
var bool fireT2Short1m = false
var string lastFireTfTag = ""  // "5m" / "1m-V1" / "1m-V2"

fireLong1m  := false
fireShort1m := false
fireT2Long1m  := false
fireT2Short1m := false

if oneMinFireActive and inLondon and not sessionLimitHit and not asiaTicksBlock
    // 1m chart-bar engulf math
    chartCandleRange = high - low
    chartBullBody = close > open ? close - open : 0.0
    chartBearBody = close < open ? open - close : 0.0
    chartBullPct = chartCandleRange > 0 ? chartBullBody / chartCandleRange : 0.0
    chartBearPct = chartCandleRange > 0 ? chartBearBody / chartCandleRange : 0.0
    chartT1Bull = close > open and chartBullPct >= oneMinBodyRatio
    chartT1Bear = close < open and chartBearPct >= oneMinBodyRatio
    chartT2Bull = close > open and chartBullPct >= oneMinT2BodyRatio
    chartT2Bear = close < open and chartBearPct >= oneMinT2BodyRatio

    // Variant 1 partial-5m validation: "if the forming 5m bar closed RIGHT NOW,
    // would all conditions pass?" Uses formingOpen/High/Low/Close accumulated
    // from chart bars since the start of the current logic-TF bar.
    isV1 = fireVariant == "Variant 1 — Synchronized (1m fires only when 5m would also fire)"
    isV2 = fireVariant == "Variant 2 — Independent (fire on any strong 1m engulf in active setup)"

    // Forming-5m gates (re-uses live formingBullPct etc, which are the
    // partial-5m candle's body % at this moment in time)
    partialT1BullStrong = formingClose > nz(formingOpen, open) and formingBullPct >= minBodyRatio
    partialT1BearStrong = formingClose < nz(formingOpen, open) and formingBearPct >= minBodyRatio
    partialT2BullStrong = formingClose > nz(formingOpen, open) and formingBullPct >= t2BodyRatio
    partialT2BearStrong = formingClose < nz(formingOpen, open) and formingBearPct >= t2BodyRatio
    partialRangeOK = formingRange >= effAtr * minCandleAtr
    partialVolRatio = effVolAvg > 0 ? formingVolume / effVolAvg : 1.0
    partialVolRatioOK = partialVolRatio >= minVolRatio
    partialLowVolPass = not enableLowVolFilter or (partialRangeOK and avgBodyOK and partialVolRatioOK)
    partialVolConfirmPass = not enableVolConfirm or partialVolRatio >= volConfirmMult
    partialT1BullOK = partialT1BullStrong and partialLowVolPass and partialVolConfirmPass
    partialT1BearOK = partialT1BearStrong and partialLowVolPass and partialVolConfirmPass
    partialT2BullOK = partialT2BullStrong and partialLowVolPass and partialVolConfirmPass
    partialT2BearOK = partialT2BearStrong and partialLowVolPass and partialVolConfirmPass

    // v9.19 BUG FIX: Compute 1m chart-bar Vol Confirm pass (this candle's own volume
    // vs 20-bar avg). In v9.18, V2 SKIPPED this entirely — trades fired below threshold.
    chartVolRatio = effVolAvg > 0 ? volume / effVolAvg : 1.0
    chartVolConfirmPass = not enableVolConfirm or chartVolRatio >= volConfirmMult

    // v9.19: Apply chosen 1m vol confirm mode (Strict / 5m Partial / Off)
    // This applies to BOTH Variant 1 and Variant 2 — Strict mode means even V1
    // requires the firing 1m candle itself to pass the vol threshold.
    oneMinVolPass = oneMinVolOff ? true : (oneMinVolStrict ? chartVolConfirmPass : partialVolConfirmPass)

    // ----- T1 LONG 1m fire -----
    canFireT1L = enableT1 and longBase and longRROK and not (oneSignalPerSide and longTakenThisSession)
    // v9.19: Variant 1 still requires full partial 5m gates AND chosen vol mode.
    //        Variant 2 only requires chosen vol mode (was: skipped vol entirely).
    v1OkT1L = isV1 ? (partialT1BullOK and oneMinVolPass) : oneMinVolPass
    if canFireT1L and chartT1Bull and v1OkT1L
        // respect same state machine as 5m
        if longEngulfState == 0 and (modeFirstOnly or modeBoth)
            fireLong1m := true
            longFirstEngulfHigh := high
            longFirstEngulfLow := low
            longFirstEngulfBar := bar_index
    // [v9.21 removed] dead assignment
            longFirstSL := longCandidateSL
            longEngulfState := 1
        else if longEngulfState == 2 and (modeSecondOnly or modeBoth)
            fireLong1m := true
            longEngulfState := 3

    // ----- T1 SHORT 1m fire -----
    canFireT1S = enableT1 and shortBase and shortRROK and not (oneSignalPerSide and shortTakenThisSession)
    v1OkT1S = isV1 ? (partialT1BearOK and oneMinVolPass) : oneMinVolPass
    if canFireT1S and chartT1Bear and v1OkT1S
        if shortEngulfState == 0 and (modeFirstOnly or modeBoth)
            fireShort1m := true
            shortFirstEngulfHigh := high
            shortFirstEngulfLow := low
            shortFirstEngulfBar := bar_index
    // [v9.21 removed] dead assignment
            shortFirstSL := shortCandidateSL
            shortEngulfState := 1
        else if shortEngulfState == 2 and (modeSecondOnly or modeBoth)
            fireShort1m := true
            shortEngulfState := 3

    // ----- T2 LONG 1m fire -----
    asiaBufLow = nz(asiaLow, low) - effAtr * 0.02
    asiaBufHigh = nz(asiaHigh, high) + effAtr * 0.02
    chart_t2LongWickInAsia = low <= asiaBufHigh and low >= asiaBufLow
    chart_t2ShortWickInAsia = high >= asiaBufLow and high <= asiaBufHigh
    canFireT2L = enableT2 and t2LongState == 3 and finalLongOK and t2LongRROK and not t2LongBlockedNextLiq and chart_t2LongWickInAsia and not (oneT2PerSide and t2LongTaken)
    v1OkT2L = isV1 ? (partialT2BullOK and oneMinVolPass) : oneMinVolPass
    if canFireT2L and chartT2Bull and v1OkT2L
        fireT2Long1m := true
        t2LongTaken := true
        t2LongState := 4

    // ----- T2 SHORT 1m fire -----
    canFireT2S = enableT2 and t2ShortState == 3 and finalShortOK and t2ShortRROK and not t2ShortBlockedNextLiq and chart_t2ShortWickInAsia and not (oneT2PerSide and t2ShortTaken)
    v1OkT2S = isV1 ? (partialT2BearOK and oneMinVolPass) : oneMinVolPass
    if canFireT2S and chartT2Bear and v1OkT2S
        fireT2Short1m := true
        t2ShortTaken := true
        t2ShortState := 4

    // Track session counters when 1m fires
    if fireLong1m
        longTakenThisSession := true
        signalsThisSession += 1
        lastFireTfTag := isV1 ? "1m-V1" : "1m-V2"
    if fireShort1m
        shortTakenThisSession := true
        signalsThisSession += 1
        lastFireTfTag := isV1 ? "1m-V1" : "1m-V2"
    if fireT2Long1m
        signalsThisSession += 1
        lastFireTfTag := isV1 ? "1m-V1" : "1m-V2"
    if fireT2Short1m
        signalsThisSession += 1
        lastFireTfTag := isV1 ? "1m-V1" : "1m-V2"

// =============================================================================
// NY 1M PRECISION FIRE PATH (v9.9 Fix #3)
// Mirrors London 1m fire path but for NY engine.
// =============================================================================
var bool fireNyLong1m  = false
var bool fireNyShort1m = false
var bool fireNyT2Long1m  = false
var bool fireNyT2Short1m = false
fireNyLong1m  := false
fireNyShort1m := false
fireNyT2Long1m  := false
fireNyT2Short1m := false

if oneMinFireActive and enableNyEngine and inNY and not nyTicksBlock and not nySessionLimitHit
    // 1m chart-bar engulf math (re-using same vars as London 1m)
    nyChartCandleRange = high - low
    nyChartBullBody = close > open ? close - open : 0.0
    nyChartBearBody = close < open ? open - close : 0.0
    nyChartBullPct = nyChartCandleRange > 0 ? nyChartBullBody / nyChartCandleRange : 0.0
    nyChartBearPct = nyChartCandleRange > 0 ? nyChartBearBody / nyChartCandleRange : 0.0
    nyChartT1Bull = close > open and nyChartBullPct >= oneMinBodyRatio
    nyChartT1Bear = close < open and nyChartBearPct >= oneMinBodyRatio
    nyChartT2Bull = close > open and nyChartBullPct >= oneMinT2BodyRatio
    nyChartT2Bear = close < open and nyChartBearPct >= oneMinT2BodyRatio

    isV1ny = fireVariant == "Variant 1 — Synchronized (1m fires only when 5m would also fire)"

    // Variant 1 partial-5m gates for NY (uses forming bar tracker)
    nyPartialT1BullStrong = formingClose > nz(formingOpen, open) and formingBullPct >= nyT1BodyRatio
    nyPartialT1BearStrong = formingClose < nz(formingOpen, open) and formingBearPct >= nyT1BodyRatio
    nyPartialT2BullStrong = formingClose > nz(formingOpen, open) and formingBullPct >= nyT2BodyRatio
    nyPartialT2BearStrong = formingClose < nz(formingOpen, open) and formingBearPct >= nyT2BodyRatio
    nyPartialRangeOK = formingRange >= effAtr * minCandleAtr
    nyPartialVolRatio = effVolAvg > 0 ? formingVolume / effVolAvg : 1.0
    nyPartialVolRatioOK = nyPartialVolRatio >= minVolRatio
    nyPartialLowVolPass = not enableLowVolFilter or (nyPartialRangeOK and avgBodyOK and nyPartialVolRatioOK)
    nyPartialVolConfirmPass = not enableVolConfirm or nyPartialVolRatio >= volConfirmMult
    nyPartialT1BullOK = nyPartialT1BullStrong and nyPartialLowVolPass and nyPartialVolConfirmPass
    nyPartialT1BearOK = nyPartialT1BearStrong and nyPartialLowVolPass and nyPartialVolConfirmPass
    nyPartialT2BullOK = nyPartialT2BullStrong and nyPartialLowVolPass and nyPartialVolConfirmPass
    nyPartialT2BearOK = nyPartialT2BearStrong and nyPartialLowVolPass and nyPartialVolConfirmPass

    // v9.19 BUG FIX: Compute 1m chart-bar Vol Confirm pass for NY (same fix as London)
    nyChartVolRatio = effVolAvg > 0 ? volume / effVolAvg : 1.0
    nyChartVolConfirmPass = not enableVolConfirm or nyChartVolRatio >= volConfirmMult
    nyOneMinVolPass = oneMinVolOff ? true : (oneMinVolStrict ? nyChartVolConfirmPass : nyPartialVolConfirmPass)

    // ----- NY T1 LONG 1m fire (v9.10: respects manip state machine) -----
    canFireBaseL1m = nySweepLong and nyBullPdTouched and finalLongOK and nyLongRROK and not na(nyLongTP) and not nyLongTaken
    // v9.19: Variant 1 still requires partial gates AND chosen vol mode. V2 only requires chosen vol mode.
    v1OkNyT1L = isV1ny ? (nyPartialT1BullOK and nyOneMinVolPass) : nyOneMinVolPass

    // State 0 → 1m engulf can transition state and optionally fire (1st entry)
    if nyLongEngulfState == 0 and canFireBaseL1m and nyChartT1Bull and v1OkNyT1L
        nyLongFirstEngulfHigh := high
        nyLongFirstEngulfLow := low
        nyLongFirstEngulfBar := bar_index
        nyLongEngulfState := 1
        if nyAllow1st
            fireNyLong1m := true
            nyLongTaken := true
            nyLongEngulfState := 3
            nySignalsThisSession += 1
    // State 1 → manip wick check (use chart-bar low)
    else if nyLongEngulfState == 1 and not nyLongTaken
        manipDist1m = nz(nyLongFirstEngulfLow, low) - low
        if low < nz(nyLongFirstEngulfLow, low) and manipDist1m >= effAtr * nyManipWickAtr
            nyLongEngulfState := 2
    // State 2 → 2nd engulf fires
    else if nyLongEngulfState == 2 and not nyLongTaken and nyAllow2nd and canFireBaseL1m and nyChartT1Bull and v1OkNyT1L
        fireNyLong1m := true
        nyLongTaken := true
        nyLongEngulfState := 3
        nySignalsThisSession += 1

    // ----- NY T1 SHORT 1m fire (v9.10: respects manip state machine) -----
    canFireBaseS1m = nySweepShort and nyBearPdTouched and finalShortOK and nyShortRROK and not na(nyShortTP) and not nyShortTaken
    v1OkNyT1S = isV1ny ? (nyPartialT1BearOK and nyOneMinVolPass) : nyOneMinVolPass

    if nyShortEngulfState == 0 and canFireBaseS1m and nyChartT1Bear and v1OkNyT1S
        nyShortFirstEngulfHigh := high
        nyShortFirstEngulfLow := low
        nyShortFirstEngulfBar := bar_index
        nyShortEngulfState := 1
        if nyAllow1st
            fireNyShort1m := true
            nyShortTaken := true
            nyShortEngulfState := 3
            nySignalsThisSession += 1
    else if nyShortEngulfState == 1 and not nyShortTaken
        manipDist1mS = high - nz(nyShortFirstEngulfHigh, high)
        if high > nz(nyShortFirstEngulfHigh, high) and manipDist1mS >= effAtr * nyManipWickAtr
            nyShortEngulfState := 2
    else if nyShortEngulfState == 2 and not nyShortTaken and nyAllow2nd and canFireBaseS1m and nyChartT1Bear and v1OkNyT1S
        fireNyShort1m := true
        nyShortTaken := true
        nyShortEngulfState := 3
        nySignalsThisSession += 1

    // ----- NY T2 LONG 1m fire -----
    if nySweepLong and not nyT2LongTaken and finalLongOK and not na(nyLongTP)
        nyT2RefHigh1m = nySweepLongSrc == "LL" ? londonHigh : asiaHigh
        nyT2RefLow1m  = nySweepLongSrc == "LL" ? londonLow  : asiaLow
        nyT2InRangeOK1m = not nyT2RequireSessionRetrace or (low <= nz(nyT2RefHigh1m, low) + effAtr * 0.1 and low >= nz(nyT2RefLow1m, low) - effAtr * 0.1)
        nyT2Displacement1m = math.abs(high - nySweepLongLevel)
        nyT2LongRR1m = nyLongRiskD > 0 and not na(nyLongTP) ? (nyLongTP - close) / nyLongRiskD : 0.0
        v1OkNyT2L = isV1ny ? (nyPartialT2BullOK and nyOneMinVolPass) : nyOneMinVolPass
        if nyT2InRangeOK1m and nyT2Displacement1m >= effAtr * t2DisplaceAtr and nyBullPdTouched and nyChartT2Bull and v1OkNyT2L and nyT2LongRR1m >= t2MinRR and nyT2LongRR1m <= t2MaxRR
            fireNyT2Long1m := true
            nyT2LongTaken := true
            nySignalsThisSession += 1

    // ----- NY T2 SHORT 1m fire -----
    if nySweepShort and not nyT2ShortTaken and finalShortOK and not na(nyShortTP)
        nyT2RefHigh1mS = nySweepShortSrc == "LH" ? londonHigh : asiaHigh
        nyT2RefLow1mS  = nySweepShortSrc == "LH" ? londonLow  : asiaLow
        nyT2InRangeOK1mS = not nyT2RequireSessionRetrace or (high >= nz(nyT2RefLow1mS, high) - effAtr * 0.1 and high <= nz(nyT2RefHigh1mS, high) + effAtr * 0.1)
        nyT2Displacement1mS = math.abs(nySweepShortLevel - low)
        nyT2ShortRR1m = nyShortRiskD > 0 and not na(nyShortTP) ? (close - nyShortTP) / nyShortRiskD : 0.0
        v1OkNyT2S = isV1ny ? (nyPartialT2BearOK and nyOneMinVolPass) : nyOneMinVolPass
        if nyT2InRangeOK1mS and nyT2Displacement1mS >= effAtr * t2DisplaceAtr and nyBearPdTouched and nyChartT2Bear and v1OkNyT2S and nyT2ShortRR1m >= t2MinRR and nyT2ShortRR1m <= t2MaxRR
            fireNyT2Short1m := true
            nyT2ShortTaken := true
            nySignalsThisSession += 1

    // Tag 1m NY fires
    if fireNyLong1m or fireNyShort1m or fireNyT2Long1m or fireNyT2Short1m
        lastFireTfTag := isV1ny ? "1m-V1" : "1m-V2"

// Tag 5m fires
if (fireLong or fireShort or fireT2Long or fireT2Short) and not (fireLong1m or fireShort1m or fireT2Long1m or fireT2Short1m)
    lastFireTfTag := "5m"

// Merge flags so existing label/alert pipeline picks up 1m fires
// =============================================================================
// A+ QUALITY GATE (v9.19) — CONSOLIDATED FUNCTIONS
// =============================================================================
// All scoring + gating logic wrapped in functions to keep main body under
// Pine's CE10295 limit ("main body too long"). Each function returns a tuple
// or scalar; main body has only 1-2 calls.
// =============================================================================

// Score helpers — each accesses script-scope globals directly (Pine v6 allows this)
scoreT1Long(bool fire) =>
    if not fire
        -99
    else
        int s = 0
        s += htfAllowsLong ? wHtfAligned : 0
        s += bullBodyPct >= 0.90 ? wBodyStrong : (bullBodyPct >= minBodyRatio ? 1 : 0)
        s += effVolMult >= 1.5 ? wVolStrong : (effVolMult >= volConfirmMult ? 1 : 0)
        s += fireLong2nd ? wManipPassed : 0
        s += longActualRR >= 4.0 ? wRrStrong : (longActualRR >= 3.0 ? 1 : 0)
        s -= asiaTooWide ? wAsiaWidePenalty : 0
        s

scoreT1Short(bool fire) =>
    if not fire
        -99
    else
        int s = 0
        s += htfAllowsShort ? wHtfAligned : 0
        s += bearBodyPct >= 0.90 ? wBodyStrong : (bearBodyPct >= minBodyRatio ? 1 : 0)
        s += effVolMult >= 1.5 ? wVolStrong : (effVolMult >= volConfirmMult ? 1 : 0)
        s += fireShort2nd ? wManipPassed : 0
        s += shortActualRR >= 4.0 ? wRrStrong : (shortActualRR >= 3.0 ? 1 : 0)
        s -= asiaTooWide ? wAsiaWidePenalty : 0
        s

scoreT2Long(bool fire) =>
    if not fire
        -99
    else
        int s = 0
        s += htfAllowsLong ? wHtfAligned : 0
        s += bullBodyPct >= 0.85 ? wBodyStrong : (bullBodyPct >= t2BodyRatio ? 1 : 0)
        s += effVolMult >= 1.5 ? wVolStrong : (effVolMult >= volConfirmMult ? 1 : 0)
        t2LongDispAtr = atr14 > 0 and not na(sweptLongLevel) and not na(t2LongMaxDown) ? (t2LongMaxDown - sweptLongLevel) / atr14 : 0.0
        s += t2LongDispAtr >= 2.0 ? wDisplaceStrong : (t2LongDispAtr >= t2DisplaceAtr ? 1 : 0)
        pdDeepL = not na(t2LongTargetZoneTop) and not na(t2LongTargetZoneBot) and (t2LongTargetZoneTop > t2LongTargetZoneBot) and (low - t2LongTargetZoneBot) / (t2LongTargetZoneTop - t2LongTargetZoneBot) <= 0.30
        s += pdDeepL ? wPdDeep : 0
        s += t2LongRR >= 4.0 ? wRrStrong : (t2LongRR >= 3.0 ? 1 : 0)
        s -= asiaTooWide ? math.round(wAsiaWidePenalty / 2) : 0
        s

scoreT2Short(bool fire) =>
    if not fire
        -99
    else
        int s = 0
        s += htfAllowsShort ? wHtfAligned : 0
        s += bearBodyPct >= 0.85 ? wBodyStrong : (bearBodyPct >= t2BodyRatio ? 1 : 0)
        s += effVolMult >= 1.5 ? wVolStrong : (effVolMult >= volConfirmMult ? 1 : 0)
        t2ShortDispAtr = atr14 > 0 and not na(sweptShortLevel) and not na(t2ShortMaxUp) ? (sweptShortLevel - t2ShortMaxUp) / atr14 : 0.0
        s += t2ShortDispAtr >= 2.0 ? wDisplaceStrong : (t2ShortDispAtr >= t2DisplaceAtr ? 1 : 0)
        pdDeepS = not na(t2ShortTargetZoneTop) and not na(t2ShortTargetZoneBot) and (t2ShortTargetZoneTop > t2ShortTargetZoneBot) and (t2ShortTargetZoneTop - high) / (t2ShortTargetZoneTop - t2ShortTargetZoneBot) <= 0.30
        s += pdDeepS ? wPdDeep : 0
        s += t2ShortRR >= 4.0 ? wRrStrong : (t2ShortRR >= 3.0 ? 1 : 0)
        s -= asiaTooWide ? math.round(wAsiaWidePenalty / 2) : 0
        s

gradeFromScore(int score) =>
    score >= 10 ? "A+" : score >= 8 ? "A" : score >= 6 ? "B" : score >= 5 ? "C" : "D"

// Master gate — computes raw flags, scores, and gating in one shot
// Returns: gated 4 flags + bestScore + conflictResolved + activeFlags + raw 4 flags
runQualityGate(string mode, int minScore) =>
    rawL   = fireLong or fireLong1m or fireNyLong or fireNyLong1m
    rawS   = fireShort or fireShort1m or fireNyShort or fireNyShort1m
    rawT2L = fireT2Long or fireT2Long1m or fireNyT2Long or fireNyT2Long1m
    rawT2S = fireT2Short or fireT2Short1m or fireNyT2Short or fireNyT2Short1m
    bool isQ = mode == "A+ Quality Gate (rank both, fire best)"
    bool isP = mode == "T1 Priority (block opposite-direction T2)"
    int sL = scoreT1Long(rawL)
    int sS = scoreT1Short(rawS)
    int sT2L = scoreT2Long(rawT2L)
    int sT2S = scoreT2Short(rawT2S)
    int best = math.max(math.max(sL, sS), math.max(sT2L, sT2S))
    bool gL = rawL
    bool gS = rawS
    bool gT2L = rawT2L
    bool gT2S = rawT2S
    if isQ
        if best < minScore
            gL := false
            gS := false
            gT2L := false
            gT2S := false
        else
            anyConflict = (rawL ? 1 : 0) + (rawS ? 1 : 0) + (rawT2L ? 1 : 0) + (rawT2S ? 1 : 0) > 1
            if anyConflict
                gL := sL == best
                gS := sS == best and not gL
                gT2L := sT2L == best and not gL and not gS
                gT2S := sT2S == best and not gL and not gS and not gT2L
    else if isP
        if rawL and rawT2S
            gT2S := false
        if rawS and rawT2L
            gT2L := false
    rawCount = (rawL ? 1 : 0) + (rawS ? 1 : 0) + (rawT2L ? 1 : 0) + (rawT2S ? 1 : 0)
    gatedCount = (gL ? 1 : 0) + (gS ? 1 : 0) + (gT2L ? 1 : 0) + (gT2S ? 1 : 0)
    bool resolved = (isQ or isP) and rawCount > gatedCount
    bool anyRaw = rawL or rawS or rawT2L or rawT2S
    [gL, gS, gT2L, gT2S, best, resolved, isQ, isP, anyRaw]

// === Single call from main body (minimal expressions) ===
[fireLongAny, fireShortAny, fireT2LongAny, fireT2ShortAny, bestScore, conflictResolvedNow, modeQualityGate, modeT1Priority, anyRawFire] = runQualityGate(conflictMode, qualityMinScore)

// Persist quality state across bars
var int lastQualityScore = 0
var string lastQualityGrade = ""
var bool lastConflictResolved = false
if (modeQualityGate or modeT1Priority) and anyRawFire
    lastQualityScore := bestScore
    lastQualityGrade := gradeFromScore(bestScore)
    lastConflictResolved := conflictResolvedNow

// =============================================================================
// SL OVERRIDE FOR 1M FIRES (v9.7)
// =============================================================================
// When 1m fires the trade, recompute SL based on user's chosen source.
oneMinUseChart = oneMinSlSrc == "1m engulf low/high (tighter, best RR)"
oneMinUseLogic = oneMinSlSrc == "5m engulf low/high (safer, wider)"
oneMinUseSmart = oneMinSlSrc == "Use Smart SL Chain (same as 5m)"

// For long 1m fires: pick low based on choice
oneMinLongSL_chart = low - slBuffer * syminfo.mintick
oneMinLongSL_logic = effLow - slBuffer * syminfo.mintick
oneMinShortSL_chart = high + slBuffer * syminfo.mintick
oneMinShortSL_logic = effHigh + slBuffer * syminfo.mintick

// Apply override when a 1m fire occurred
finalLongSL  = fireLong1m  and oneMinUseChart ? oneMinLongSL_chart  : fireLong1m  and oneMinUseLogic ? oneMinLongSL_logic  : longCandidateSL
finalShortSL = fireShort1m and oneMinUseChart ? oneMinShortSL_chart : fireShort1m and oneMinUseLogic ? oneMinShortSL_logic : shortCandidateSL
finalT2LongSL  = fireT2Long1m  and oneMinUseChart ? oneMinLongSL_chart  : fireT2Long1m  and oneMinUseLogic ? oneMinLongSL_logic  : t2LongSL
finalT2ShortSL = fireT2Short1m and oneMinUseChart ? oneMinShortSL_chart : fireT2Short1m and oneMinUseLogic ? oneMinShortSL_logic : t2ShortSL

// SL source string — when 1m chart-low is used, label says "(1m engulf)"
finalLongSlSrc = fireLong1m and oneMinUseChart ? "1m engulf" : fireLong1m and oneMinUseLogic ? "5m engulf" : longSlSrc
finalShortSlSrc = fireShort1m and oneMinUseChart ? "1m engulf" : fireShort1m and oneMinUseLogic ? "5m engulf" : shortSlSrc
finalT2LongSlSrc = fireT2Long1m and oneMinUseChart ? "1m engulf" : fireT2Long1m and oneMinUseLogic ? "5m engulf" : t2LongSlSrc
finalT2ShortSlSrc = fireT2Short1m and oneMinUseChart ? "1m engulf" : fireT2Short1m and oneMinUseLogic ? "5m engulf" : t2ShortSlSrc

// =============================================================================
// ENTRY LABELS
// =============================================================================
// v9.2: Stars removed — cleaner labels
// v9.19: Quality score badge for all entry labels
qualBadge = ""

if fireLongAny
    isNyFireL = fireNyLong or fireNyLong1m
    slP = isNyFireL ? nyLongSL : finalLongSL
    tpP = isNyFireL ? nyLongTP : longCandidateTP
    nyTag = isNyFireL ? " [NY]" : ""
    tfTag = lastFireTfTag != "5m" and lastFireTfTag != "" ? " {" + lastFireTfTag + "}" : ""
    sweptSrcDisplay = isNyFireL ? nySweepLongSrc : sweptLongSrc
    slSrcDisplay = isNyFireL ? nyLongSlSrc : finalLongSlSrc
    tpSrcDisplay = isNyFireL ? nyLongTpSrc : longTpSrc
    rrDisplay = isNyFireL ? nyLongActualRR : longActualRR
    entryLabel = fireLong2nd ? "▲ LONG T1 [2nd]" + nyTag + " " + profileLabelTag + tfTag : "▲ LONG T1 [1st]" + nyTag + " " + profileLabelTag + tfTag
    entryColor = isNyFireL ? color.new(#ff6f00, 50) : fireLong2nd ? color.new(#00e676, 50) : color.new(bullColor, 50)
    warnBadge = asiaTooWide ? "\n⚠ ASIA WIDE" : ""
    manipBadge = (fireLong2nd and not isNyFireL) ? "\n✓ AFTER MANIPULATION" : (isNyFireL and nyLongFiredAs2nd) ? "\n✓ AFTER MANIPULATION (NY)" : ""
    tpSrcTxt = tpSrcDisplay != "" ? " @" + tpSrcDisplay : ""
    slSrcTxt = slShowSrcInLabel and slSrcDisplay != "" ? " (" + slSrcDisplay + ")" : ""
    if showLabels and (not isNyFireL or showNyEntryLabels)
        label.new(bar_index, low, entryLabel + " [" + pathLong + "]\n" + sweptSrcDisplay + " Swept\nSL: " + str.tostring(slP, format.mintick) + slSrcTxt + "\nTP: " + str.tostring(tpP, format.mintick) + tpSrcTxt + "\n" + str.tostring(rrDisplay, "#.##") + "R" + manipBadge + warnBadge + qualBadge, color = entryColor, textcolor = color.white, style = label.style_label_up, size = size.tiny)
    if showRrBox
        box.new(bar_index, close, bar_index + 25, tpP, bgcolor = color.new(bullColor, 85), border_color = color.new(bullColor, 40))
        box.new(bar_index, slP, bar_index + 25, close, bgcolor = color.new(bearColor, 85), border_color = color.new(bearColor, 40))

// T1 Long: signal-only (use TradingView alerts to fire to broker)

if fireShortAny
    isNyFireS = fireNyShort or fireNyShort1m
    slP = isNyFireS ? nyShortSL : finalShortSL
    tpP = isNyFireS ? nyShortTP : shortCandidateTP
    nyTag = isNyFireS ? " [NY]" : ""
    tfTag = lastFireTfTag != "5m" and lastFireTfTag != "" ? " {" + lastFireTfTag + "}" : ""
    sweptSrcDisplay = isNyFireS ? nySweepShortSrc : sweptShortSrc
    slSrcDisplay = isNyFireS ? nyShortSlSrc : finalShortSlSrc
    tpSrcDisplay = isNyFireS ? nyShortTpSrc : shortTpSrc
    rrDisplay = isNyFireS ? nyShortActualRR : shortActualRR
    entryLabel = fireShort2nd ? "▼ SHORT T1 [2nd]" + nyTag + " " + profileLabelTag + tfTag : "▼ SHORT T1 [1st]" + nyTag + " " + profileLabelTag + tfTag
    entryColor = isNyFireS ? color.new(#ff6f00, 50) : fireShort2nd ? color.new(#ff1744, 50) : color.new(bearColor, 50)
    warnBadge = asiaTooWide ? "\n⚠ ASIA WIDE" : ""
    manipBadge = (fireShort2nd and not isNyFireS) ? "\n✓ AFTER MANIPULATION" : (isNyFireS and nyShortFiredAs2nd) ? "\n✓ AFTER MANIPULATION (NY)" : ""
    tpSrcTxt = tpSrcDisplay != "" ? " @" + tpSrcDisplay : ""
    slSrcTxt = slShowSrcInLabel and slSrcDisplay != "" ? " (" + slSrcDisplay + ")" : ""
    if showLabels and (not isNyFireS or showNyEntryLabels)
        label.new(bar_index, high, entryLabel + " [" + pathShort + "]\n" + sweptSrcDisplay + " Swept\nSL: " + str.tostring(slP, format.mintick) + slSrcTxt + "\nTP: " + str.tostring(tpP, format.mintick) + tpSrcTxt + "\n" + str.tostring(rrDisplay, "#.##") + "R" + manipBadge + warnBadge + qualBadge, color = entryColor, textcolor = color.white, style = label.style_label_down, size = size.tiny)
    if showRrBox
        box.new(bar_index, tpP, bar_index + 25, close, bgcolor = color.new(bullColor, 85), border_color = color.new(bullColor, 40))
        box.new(bar_index, close, bar_index + 25, slP, bgcolor = color.new(bearColor, 85), border_color = color.new(bearColor, 40))

// T1 Short: signal-only (use TradingView alerts to fire to broker)

// T2 LONG label
if fireT2LongAny
    isNyFireT2L = fireNyT2Long or fireNyT2Long1m
    slP = isNyFireT2L ? nyLongSL : finalT2LongSL
    tpP = isNyFireT2L ? nyLongTP : t2LongTP
    nyTag = isNyFireT2L ? " [NY]" : ""
    tfTag = lastFireTfTag != "5m" and lastFireTfTag != "" ? " {" + lastFireTfTag + "}" : ""
    sweptSrcDisplayT2L = isNyFireT2L ? nySweepShortSrc : "AH"  // T2 LONG = AH/LH was swept
    refRangeName = isNyFireT2L ? (nySweepShortSrc == "LH" ? "London" : "Asia") : "Asia"
    slSrcDisplayT2L = isNyFireT2L ? nyLongSlSrc : finalT2LongSlSrc
    tpSrcDisplayT2L = isNyFireT2L ? nyLongTpSrc : t2LongTpSrc
    rrDisplayT2L = isNyFireT2L ? (nyLongRiskD > 0 and not na(nyLongTP) ? (nyLongTP - close) / nyLongRiskD : 0.0) : t2LongRR
    entryColor = isNyFireT2L ? color.new(#ff9100, 50) : color.new(#00bcd4, 50)
    warnBadge = asiaTooWide ? "\n⚠ ASIA WIDE" : ""
    tpSrcTxt = tpSrcDisplayT2L != "" ? " @" + tpSrcDisplayT2L : ""
    slSrcTxt = slShowSrcInLabel and slSrcDisplayT2L != "" ? " (" + slSrcDisplayT2L + ")" : ""
    if showLabels and (not isNyFireT2L or showNyEntryLabels)
        label.new(bar_index, low, "▲ LONG T2 [AMD]" + nyTag + " " + profileLabelTag + tfTag + "\nSwept " + sweptSrcDisplayT2L + " → Retrace\n@" + t2LongZoneSrc + " in " + refRangeName + "\nSL: " + str.tostring(slP, format.mintick) + slSrcTxt + "\nTP: " + str.tostring(tpP, format.mintick) + tpSrcTxt + "\n" + str.tostring(rrDisplayT2L, "#.##") + "R" + warnBadge + qualBadge, color = entryColor, textcolor = color.white, style = label.style_label_up, size = size.tiny)
    if showRrBox
        box.new(bar_index, close, bar_index + 25, tpP, bgcolor = color.new(bullColor, 85), border_color = color.new(bullColor, 40))
        box.new(bar_index, slP, bar_index + 25, close, bgcolor = color.new(bearColor, 85), border_color = color.new(bearColor, 40))

// T2 Long: signal-only (use TradingView alerts to fire to broker)

// T2 SHORT label
if fireT2ShortAny
    isNyFireT2S = fireNyT2Short or fireNyT2Short1m
    slP = isNyFireT2S ? nyShortSL : finalT2ShortSL
    tpP = isNyFireT2S ? nyShortTP : t2ShortTP
    nyTag = isNyFireT2S ? " [NY]" : ""
    tfTag = lastFireTfTag != "5m" and lastFireTfTag != "" ? " {" + lastFireTfTag + "}" : ""
    sweptSrcDisplayT2S = isNyFireT2S ? nySweepLongSrc : "AL"
    refRangeNameS = isNyFireT2S ? (nySweepLongSrc == "LL" ? "London" : "Asia") : "Asia"
    slSrcDisplayT2S = isNyFireT2S ? nyShortSlSrc : finalT2ShortSlSrc
    tpSrcDisplayT2S = isNyFireT2S ? nyShortTpSrc : t2ShortTpSrc
    rrDisplayT2S = isNyFireT2S ? (nyShortRiskD > 0 and not na(nyShortTP) ? (close - nyShortTP) / nyShortRiskD : 0.0) : t2ShortRR
    entryColor = isNyFireT2S ? color.new(#ff9100, 50) : color.new(#e91e63, 50)
    warnBadge = asiaTooWide ? "\n⚠ ASIA WIDE" : ""
    tpSrcTxt = tpSrcDisplayT2S != "" ? " @" + tpSrcDisplayT2S : ""
    slSrcTxt = slShowSrcInLabel and slSrcDisplayT2S != "" ? " (" + slSrcDisplayT2S + ")" : ""
    if showLabels and (not isNyFireT2S or showNyEntryLabels)
        label.new(bar_index, high, "▼ SHORT T2 [AMD]" + nyTag + " " + profileLabelTag + tfTag + "\nSwept " + sweptSrcDisplayT2S + " → Retrace\n@" + t2ShortZoneSrc + " in " + refRangeNameS + "\nSL: " + str.tostring(slP, format.mintick) + slSrcTxt + "\nTP: " + str.tostring(tpP, format.mintick) + tpSrcTxt + "\n" + str.tostring(rrDisplayT2S, "#.##") + "R" + warnBadge + qualBadge, color = entryColor, textcolor = color.white, style = label.style_label_down, size = size.tiny)
    if showRrBox
        box.new(bar_index, tpP, bar_index + 25, close, bgcolor = color.new(bullColor, 85), border_color = color.new(bullColor, 40))
        box.new(bar_index, close, bar_index + 25, slP, bgcolor = color.new(bearColor, 85), border_color = color.new(bearColor, 40))

// T2 Short: signal-only (use TradingView alerts to fire to broker)

// =============================================================================
// TRADE OUTCOME TRACKING (v9.23) — Detect SL/TP hit after each FIRED trade
// =============================================================================
// After a trade fires, price is tracked on every subsequent bar.
// When SL or TP is hit → record result, draw label, update monthly stats, send webhook.
// If both SL and TP are hit on the same bar → counts as LOSS (conservative).

// --- Function: resolve trade details for the fired signal ---
getOutcomeDetails() =>
    string dir = ""
    string typ = ""
    string sess = ""
    float sl = na
    float tp = na
    float rr = na
    if fireLongAny
        isNyL = fireNyLong or fireNyLong1m
        dir  := "LONG"
        typ  := fireLong2nd ? "T1 LONG (2nd)" : "T1 LONG (1st)"
        sess := isNyL ? "NY" : "London"
        sl   := isNyL ? nyLongSL : finalLongSL
        tp   := isNyL ? nyLongTP : longCandidateTP
        rr   := isNyL ? nyLongActualRR : longActualRR
    else if fireShortAny
        isNyS = fireNyShort or fireNyShort1m
        dir  := "SHORT"
        typ  := fireShort2nd ? "T1 SHORT (2nd)" : "T1 SHORT (1st)"
        sess := isNyS ? "NY" : "London"
        sl   := isNyS ? nyShortSL : finalShortSL
        tp   := isNyS ? nyShortTP : shortCandidateTP
        rr   := isNyS ? nyShortActualRR : shortActualRR
    else if fireT2LongAny
        isNyT2L = fireNyT2Long or fireNyT2Long1m
        dir  := "LONG"
        typ  := "T2 LONG (AMD)"
        sess := isNyT2L ? "NY" : "London"
        sl   := isNyT2L ? nyLongSL : finalT2LongSL
        tp   := isNyT2L ? nyLongTP : t2LongTP
        rr   := isNyT2L ? (nyLongRiskD > 0 and not na(nyLongTP) ? (nyLongTP - close) / nyLongRiskD : 0.0) : t2LongRR
    else if fireT2ShortAny
        isNyT2S = fireNyT2Short or fireNyT2Short1m
        dir  := "SHORT"
        typ  := "T2 SHORT (AMD)"
        sess := isNyT2S ? "NY" : "London"
        sl   := isNyT2S ? nyShortSL : finalT2ShortSL
        tp   := isNyT2S ? nyShortTP : t2ShortTP
        rr   := isNyT2S ? (nyShortRiskD > 0 and not na(nyShortTP) ? (close - nyShortTP) / nyShortRiskD : 0.0) : t2ShortRR
    [dir, typ, sess, sl, tp, rr]

// --- Function: check SL/TP hit, update stats, draw label, send webhook ---
checkOutcomeHit() =>
    bool hit = false
    string res = ""
    float exitPx = na
    float rrAch = na
    if outcomeActive and bar_index > outcomeFireBar and not na(outcomeSL) and not na(outcomeTP)
        bool slHit = false
        bool tpHit = false
        if outcomeDir == "LONG"
            slHit := low <= outcomeSL
            tpHit := high >= outcomeTP
        else
            slHit := high >= outcomeSL
            tpHit := low <= outcomeTP
        if slHit or tpHit
            hit := true
            if tpHit and not slHit
                res   := "WIN"
                exitPx := outcomeTP
                rrAch  := outcomeRR
            else if slHit and outcomeBEMoved
                res   := "BE"
                exitPx := outcomeEntry
                rrAch  := 0.0
            else
                res   := "LOSS"
                exitPx := outcomeSL
                rrAch  := -1.0
            // Update monthly stats
            int mKey = year(time) * 100 + month(time)
            int mIdx = array.indexof(mStatKeys, mKey)
            if mIdx == -1
                array.push(mStatKeys, mKey)
                array.push(mStatWins, res == "WIN" ? 1 : 0)
                array.push(mStatLosses, res == "LOSS" ? 1 : 0)
                array.push(mStatR, rrAch)
            else
                if res == "WIN"
                    array.set(mStatWins, mIdx, array.get(mStatWins, mIdx) + 1)
                else if res == "LOSS"
                    array.set(mStatLosses, mIdx, array.get(mStatLosses, mIdx) + 1)
                array.set(mStatR, mIdx, array.get(mStatR, mIdx) + rrAch)
            // Update yearly stats
            int yKey = year(time)
            int yIdx = array.indexof(yStatKeys, yKey)
            if yIdx == -1
                array.push(yStatKeys, yKey)
                array.push(yStatWins, res == "WIN" ? 1 : 0)
                array.push(yStatLosses, res == "LOSS" ? 1 : 0)
                array.push(yStatR, rrAch)
            else
                if res == "WIN"
                    array.set(yStatWins, yIdx, array.get(yStatWins, yIdx) + 1)
                else if res == "LOSS"
                    array.set(yStatLosses, yIdx, array.get(yStatLosses, yIdx) + 1)
                array.set(yStatR, yIdx, array.get(yStatR, yIdx) + rrAch)
            // Draw result label on chart
            if showLabels
                resultTxt = res == "WIN" ? "✅ TP +" + str.tostring(rrAch, "#.#") + "R" : res == "BE" ? "🔒 BE 0R" : "❌ SL -1R"
                resultCol = res == "WIN" ? color.new(#00e676, 30) : res == "BE" ? color.new(color.orange, 30) : color.new(#ff1744, 30)
                labelY = res == "WIN" ? outcomeTP : outcomeSL
                labelStyle = outcomeDir == "LONG" ? (res == "WIN" ? label.style_label_down : label.style_label_up) : (res == "WIN" ? label.style_label_up : label.style_label_down)
                label.new(bar_index, labelY, resultTxt, color = resultCol, textcolor = color.white, style = labelStyle, size = size.tiny)
            // Send outcome webhook
            if enableJsonAlerts
                string rJson = "{"
                rJson += "\"secret\":\"" + webhookSecret + "\","
                rJson += "\"event\":\"trade_result\","
                rJson += "\"symbol\":\"" + syminfo.ticker + "\","
                rJson += "\"side\":\"" + outcomeDir + "\","
                rJson += "\"trade\":\"" + outcomeType + "\","
                rJson += "\"session\":\"" + outcomeSess + "\","
                rJson += "\"result\":\"" + res + "\","
                rJson += "\"entry\":" + str.tostring(outcomeEntry) + ","
                rJson += "\"sl\":" + str.tostring(outcomeSL) + ","
                rJson += "\"tp\":" + str.tostring(outcomeTP) + ","
                rJson += "\"exit\":" + str.tostring(exitPx) + ","
                rJson += "\"rr_planned\":" + str.tostring(outcomeRR, "#.##") + ","
                rJson += "\"rr_achieved\":" + str.tostring(rrAch, "#.#") + ","
                rJson += "\"be_moved\":" + (outcomeBEMoved ? "true" : "false") + ","
                rJson += "\"version\":\"9.23\""
                rJson += "}"
                alert(rJson, alert.freq_once_per_bar)
    [hit, res, exitPx, rrAch]

// --- Capture (main body: minimal) ---
anyFireForOutcome = fireLongAny or fireShortAny or fireT2LongAny or fireT2ShortAny
[oDir, oType, oSess, oSL, oTP, oRR] = getOutcomeDetails()
if anyFireForOutcome
    outcomeActive  := true
    outcomeBEMoved := false
    outcomeEntry   := close
    outcomeFireBar := bar_index
    outcomeDir  := oDir
    outcomeType := oType
    outcomeSess := oSess
    outcomeSL   := oSL
    outcomeTP   := oTP
    outcomeRR   := oRR

// --- Auto SL → BE when price moves X R in profit ---
if outcomeActive and not outcomeBEMoved and enableBEMove and bar_index > outcomeFireBar and not na(outcomeSL) and not na(outcomeEntry)
    float riskDist = math.abs(outcomeEntry - outcomeSL)
    float beTarget = outcomeDir == "LONG" ? outcomeEntry + beThresholdR * riskDist : outcomeEntry - beThresholdR * riskDist
    bool beReached = outcomeDir == "LONG" ? high >= beTarget : low <= beTarget
    if beReached
        outcomeSL      := outcomeEntry
        outcomeBEMoved := true
        if showLabels
            label.new(bar_index, outcomeEntry, "🔒 BE", color = color.new(color.orange, 30), textcolor = color.white, style = outcomeDir == "LONG" ? label.style_label_up : label.style_label_down, size = size.tiny)

// --- Detect outcome (main body: minimal) ---
[outcomeHit, outcomeResult, outcomeExitPrice, outcomeRRAchieved] = checkOutcomeHit()
if outcomeHit
    outcomeActive := false

// =============================================================================
// LIVE WATCH PANEL
// =============================================================================
getLongState() =>
    if longTakenThisSession
        "✓ FIRED"
    else if not inLondonExt
        "— waiting London"
    else if noSweepBlock
        "✗ NO SWEEP"
    else if not sweptLong
        "⏳ waiting sweep"
    else if not longSetupAlive
        "✗ TIMED OUT"
    else if not bullPdTouched
        "⏳ waiting PD touch"
    else if longEngulfState == 1
        "⚠ watching manip"
    else if longEngulfState == 2
        "● ARMED 2nd"
    else if not candleValidLong
        enableLowVolFilter and not lowVolPass ? "⏳ low vol" : "⏳ waiting engulf"
    else if not finalLongOK
        "✗ HTF blocks"
    else if not longRROK
        "✗ RR too low"
    else
        "● READY"

getShortState() =>
    if shortTakenThisSession
        "✓ FIRED"
    else if not inLondonExt
        "— waiting London"
    else if noSweepBlock
        "✗ NO SWEEP"
    else if not sweptShort
        "⏳ waiting sweep"
    else if not shortSetupAlive
        "✗ TIMED OUT"
    else if not bearPdTouched
        "⏳ waiting PD touch"
    else if shortEngulfState == 1
        "⚠ watching manip"
    else if shortEngulfState == 2
        "● ARMED 2nd"
    else if not candleValidShort
        enableLowVolFilter and not lowVolPass ? "⏳ low vol" : "⏳ waiting engulf"
    else if not finalShortOK
        "✗ HTF blocks"
    else if not shortRROK
        "✗ RR too low"
    else
        "● READY"

getStateColor(stateStr) =>
    if str.contains(stateStr, "FIRED")
        color.yellow
    else if str.contains(stateStr, "READY") or str.contains(stateStr, "ARMED")
        color.lime
    else if str.contains(stateStr, "⚠") or str.contains(stateStr, "manip")
        color.new(#ff9800, 0)
    else if str.contains(stateStr, "✗")
        color.new(color.red, 30)
    else if str.contains(stateStr, "⏳")
        color.orange
    else
        color.gray

longStateText = getLongState()
shortStateText = getShortState()

// T2 state text helpers
getT2LongState() =>
    if not enableT2
        "— disabled"
    else if t2LongTaken
        "✓ FIRED"
    else if t2LongBlockedNextLiq
        "✗ AL swept too"
    else if not finalLongOK
        "— bias blocks"
    else if not inLondonExt
        "— waiting London"
    else if t2LongState == 0
        "⏳ waiting AH sweep"
    else if t2LongState == 1
        "⏳ waiting displacement"
    else if t2LongState == 2
        "⏳ waiting retrace"
    else if t2LongState == 3
        not t2StrongBullCandle ? "⏳ waiting engulf" : not t2LongRROK ? "✗ RR too low" : "● READY"
    else
        "—"

getT2ShortState() =>
    if not enableT2
        "— disabled"
    else if t2ShortTaken
        "✓ FIRED"
    else if t2ShortBlockedNextLiq
        "✗ AH swept too"
    else if not finalShortOK
        "— bias blocks"
    else if not inLondonExt
        "— waiting London"
    else if t2ShortState == 0
        "⏳ waiting AL sweep"
    else if t2ShortState == 1
        "⏳ waiting displacement"
    else if t2ShortState == 2
        "⏳ waiting retrace"
    else if t2ShortState == 3
        not t2StrongBearCandle ? "⏳ waiting engulf" : not t2ShortRROK ? "✗ RR too low" : "● READY"
    else
        "—"

t2LongStateText = getT2LongState()
t2ShortStateText = getT2ShortState()

// v9.18: NY-engine state text helpers for Live Watch (separate LONG/SHORT for T1 and T2)
// These mirror the same logic that the right-side dashboard uses, but split per direction.
nyT1LongText = (fireNyLong or fireNyLong1m) ? "▲ NY T1 LONG FIRED" + (nyLongFiredAs2nd ? " (2nd)" : "") : nyLongEngulfState == 1 ? "⏳ NY watching" : nyLongEngulfState == 2 ? "● NY armed" : nyLongTaken ? "✓ NY Long taken" : inNY ? "— waiting NY" : "—"
nyT1LongCol  = (fireNyLong or fireNyLong1m) ? bullColor : nyLongTaken ? color.yellow : nyLongEngulfState >= 1 ? color.orange : color.gray

nyT1ShortText = (fireNyShort or fireNyShort1m) ? "▼ NY T1 SHORT FIRED" + (nyShortFiredAs2nd ? " (2nd)" : "") : nyShortEngulfState == 1 ? "⏳ NY watching" : nyShortEngulfState == 2 ? "● NY armed" : nyShortTaken ? "✓ NY Short taken" : inNY ? "— waiting NY" : "—"
nyT1ShortCol  = (fireNyShort or fireNyShort1m) ? bearColor : nyShortTaken ? color.yellow : nyShortEngulfState >= 1 ? color.orange : color.gray

nyT2LongText = (fireNyT2Long or fireNyT2Long1m) ? "▲ NY T2 LONG FIRED" : nyT2LongTaken ? "✓ NY T2 Long taken" : inNY ? "— waiting NY" : "—"
nyT2LongCol  = (fireNyT2Long or fireNyT2Long1m) ? color.new(#00bcd4, 0) : nyT2LongTaken ? color.yellow : color.gray

nyT2ShortText = (fireNyT2Short or fireNyT2Short1m) ? "▼ NY T2 SHORT FIRED" : nyT2ShortTaken ? "✓ NY T2 Short taken" : inNY ? "— waiting NY" : "—"
nyT2ShortCol  = (fireNyT2Short or fireNyT2Short1m) ? color.new(#e91e63, 0) : nyT2ShortTaken ? color.yellow : color.gray

// v9.18: Asia sweep info (for Live Watch display under NY-time)
asiaSweepInfoTxt = asiaHighSweptToday and asiaLowSweptToday ? "✓ AH + AL swept" : asiaHighSweptToday ? "✓ AH swept" : asiaLowSweptToday ? "✓ AL swept" : "— not yet"
asiaSweepInfoCol = asiaHighSweptToday or asiaLowSweptToday ? color.new(color.red, 0) : color.gray

var table watch = table.new(position.middle_left, 2, 9, bgcolor = color.new(color.black, 80), border_width = 2, border_color = color.new(color.yellow, 50))

if showWatchPanel and barstate.islast
    table.cell(watch, 0, 0, "◆ LIVE WATCH", bgcolor = color.new(#2980b9, 10), text_color = color.white, text_size = size.normal)
    table.cell(watch, 1, 0, sessionName, bgcolor = color.new(#2980b9, 10), text_color = inLondonExt ? color.yellow : color.gray, text_size = size.normal)

    table.cell(watch, 0, 1, "T1 LONG", text_color = bullColor, text_size = size.small)
    table.cell(watch, 1, 1, inNY ? nyT1LongText : longStateText, text_color = inNY ? nyT1LongCol : getStateColor(longStateText), text_size = size.small)

    table.cell(watch, 0, 2, "T1 SHORT", text_color = bearColor, text_size = size.small)
    table.cell(watch, 1, 2, inNY ? nyT1ShortText : shortStateText, text_color = inNY ? nyT1ShortCol : getStateColor(shortStateText), text_size = size.small)

    table.cell(watch, 0, 3, "T2 LONG", text_color = color.new(#00bcd4, 0), text_size = size.small)
    table.cell(watch, 1, 3, inNY ? nyT2LongText : t2LongStateText, text_color = inNY ? nyT2LongCol : getStateColor(t2LongStateText), text_size = size.small)

    table.cell(watch, 0, 4, "T2 SHORT", text_color = color.new(#e91e63, 0), text_size = size.small)
    table.cell(watch, 1, 4, inNY ? nyT2ShortText : t2ShortStateText, text_color = inNY ? nyT2ShortCol : getStateColor(t2ShortStateText), text_size = size.small)

    asiaWarn = asiaTicksBlock ? "✗ BLOCKED" : asiaHuge ? "⚠⚠ HUGE" : asiaTooWide ? "⚠ WIDE" : "OK"
    asiaWarnCol = asiaTicksBlock ? color.red : asiaHuge ? color.red : asiaTooWide ? color.orange : color.gray
    table.cell(watch, 0, 5, "Asia Range", text_color = color.white, text_size = size.tiny)
    table.cell(watch, 1, 5, asiaWarn, text_color = asiaWarnCol, text_size = size.tiny)

    // v9.3: Sweep Memory row (Asia rule enforcement under London)
    // v9.18: Under NY-time this row shows London H/L sweep info instead
    sweepMemTxt = inNY ? (londonHighSweptToday and londonLowSweptToday ? "✓ LH + LL swept" : londonHighSweptToday ? "✓ LH swept" : londonLowSweptToday ? "✓ LL swept" : "— not yet") : (t1LongOppositeBlock ? "✗ AH already swept" : t1ShortOppositeBlock ? "✗ AL already swept" : "OK")
    sweepMemCol = inNY ? (londonHighSweptToday or londonLowSweptToday ? color.new(color.blue, 0) : color.gray) : (t1LongOppositeBlock or t1ShortOppositeBlock ? color.red : color.gray)
    table.cell(watch, 0, 6, "Sweep Mem", text_color = color.white, text_size = size.tiny)
    table.cell(watch, 1, 6, sweepMemTxt, text_color = sweepMemCol, text_size = size.tiny)

    // v9.18: London Sweep row swaps to Asia info under NY-time
    londonSweepTxt = inNY ? asiaSweepInfoTxt : (londonHighSweptToday and londonLowSweptToday ? "✓ LH + LL swept" : londonHighSweptToday ? "✓ LH swept" : londonLowSweptToday ? "✓ LL swept" : "— not yet")
    londonSweepCol = inNY ? asiaSweepInfoCol : (londonHighSweptToday or londonLowSweptToday ? color.new(color.blue, 0) : color.gray)
    table.cell(watch, 0, 7, "London Sweep", text_color = color.white, text_size = size.tiny)
    table.cell(watch, 1, 7, londonSweepTxt, text_color = londonSweepCol, text_size = size.tiny)

    sigLimitTxt = inNY ? (nyMaxSignals > 0 ? str.tostring(nySignalsThisSession) + "/" + str.tostring(nyMaxSignals) : str.tostring(nySignalsThisSession) + " (no limit)") : (maxSignalsPerSession > 0 ? str.tostring(signalsThisSession) + "/" + str.tostring(maxSignalsPerSession) : str.tostring(signalsThisSession) + " (no limit)")
    sigLimitCol = inNY ? (nySessionLimitHit ? color.red : nySignalsThisSession > 0 ? color.yellow : color.gray) : (sessionLimitHit ? color.red : signalsThisSession > 0 ? color.yellow : color.gray)
    table.cell(watch, 0, 8, "Signals", text_color = color.white, text_size = size.tiny)
    table.cell(watch, 1, 8, sigLimitTxt, text_color = sigLimitCol, text_size = size.tiny)

// =============================================================================
// DASHBOARD
// =============================================================================
var table dash = table.new(position.top_right, 2, 34, bgcolor = color.new(color.black, 80), border_width = 1, border_color = color.new(color.white, 80))

if showDashboard and barstate.islast
    tfTxt = oneMinFireActive ? sessionName + " | " + timeframe.period + "→" + logicTF + " ⚡" : sessionName + " | " + logicTF + " logic"
    tfCol = (inLondon ? color.yellow : inLondonExt ? color.new(color.yellow, 40) : inNY ? color.orange : color.gray)
    profileTxt = profileDisplayTag + " ⚙ " + profileSourceTag
    titleCell = "◆ Wise Indicator\n" + profileTxt
    titleBg = useXauPreset ? color.new(#ffc107, 50) : useEurPreset ? color.new(#2980b9, 20) : color.new(#9c27b0, 50)
    table.cell(dash, 0, 0, titleCell, bgcolor = titleBg, text_color = color.white, text_size = size.normal)
    table.cell(dash, 1, 0, tfTxt, bgcolor = color.new(#2980b9, 20), text_color = tfCol, text_size = size.normal)

    biasDispColor = manualLongsOnly ? bullColor : manualShortsOnly ? bearColor : manualNeutral ? color.gray : color.yellow
    biasDispText = manualLongsOnly ? "▲ BULLISH" : manualShortsOnly ? "▼ BEARISH" : manualNeutral ? "— NEUTRAL" : "AUTO"
    table.cell(dash, 0, 1, "Your Bias", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 1, biasDispText, text_color = biasDispColor, text_size = size.tiny)

    modeShort = modeFirstOnly ? "1st only" : modeSecondOnly ? "2nd only" : "1st+2nd"
    table.cell(dash, 0, 2, "Entry Mode", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 2, modeShort, text_color = color.aqua, text_size = size.tiny)

    table.cell(dash, 0, 3, "30m", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 3, biasLabel(score30m) + " (" + str.tostring(math.round(score30m)) + ")", text_color = biasColor(score30m), text_size = size.tiny)

    table.cell(dash, 0, 4, "4H", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 4, biasLabel(score4h) + " (" + str.tostring(math.round(score4h)) + ")", text_color = biasColor(score4h), text_size = size.tiny)

    htfTxt = htfAlignMode == "Off (no filter)" ? "OFF" : htfAllowsLong and htfAllowsShort ? "BOTH" : htfAllowsLong ? "▲ LONG" : htfAllowsShort ? "▼ SHORT" : "✗ NONE"
    htfCol = htfAlignMode == "Off (no filter)" ? color.gray : htfAllowsLong and htfAllowsShort ? color.yellow : htfAllowsLong ? bullColor : htfAllowsShort ? bearColor : color.red
    table.cell(dash, 0, 5, "HTF Allows", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 5, htfTxt, text_color = htfCol, text_size = size.tiny)

    table.cell(dash, 0, 6, "— Range/Sweep —", bgcolor = color.new(color.gray, 70), text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 6, "", bgcolor = color.new(color.gray, 70))

    rngTxt = str.tostring(math.round(asiaRangeSize / syminfo.mintick)) + " tk " + (asiaTicksBlock ? "✗ BLOCKED" : asiaHuge ? "⚠⚠ HUGE" : asiaTooWide ? "⚠ WIDE" : "✓ OK")
    rngCol = asiaTicksBlock ? color.red : asiaHuge ? color.red : asiaTooWide ? color.orange : bullColor
    table.cell(dash, 0, 7, "Asia Range", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 7, rngTxt, text_color = rngCol, text_size = size.tiny)

    longSwpTxt = sweptLong ? "✓ " + sweptLongSrc : "✗"
    longSwpCol = sweptLong ? bullColor : color.gray
    table.cell(dash, 0, 8, "Long Sweep", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 8, longSwpTxt, text_color = longSwpCol, text_size = size.tiny)

    shortSwpTxt = sweptShort ? "✓ " + sweptShortSrc : "✗"
    shortSwpCol = sweptShort ? bearColor : color.gray
    table.cell(dash, 0, 9, "Short Sweep", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 9, shortSwpTxt, text_color = shortSwpCol, text_size = size.tiny)

    table.cell(dash, 0, 10, "PD Touch B/S", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 10, (bullPdTouched ? "✓" : "✗") + " / " + (bearPdTouched ? "✓" : "✗"), text_color = color.white, text_size = size.tiny)

    bodyColor = bullBodyPct >= minBodyRatio or bearBodyPct >= minBodyRatio ? color.lime : color.gray
    curBodyPct = math.max(bullBodyPct, bearBodyPct)
    table.cell(dash, 0, 11, "Candle Body %", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 11, str.tostring(math.round(curBodyPct * 100)) + "% (need " + str.tostring(math.round(minBodyRatio * 100)) + "%)", text_color = bodyColor, text_size = size.tiny)

    lvColor = lowVolPass ? bullColor : color.red
    lvText = lowVolPass ? "✓ OK" : (not candleRangeOK ? "✗ tiny candle" : not avgBodyOK ? "✗ consolidation" : "✗ low vol")
    table.cell(dash, 0, 12, "Volume/Size", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 12, lvText, text_color = lvColor, text_size = size.tiny)

    // v9.2: Volume confirmation status
    vcColor = volConfirmPass ? bullColor : color.red
    vcText = enableVolConfirm ? (volConfirmPass ? "✓ " + str.tostring(volMult, "#.##") + "× (need " + str.tostring(volConfirmMult, "#.#") + "×)" : "✗ " + str.tostring(volMult, "#.##") + "× (need " + str.tostring(volConfirmMult, "#.#") + "×)") : "OFF"
    table.cell(dash, 0, 13, "Vol Confirm", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 13, vcText, text_color = vcColor, text_size = size.tiny)

    // v9.3: Sweep Memory row in dashboard
    sweepMemDashTxt = t1LongOppositeBlock ? "✗ AH swept (blocks T1 L)" : t1ShortOppositeBlock ? "✗ AL swept (blocks T1 S)" : "✓ OK"
    sweepMemDashCol = t1LongOppositeBlock or t1ShortOppositeBlock ? color.red : bullColor
    table.cell(dash, 0, 14, "Sweep Memory", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 14, sweepMemDashTxt, text_color = sweepMemDashCol, text_size = size.tiny)

    manipL = longEngulfState == 1 ? "watching" : longEngulfState == 2 ? "ARMED 2nd" : longEngulfState == 3 ? "done" : "—"
    manipS = shortEngulfState == 1 ? "watching" : shortEngulfState == 2 ? "ARMED 2nd" : shortEngulfState == 3 ? "done" : "—"
    manipColor = longEngulfState == 2 or shortEngulfState == 2 ? color.new(#ff9800, 0) : color.gray
    table.cell(dash, 0, 15, "Manip L/S", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 15, manipL + " / " + manipS, text_color = manipColor, text_size = size.tiny)


    table.cell(dash, 0, 16, "— FVGs/OBs —", bgcolor = color.new(color.gray, 70), text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 16, "", bgcolor = color.new(color.gray, 70))

    table.cell(dash, 0, 17, "5m FVG ↑/↓", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 17, str.tostring(array.size(bullFvgB)) + " / " + str.tostring(array.size(bearFvgB)), text_color = color.new(#26a69a, 0), text_size = size.tiny)

    table.cell(dash, 0, 18, "15m FVG ↑/↓", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 18, str.tostring(array.size(fvg15BullBoxes)) + " / " + str.tostring(array.size(fvg15BearBoxes)), text_color = color.new(#3498db, 0), text_size = size.tiny)

    table.cell(dash, 0, 19, "30m FVG ↑/↓", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 19, str.tostring(array.size(fvg30BullBoxes)) + " / " + str.tostring(array.size(fvg30BearBoxes)), text_color = color.new(#9b59b6, 0), text_size = size.tiny)

    table.cell(dash, 0, 20, "OBs ↑/↓", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 20, str.tostring(array.size(bullObB)) + " / " + str.tostring(array.size(bearObB)), text_color = color.aqua, text_size = size.tiny)

    table.cell(dash, 0, 21, "— Trade Plan —", bgcolor = color.new(color.gray, 70), text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 21, "", bgcolor = color.new(color.gray, 70))

    longPlanTxt = longBase and longRROK ? "SL:" + str.tostring(longCandidateSL, format.mintick) + " TP:" + str.tostring(longCandidateTP, format.mintick) + " @" + longTpSrc + " " + str.tostring(longActualRR, "#.##") + "R" : longBase ? "RR too low (" + str.tostring(longActualRR, "#.##") + "R)" : "—"
    longPlanCol = longBase and longRROK ? bullColor : color.gray
    table.cell(dash, 0, 22, "Long Plan", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 22, longPlanTxt, text_color = longPlanCol, text_size = size.tiny)

    shortPlanTxt = shortBase and shortRROK ? "SL:" + str.tostring(shortCandidateSL, format.mintick) + " TP:" + str.tostring(shortCandidateTP, format.mintick) + " @" + shortTpSrc + " " + str.tostring(shortActualRR, "#.##") + "R" : shortBase ? "RR too low (" + str.tostring(shortActualRR, "#.##") + "R)" : "—"
    shortPlanCol = shortBase and shortRROK ? bearColor : color.gray
    table.cell(dash, 0, 23, "Short Plan", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 23, shortPlanTxt, text_color = shortPlanCol, text_size = size.tiny)

    signalTxt = (fireLong2nd or (fireLong1m and longEngulfState == 3)) ? "▲ LONG 2nd FIRED" : (fireLong1st or fireLong1m) ? "▲ LONG 1st FIRED" : (fireShort2nd or (fireShort1m and shortEngulfState == 3)) ? "▼ SHORT 2nd FIRED" : (fireShort1st or fireShort1m) ? "▼ SHORT 1st FIRED" : longTakenThisSession ? "✓ Long taken" : shortTakenThisSession ? "✓ Short taken" : "—"
    signalCol = fireLongAny ? bullColor : fireShortAny ? bearColor : color.gray
    table.cell(dash, 0, 24, "T1 Status", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 24, signalTxt, text_color = signalCol, text_size = size.tiny)

    t2SignalTxt = fireT2LongAny ? "▲ T2 LONG FIRED" : fireT2ShortAny ? "▼ T2 SHORT FIRED" : t2LongTaken ? "✓ T2 Long taken" : t2ShortTaken ? "✓ T2 Short taken" : "—"
    t2SignalCol = fireT2LongAny ? color.new(#00bcd4, 0) : fireT2ShortAny ? color.new(#e91e63, 0) : color.gray
    table.cell(dash, 0, 25, "T2 Status", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 25, t2SignalTxt, text_color = t2SignalCol, text_size = size.tiny)

    table.cell(dash, 0, 26, "T1 Taken L/S", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 26, (longTakenThisSession ? "✓" : "—") + " / " + (shortTakenThisSession ? "✓" : "—"), text_color = color.yellow, text_size = size.tiny)

    table.cell(dash, 0, 27, "T2 Taken L/S", text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 27, (t2LongTaken ? "✓" : "—") + " / " + (t2ShortTaken ? "✓" : "—"), text_color = color.new(#00bcd4, 0), text_size = size.tiny)

    // v9.19: A+ Quality Gate row
    // v9.8: NY engine rows (collapse outside NY/post-NY)
    showNyRows = enableNyEngine and (inNY or nyLongTaken or nyShortTaken or nyT2LongTaken or nyT2ShortTaken or not na(nySweepLongLevel) or not na(nySweepShortLevel))
    if showNyRows
        table.cell(dash, 0, 29, "— NY Engine —", bgcolor = color.new(#ff6f00, 60), text_color = color.white, text_size = size.tiny)
        table.cell(dash, 1, 29, "", bgcolor = color.new(#ff6f00, 60))

        nyBlockTxt = nyTicksBlock ? "✗ BLOCKED (London > " + str.tostring(maxNyTicks) + " tk)" : nySessionLimitHit ? "LIMIT (" + str.tostring(nySignalsThisSession) + "/" + str.tostring(nyMaxSignals) + ")" : "OK"
        nyBlockCol = nyTicksBlock or nySessionLimitHit ? color.red : bullColor
        table.cell(dash, 0, 30, "NY Status", text_color = color.white, text_size = size.tiny)
        table.cell(dash, 1, 30, nyBlockTxt, text_color = nyBlockCol, text_size = size.tiny)

        // v9.11: show which sweeps are available (including pre-NY)
        nySweepShortTxt = nySweepShort ? "✓ " + nySweepShortSrc : asiaHighSweptToday ? "AH" : londonHighSweptToday ? "LH" : "—"
        nySweepLongTxt = nySweepLong ? "✓ " + nySweepLongSrc : asiaLowSweptToday ? "AL" : londonLowSweptToday ? "LL" : "—"
        nySweepTxt = "S:" + nySweepShortTxt + " | L:" + nySweepLongTxt
        nySweepCol = nySweepLong or nySweepShort ? color.yellow : color.gray
        table.cell(dash, 0, 31, "NY Sweep", text_color = color.white, text_size = size.tiny)
        table.cell(dash, 1, 31, nySweepTxt, text_color = nySweepCol, text_size = size.tiny)

        nyManipL = nyLongEngulfState == 1 ? "L:watching" : nyLongEngulfState == 2 ? "L:✓ armed" : ""
        nyManipS = nyShortEngulfState == 1 ? "S:watching" : nyShortEngulfState == 2 ? "S:✓ armed" : ""
        nyManipTxt = nyManipL != "" and nyManipS != "" ? nyManipL + " " + nyManipS : nyManipL != "" ? nyManipL : nyManipS != "" ? nyManipS : ""
        nyT1Txt = (fireNyLong or fireNyLong1m) ? "▲ NY T1 LONG FIRED" + (nyLongFiredAs2nd ? " (2nd)" : "") : (fireNyShort or fireNyShort1m) ? "▼ NY T1 SHORT FIRED" + (nyShortFiredAs2nd ? " (2nd)" : "") : nyManipTxt != "" ? nyManipTxt : nyLongTaken ? "✓ Long taken" : nyShortTaken ? "✓ Short taken" : "—"
        nyT1Col = (fireNyLong or fireNyLong1m) ? bullColor : (fireNyShort or fireNyShort1m) ? bearColor : (nyLongTaken or nyShortTaken) ? color.yellow : color.gray
        table.cell(dash, 0, 32, "NY T1 Status", text_color = color.white, text_size = size.tiny)
        table.cell(dash, 1, 32, nyT1Txt, text_color = nyT1Col, text_size = size.tiny)

        nyT2Txt = (fireNyT2Long or fireNyT2Long1m) ? "▲ NY T2 LONG FIRED" : (fireNyT2Short or fireNyT2Short1m) ? "▼ NY T2 SHORT FIRED" : nyT2LongTaken ? "✓ T2 Long taken" : nyT2ShortTaken ? "✓ T2 Short taken" : "—"
        nyT2Col = (fireNyT2Long or fireNyT2Long1m) ? color.new(#00bcd4, 0) : (fireNyT2Short or fireNyT2Short1m) ? color.new(#e91e63, 0) : (nyT2LongTaken or nyT2ShortTaken) ? color.yellow : color.gray
        table.cell(dash, 0, 33, "NY T2 Status", text_color = color.white, text_size = size.tiny)
        table.cell(dash, 1, 33, nyT2Txt, text_color = nyT2Col, text_size = size.tiny)

// =============================================================================
// PHONE ALERTS — RICH alert() CALLS (v9.12)
// =============================================================================
// Each fire builds a phone-readable message with full trade plan and emits an
// alert() call. Two separate alert categories (5m vs 1m) so users can route
// them to different TradingView alerts if desired.
// =============================================================================

// v9.15: Build JSON alert message for webhook receiver (FastAPI / webhook_handler.py)
// Returns a JSON string with all fields the webhook expects.
// Schema (must match webhook_handler.py expected_fields):
//   secret, symbol, side, trade, session, profile,
//   entry, sl, sl_source, tp, tp_source, rr,
//   swept, after_manipulation, asia_wide, tf
buildJsonAlert(string side, string trade, string sessionName, string tfTag, float entry, float sl, string slSrc, float tp, string tpSrc, float rr, string sweepSrc, bool wasManip, bool asiaWide) =>
    // Sanitize swept string — extract only the 2-char code if present (e.g. "AL Swept" → "AL")
    sweptClean = ""
    if str.contains(sweepSrc, "AH")
        sweptClean := "AH"
    else if str.contains(sweepSrc, "AL")
        sweptClean := "AL"
    else if str.contains(sweepSrc, "LH")
        sweptClean := "LH"
    else if str.contains(sweepSrc, "LL")
        sweptClean := "LL"
    // tf field: combine chart timeframe + tfTag (e.g. "5m" or "1m-V1")
    tfField = timeframe.period + (tfTag != "" ? " " + str.replace_all(str.replace_all(tfTag, "{", ""), "}", "") : "")

    // v9.17: Calculate deep signal data
    // Engulfing body % — use direction-appropriate body percentage
    engulfBodyPct = side == "LONG" ? bullBodyPct : bearBodyPct
    // Volume spike — already calculated as effVolMult (current vol / 20-bar avg)
    volSpike = effVolMult
    // HTF alignment — does the higher TF bias allow this signal direction?
    htfAligned = side == "LONG" ? htfAllowsLong : htfAllowsShort
    // Displacement in × ATR — for T2 trades, calculate from sweep level
    // For T1 we set it to engulf candle range / atr (approximation of momentum)
    float displacementAtr = 0.0
    if str.contains(trade, "T2") and atr14 > 0
        if side == "LONG" and not na(sweptLongLevel) and not na(t2LongMaxDown)
            displacementAtr := (t2LongMaxDown - sweptLongLevel) / atr14
        else if side == "SHORT" and not na(sweptShortLevel) and not na(t2ShortMaxUp)
            displacementAtr := (sweptShortLevel - t2ShortMaxUp) / atr14
    else if atr14 > 0
        // T1: use engulf candle range as proxy for displacement strength
        displacementAtr := (high - low) / atr14

    // Build JSON manually (Pine has no JSON encoder; we build with str concatenation)
    json = "{"
    json += "\"secret\":\"" + webhookSecret + "\","
    json += "\"symbol\":\"" + syminfo.ticker + "\","
    json += "\"side\":\"" + side + "\","
    json += "\"trade\":\"" + trade + "\","
    json += "\"session\":\"" + sessionName + "\","
    json += "\"profile\":\"" + profileDisplayTag + "\","
    json += "\"entry\":" + str.tostring(entry, format.mintick) + ","
    json += "\"sl\":" + str.tostring(sl, format.mintick) + ","
    json += "\"sl_source\":\"" + slSrc + "\","
    json += "\"tp\":" + str.tostring(tp, format.mintick) + ","
    json += "\"tp_source\":\"" + tpSrc + "\","
    json += "\"rr\":" + str.tostring(rr, "#.##") + ","
    json += "\"swept\":\"" + sweptClean + "\","
    json += "\"after_manipulation\":" + (wasManip ? "true" : "false") + ","
    json += "\"asia_wide\":" + (asiaWide ? "true" : "false") + ","
    json += "\"tf\":\"" + tfField + "\","
    json += "\"tf_type\":\"" + (str.contains(tfField, "1m") ? "1m" : "5m") + "\","
    // v9.17: NEW deep signal data fields
    json += "\"displacement_atr\":" + str.tostring(displacementAtr, "#.##") + ","
    json += "\"engulf_body_pct\":" + str.tostring(engulfBodyPct, "#.##") + ","
    json += "\"vol_spike\":" + str.tostring(volSpike, "#.##") + ","
    json += "\"htf_aligned\":" + (htfAligned ? "true" : "false") + ","
    // v9.19: NEW quality score fields
    json += "\"quality_score\":" + str.tostring(lastQualityScore) + ","
    json += "\"quality_grade\":\"" + lastQualityGrade + "\","
    json += "\"conflict_resolved\":" + (lastConflictResolved ? "true" : "false") + ","
    json += "\"version\":\"9.22\""
    json += "}"
    json

// Detect if any 5m fire happened on this bar (London or NY, T1 or T2, NOT 1m precision)
fire5m_T1Long  = fireLong  and not fireLong1m
fire5m_T1Short = fireShort and not fireShort1m
fire5m_T2Long  = fireT2Long  and not fireT2Long1m
fire5m_T2Short = fireT2Short and not fireT2Short1m
fire5m_NyT1Long  = fireNyLong  and not fireNyLong1m
fire5m_NyT1Short = fireNyShort and not fireNyShort1m
fire5m_NyT2Long  = fireNyT2Long  and not fireNyT2Long1m
fire5m_NyT2Short = fireNyT2Short and not fireNyT2Short1m

any5mFire = fire5m_T1Long or fire5m_T1Short or fire5m_T2Long or fire5m_T2Short or fire5m_NyT1Long or fire5m_NyT1Short or fire5m_NyT2Long or fire5m_NyT2Short

// 1m precision fires
any1mFire = fireLong1m or fireShort1m or fireT2Long1m or fireT2Short1m or fireNyLong1m or fireNyShort1m or fireNyT2Long1m or fireNyT2Short1m

// Build and send 5m alerts
if enablePhoneAlerts and alertOn5m and any5mFire
    string alertJson = ""
    string trade = ""
    if fire5m_T1Long
        trade := fireLong2nd ? "T1 LONG (2nd)" : "T1 LONG (1st)"
        alertJson := buildJsonAlert("LONG", trade, "London", "", close, finalLongSL, finalLongSlSrc, longCandidateTP, longTpSrc, longActualRR, sweptLongSrc, fireLong2nd, asiaTooWide)
    if fire5m_T1Short
        trade := fireShort2nd ? "T1 SHORT (2nd)" : "T1 SHORT (1st)"
        alertJson := buildJsonAlert("SHORT", trade, "London", "", close, finalShortSL, finalShortSlSrc, shortCandidateTP, shortTpSrc, shortActualRR, sweptShortSrc, fireShort2nd, asiaTooWide)
    if fire5m_T2Long
        alertJson := buildJsonAlert("LONG", "T2 LONG (AMD)", "London", "", close, finalT2LongSL, finalT2LongSlSrc, t2LongTP, t2LongTpSrc, t2LongRR, "AH", false, asiaTooWide)
    if fire5m_T2Short
        alertJson := buildJsonAlert("SHORT", "T2 SHORT (AMD)", "London", "", close, finalT2ShortSL, finalT2ShortSlSrc, t2ShortTP, t2ShortTpSrc, t2ShortRR, "AL", false, asiaTooWide)
    if fire5m_NyT1Long
        trade := nyLongFiredAs2nd ? "T1 LONG (2nd)" : "T1 LONG (1st)"
        alertJson := buildJsonAlert("LONG", trade, "NY", "", close, nyLongSL, nyLongSlSrc, nyLongTP, nyLongTpSrc, nyLongActualRR, nySweepLongSrc, nyLongFiredAs2nd, asiaTooWide)
    if fire5m_NyT1Short
        trade := nyShortFiredAs2nd ? "T1 SHORT (2nd)" : "T1 SHORT (1st)"
        alertJson := buildJsonAlert("SHORT", trade, "NY", "", close, nyShortSL, nyShortSlSrc, nyShortTP, nyShortTpSrc, nyShortActualRR, nySweepShortSrc, nyShortFiredAs2nd, asiaTooWide)
    if fire5m_NyT2Long
        refRng = nySweepShortSrc == "LH" ? "London" : "Asia"
        rrVal = nyLongRiskD > 0 and not na(nyLongTP) ? (nyLongTP - close) / nyLongRiskD : 0.0
        alertJson := buildJsonAlert("LONG", "T2 LONG (AMD)", "NY", "", close, nyLongSL, nyLongSlSrc, nyLongTP, nyLongTpSrc, rrVal, nySweepShortSrc, false, asiaTooWide)
    if fire5m_NyT2Short
        refRng = nySweepLongSrc == "LL" ? "London" : "Asia"
        rrVal = nyShortRiskD > 0 and not na(nyShortTP) ? (close - nyShortTP) / nyShortRiskD : 0.0
        alertJson := buildJsonAlert("SHORT", "T2 SHORT (AMD)", "NY", "", close, nyShortSL, nyShortSlSrc, nyShortTP, nyShortTpSrc, rrVal, nySweepLongSrc, false, asiaTooWide)
    // v9.23: ONE alert per session — gate by London/NY, only on actual FIRE (never ready-state)
    if enableJsonAlerts and alertJson != ""
        isNyFire5m = fire5m_NyT1Long or fire5m_NyT1Short or fire5m_NyT2Long or fire5m_NyT2Short
        sessionOk5m = isNyFire5m ? not nyAlertSent : not londonAlertSent
        if sessionOk5m
            alert(alertJson, alert.freq_once_per_bar)
            if isNyFire5m
                nyAlertSent := true
            else
                londonAlertSent := true

// Build and send 1m precision alerts
if enablePhoneAlerts and alertOn1m and any1mFire
    string alertJson1m = ""
    string trade = ""
    tfTagPhone = lastFireTfTag != "" ? " {" + lastFireTfTag + "}" : ""
    if fireLong1m
        trade := fireLong2nd ? "T1 LONG (2nd)" : "T1 LONG (1st)"
        alertJson1m := buildJsonAlert("LONG", trade, "London", tfTagPhone, close, finalLongSL, finalLongSlSrc, longCandidateTP, longTpSrc, longActualRR, sweptLongSrc, fireLong2nd, asiaTooWide)
    if fireShort1m
        trade := fireShort2nd ? "T1 SHORT (2nd)" : "T1 SHORT (1st)"
        alertJson1m := buildJsonAlert("SHORT", trade, "London", tfTagPhone, close, finalShortSL, finalShortSlSrc, shortCandidateTP, shortTpSrc, shortActualRR, sweptShortSrc, fireShort2nd, asiaTooWide)
    if fireT2Long1m
        alertJson1m := buildJsonAlert("LONG", "T2 LONG (AMD)", "London", tfTagPhone, close, finalT2LongSL, finalT2LongSlSrc, t2LongTP, t2LongTpSrc, t2LongRR, "AH", false, asiaTooWide)
    if fireT2Short1m
        alertJson1m := buildJsonAlert("SHORT", "T2 SHORT (AMD)", "London", tfTagPhone, close, finalT2ShortSL, finalT2ShortSlSrc, t2ShortTP, t2ShortTpSrc, t2ShortRR, "AL", false, asiaTooWide)
    if fireNyLong1m
        trade := nyLongFiredAs2nd ? "T1 LONG (2nd)" : "T1 LONG (1st)"
        alertJson1m := buildJsonAlert("LONG", trade, "NY", tfTagPhone, close, nyLongSL, nyLongSlSrc, nyLongTP, nyLongTpSrc, nyLongActualRR, nySweepLongSrc, nyLongFiredAs2nd, asiaTooWide)
    if fireNyShort1m
        trade := nyShortFiredAs2nd ? "T1 SHORT (2nd)" : "T1 SHORT (1st)"
        alertJson1m := buildJsonAlert("SHORT", trade, "NY", tfTagPhone, close, nyShortSL, nyShortSlSrc, nyShortTP, nyShortTpSrc, nyShortActualRR, nySweepShortSrc, nyShortFiredAs2nd, asiaTooWide)
    if fireNyT2Long1m
        refRng = nySweepShortSrc == "LH" ? "London" : "Asia"
        rrVal = nyLongRiskD > 0 and not na(nyLongTP) ? (nyLongTP - close) / nyLongRiskD : 0.0
        alertJson1m := buildJsonAlert("LONG", "T2 LONG (AMD)", "NY", tfTagPhone, close, nyLongSL, nyLongSlSrc, nyLongTP, nyLongTpSrc, rrVal, nySweepShortSrc, false, asiaTooWide)
    if fireNyT2Short1m
        refRng = nySweepLongSrc == "LL" ? "London" : "Asia"
        rrVal = nyShortRiskD > 0 and not na(nyShortTP) ? (close - nyShortTP) / nyShortRiskD : 0.0
        alertJson1m := buildJsonAlert("SHORT", "T2 SHORT (AMD)", "NY", tfTagPhone, close, nyShortSL, nyShortSlSrc, nyShortTP, nyShortTpSrc, rrVal, nySweepLongSrc, false, asiaTooWide)
    // v9.23: ONE alert per session — same gate as 5m, 1m and 5m share the same flag
    if enableJsonAlerts and alertJson1m != ""
        isNyFire1m = fireNyLong1m or fireNyShort1m or fireNyT2Long1m or fireNyT2Short1m
        sessionOk1m = isNyFire1m ? not nyAlertSent : not londonAlertSent
        if sessionOk1m
            alert(alertJson1m, alert.freq_once_per_bar)
            if isNyFire1m
                nyAlertSent := true
            else
                londonAlertSent := true

// =============================================================================
// MONTHLY STATS TABLE (v9.23) — Win/Loss/WR%/R per month from chart history
// =============================================================================
drawMonthlyStats(tbl) =>
    color hdrBg = color.new(#9c27b0, 30)
    table.cell(tbl, 0, 0, "◆ Period", bgcolor = hdrBg, text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1, 0, "W", bgcolor = hdrBg, text_color = #00e676, text_size = size.tiny)
    table.cell(tbl, 2, 0, "L", bgcolor = hdrBg, text_color = #ff1744, text_size = size.tiny)
    table.cell(tbl, 3, 0, "WR%", bgcolor = hdrBg, text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 4, 0, "R", bgcolor = hdrBg, text_color = color.white, text_size = size.tiny)
    int nRows = math.min(array.size(mStatKeys), 6)
    int row = 1
    // Monthly rows
    for i = 0 to nRows - 1
        int idx = array.size(mStatKeys) - 1 - i
        int mK = array.get(mStatKeys, idx)
        int mY = math.floor(mK / 100)
        int mM = mK % 100
        string mName = monthStr(mM) + " " + str.tostring(mY)
        int w = array.get(mStatWins, idx)
        int l = array.get(mStatLosses, idx)
        float r = array.get(mStatR, idx)
        int total = w + l
        float wr = total > 0 ? math.round(w * 100.0 / total) : 0.0
        color wrCol = wr >= 65 ? #00e676 : wr >= 50 ? color.yellow : #ff1744
        color rCol = r > 0 ? #00e676 : r == 0 ? color.gray : #ff1744
        table.cell(tbl, 0, row, mName, text_color = color.white, text_size = size.tiny)
        table.cell(tbl, 1, row, str.tostring(w), text_color = #00e676, text_size = size.tiny)
        table.cell(tbl, 2, row, str.tostring(l), text_color = #ff1744, text_size = size.tiny)
        table.cell(tbl, 3, row, str.tostring(wr, "#") + "%", text_color = wrCol, text_size = size.tiny)
        table.cell(tbl, 4, row, (r >= 0 ? "+" : "") + str.tostring(r, "#.#") + "R", text_color = rCol, text_size = size.tiny)
        row += 1
    // Yearly summary rows
    int nYears = math.min(array.size(yStatKeys), 3)
    if nYears > 0
        color yrBg = color.new(#1565c0, 30)
        for i = 0 to nYears - 1
            int yIdx = array.size(yStatKeys) - 1 - i
            int yK = array.get(yStatKeys, yIdx)
            int yw = array.get(yStatWins, yIdx)
            int yl = array.get(yStatLosses, yIdx)
            float yr = array.get(yStatR, yIdx)
            int yTotal = yw + yl
            float yWr = yTotal > 0 ? math.round(yw * 100.0 / yTotal) : 0.0
            color yWrCol = yWr >= 65 ? #00e676 : yWr >= 50 ? color.yellow : #ff1744
            color yRCol = yr > 0 ? #00e676 : yr == 0 ? color.gray : #ff1744
            table.cell(tbl, 0, row, "◆ " + str.tostring(yK), bgcolor = yrBg, text_color = color.white, text_size = size.tiny)
            table.cell(tbl, 1, row, str.tostring(yw), bgcolor = yrBg, text_color = #00e676, text_size = size.tiny)
            table.cell(tbl, 2, row, str.tostring(yl), bgcolor = yrBg, text_color = #ff1744, text_size = size.tiny)
            table.cell(tbl, 3, row, str.tostring(yWr, "#") + "%", bgcolor = yrBg, text_color = yWrCol, text_size = size.tiny)
            table.cell(tbl, 4, row, (yr >= 0 ? "+" : "") + str.tostring(yr, "#.#") + "R", bgcolor = yrBg, text_color = yRCol, text_size = size.tiny)
            row += 1

var table statsTable = table.new(position.bottom_right, 5, 12, bgcolor = color.new(color.black, 85), border_width = 1, border_color = color.new(color.white, 80))
if showDashboard and barstate.islast and (array.size(mStatKeys) > 0 or array.size(yStatKeys) > 0)
    drawMonthlyStats(statsTable)

// Chart sound on every fire (when at desk)
plotFireSound = (any5mFire or any1mFire) and playChartSound and enablePhoneAlerts
plot(plotFireSound ? 1 : na, "Fire Sound Trigger", color = color.new(color.yellow, 100), display = display.none)
alertcondition(plotFireSound, "WMFx Fire Sound", "Trade fired — chart sound")

// v9.23: Trade outcome alertconditions
alertcondition(outcomeHit and outcomeResult == "WIN", "Trade Result: WIN", "WMFx — TP Hit! Trade won")
alertcondition(outcomeHit and outcomeResult == "LOSS", "Trade Result: LOSS", "WMFx — SL Hit! Trade lost")
alertcondition(outcomeHit and outcomeResult == "BE", "Trade Result: BE", "WMFx — SL hit at breakeven (0R)")
alertcondition(outcomeHit, "Any Trade Result", "WMFx — Trade outcome determined")

// =============================================================================
// LEGACY ALERTS (alertcondition — for backward compat / power users)
// =============================================================================
alertcondition(fireLongAny  and not fireLong2nd,  "T1 LONG (1st)",  "WMFx KZ T1 LONG 1st entry")
alertcondition(fireLongAny  and fireLong2nd,      "T1 LONG (2nd)",  "WMFx KZ T1 LONG 2nd entry — manipulation confirmed")
alertcondition(fireShortAny and not fireShort2nd, "T1 SHORT (1st)", "WMFx KZ T1 SHORT 1st entry")
alertcondition(fireShortAny and fireShort2nd,     "T1 SHORT (2nd)", "WMFx KZ T1 SHORT 2nd entry — manipulation confirmed")
alertcondition(fireT2LongAny,  "T2 LONG (AMD)",  "WMFx KZ T2 LONG — AMD retracement confirmed at PD zone in Asia")
alertcondition(fireT2ShortAny, "T2 SHORT (AMD)", "WMFx KZ T2 SHORT — AMD retracement confirmed at PD zone in Asia")
alertcondition(fireLongAny or fireShortAny or fireT2LongAny or fireT2ShortAny, "ANY Signal", "WMFx KZ — any T1 or T2 signal fired")
alertcondition(sweptLong  and not sweptLong[1],  "Long Sweep",  "Long liquidity swept (Asia Low or selected source)")
alertcondition(sweptShort and not sweptShort[1], "Short Sweep", "Short liquidity swept (Asia High or selected source)")
alertcondition(t2LongState == 3 and t2LongState[1] != 3,   "T2 Long Ready",  "T2 LONG: in PD zone — waiting for strong engulfing")
alertcondition(t2ShortState == 3 and t2ShortState[1] != 3, "T2 Short Ready", "T2 SHORT: in PD zone — waiting for strong engulfing")
// v9.7: 1m precision fire alerts (fire only when chart is on 1m and 1m engulf triggers)
alertcondition(fireLong1m or fireShort1m or fireT2Long1m or fireT2Short1m, "1m Precision Fire", "WMFx KZ — 1m precision engulf fired inside active 5m setup")
alertcondition(fireT2Long1m or fireT2Short1m, "1m Precision T2 Fire", "WMFx KZ — 1m engulf fired a T2 AMD trade earlier than 5m would have")
// v9.8: NY engine alerts
alertcondition(fireNyLong  or fireNyLong1m,    "NY T1 LONG",  "WMFx KZ — NY T1 LONG: London/Asia low swept, retrace, engulf")
alertcondition(fireNyShort or fireNyShort1m,   "NY T1 SHORT", "WMFx KZ — NY T1 SHORT: London/Asia high swept, retrace, engulf")
alertcondition(fireNyT2Long  or fireNyT2Long1m,  "NY T2 LONG",  "WMFx KZ — NY T2 LONG: AMD retracement on London/Asia high sweep")
alertcondition(fireNyT2Short or fireNyT2Short1m, "NY T2 SHORT", "WMFx KZ — NY T2 SHORT: AMD retracement on London/Asia low sweep")
alertcondition(fireNyLong or fireNyShort or fireNyT2Long or fireNyT2Short or fireNyLong1m or fireNyShort1m or fireNyT2Long1m or fireNyT2Short1m, "ANY NY Signal", "WMFx KZ — any NY session signal fired (5m or 1m precision)")
alertcondition(fireNyLong1m or fireNyShort1m or fireNyT2Long1m or fireNyT2Short1m, "NY 1m Precision Fire", "WMFx KZ — NY signal fired on 1m precision engulf")